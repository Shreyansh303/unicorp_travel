<script>
  document.addEventListener('astro:page-load', () => {
    const play = document.querySelector<HTMLButtonElement>('[data-ease-play]');
    const demo = document.querySelector<HTMLElement>('[data-ease-demo]');
    if (play && demo && !play.dataset['bound']) {
      play.dataset['bound'] = 'true';
      play.addEventListener('click', () => {
        const on = demo.classList.toggle('is-playing');
        play.setAttribute('aria-pressed', String(on));
      });
    }

    const replay = document.querySelector<HTMLButtonElement>('[data-route-replay]');
    if (replay && !replay.dataset['bound']) {
      replay.dataset['bound'] = 'true';
      replay.addEventListener('click', () => {
        document.querySelectorAll<SVGElement>('.sg-route-demo .route-load').forEach((svg) => {
          svg.classList.remove('route-load');
          // Force a style recalculation so the animation restarts.
          void svg.getBoundingClientRect();
          svg.classList.add('route-load');
        });
      });
    }
  });
</script>
