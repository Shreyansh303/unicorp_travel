---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import TickList from '../../components/ui/TickList.astro';
import RouteLine from '../../components/motion/RouteLine.astro';
import Stagger from '../../components/motion/Stagger.astro';
import Reveal from '../../components/motion/Reveal.astro';
import Parallax from '../../components/motion/Parallax.astro';
import Accordion from '../../components/ui/Accordion.astro';
import EnquirySection from '../../components/forms/EnquirySection.astro';
import { getPackages, type PackageEntry } from '../../lib/content';
import { callHref, mobile, whatsappFor } from '../../lib/enquiry';
import { formatDate, formatINR, isoDate } from '../../lib/format';
import { packageTypeLabels, regionLabels, themeLabels } from '../../lib/packages';
import { routes } from '../../lib/routes';

export const getStaticPaths = (async () => {
  const packages = await getPackages('featured');
  return packages.map((pkg) => ({ params: { slug: pkg.id }, props: { pkg } }));
}) satisfies GetStaticPaths;

interface Props {
  pkg: PackageEntry;
}

const { pkg } = Astro.props;
const data = pkg.data;
const topic = `your ${data.title} package`;
const highlightTones = ['tone-red', 'tone-white', 'tone-ink', 'tone-white', 'tone-red', 'tone-ink'];
const first = data.destinations[0];
const last = data.destinations.at(-1);
const route = data.destinations.join(' · ');
const gallery = data.images.gallery[0];
const photos = data.images.gallery;
const validUntil = formatDate(data.priceValidUntil);

// One wave per day, so the line has a bend beside each stop.
const days = data.itinerary.length;
const segment = 1000 / days;
const itineraryPath = Array.from({ length: days }, (_, index) => {
  const y = segment * (index + 1);
  const bend = index % 2 === 0 ? 36 : 4;
  return `S${bend} ${(y - segment / 2).toFixed(0)} 20 ${y.toFixed(0)}`;
}).join(' ');

// Phones: the itinerary and the price list become accordion rows (the markup below stays for 768 px+).
const esc = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const dayRows = data.itinerary.map((stop) => ({
  title: `Day ${stop.day}: ${stop.title}`,
  body: `<p>${esc(stop.description)}</p>`,
}));
const listBody = (items: readonly string[]) =>
  `<ul class="inc-list">${items.map((item) => `<li>${esc(item)}</li>`).join('')}</ul>`;
const priceRows = [
  { title: 'Included', body: listBody(data.inclusions) },
  { title: 'Not included', body: listBody(data.exclusions) },
];
---

<PageLayout
  title={data.seo.title}
  description={data.seo.description}
  topic={topic}
  overlayHeader
  enquireBar
  image={data.images.hero}
  enquiry={{
    title: 'Like the look of',
    accent: 'this trip?',
    text: `Tell us your dates and who is travelling, and we will send a plan and a price for ${data.title}. Changes are welcome.`,
  }}
>
  <Section tone="paper" spacing="none" aria-labelledby="page-title">
    <div class="pk-grid">
      <div class="pk-copy">
        <Breadcrumbs
          class="pk-crumbs"
          items={[
            { label: 'Home', href: routes.home },
            { label: 'Holidays', href: routes.holidays },
            { label: data.title },
          ]}
        />
        <h1 id="page-title" class="t-display pk-title">
          {data.title}
        </h1>
        <p class="t-lede hero-enter">{data.summary}</p>
        <ul class="pk-chips hero-enter">
          <li class="pk-chip-red">
            {data.duration.days} days, {data.duration.nights} nights
          </li>
          <li class="pk-chip-ink">
            {packageTypeLabels[data.type]} · {regionLabels[data.region]}
          </li>
          {data.themes.map((theme) => (
            <li class="pk-chip-line">{themeLabels[theme]}</li>
          ))}
        </ul>
        <div class="pk-price hero-enter" style="--enter-index: 2">
          <p>
            from <strong>{formatINR(data.fromPrice)}</strong>
          </p>
          <p class="pk-basis">{data.priceBasis}</p>
          <p class="pk-valid">
            Indicative price, valid until{' '}
            <time datetime={isoDate(data.priceValidUntil)}>{validUntil}</time>
          </p>
        </div>
        <div class="pk-actions hero-enter" style="--enter-index: 3">
          {mobile && (
            <Button href={whatsappFor(topic)} size="lg" iconStart="whatsapp" external>
              Ask about this trip
            </Button>
          )}
          {callHref && (
            <Button href={callHref} variant="secondary" size="lg" iconStart="phone">
              Call us
            </Button>
          )}
        </div>
        <div class="pk-formlink">
          <Link href="#enquire" variant="standalone">
            Or send your dates with the form
          </Link>
        </div>
        <div class="pk-strip">
          <dl class="pk-stats">
            <div>
              <dt>Duration</dt>
              <dd>{data.duration.days} days</dd>
              <dd class="pk-sub">{data.duration.nights} nights</dd>
            </div>
            <div>
              <dt>From</dt>
              <dd>{formatINR(data.fromPrice)}</dd>
            </div>
            <div>
              <dt>Valid until</dt>
              <dd>
                <time datetime={isoDate(data.priceValidUntil)}>{validUntil}</time>
              </dd>
            </div>
          </dl>
          <p class="pk-strip-basis">Indicative price, {data.priceBasis}</p>
        </div>
        <Button
          size="lg"
          class="pk-enquire"
          data-open-enquiry
          data-needs-js
          aria-controls="enquiry-fold"
        >
          Enquire about this trip
        </Button>
      </div>
      <figure class="arch pk-arch">
        <Picture
          src={data.images.hero.src}
          alt={data.images.hero.alt}
          formats={['avif', 'webp']}
          widths={[400, 640, 960, 1280]}
          sizes="(min-width: 1366px) 520px, (min-width: 1024px) 38vw, (min-width: 768px) calc(100vw - 2rem), 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </Section>

  <Section tone="sand" rounded aria-labelledby="highlights-title" class="sec-compact">
    <div data-reveal class="section-head">
      <h2 id="highlights-title" class="t-h2">
        The good <span class="t-accent">bits</span>
      </h2>
      <p>
        What this trip is built around, from {first}
        {last && last !== first ? ` to ${last}` : ''}.
      </p>
    </div>
    <Stagger as="ul" class="hl-grid">
      {data.highlights.map((item, index) => (
        <li class:list={['hl-card', highlightTones[index % highlightTones.length]]}>
          <span class="hl-num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <p class="hl-text">{item}</p>
        </li>
      ))}
    </Stagger>
  </Section>

  <Section tone="paper" aria-labelledby="itinerary-title" class="sec-compact">
    <div class="itin-grid">
      <div class="itin-head">
        <h2 id="itinerary-title" class="t-h2">
          Day by day
        </h2>
        <p class="t-muted">
          Follow the line through {route}.
        </p>
        {gallery && (
          <Parallax class="itin-photo">
            <Picture
              src={gallery.src}
              alt={gallery.alt}
              formats={['avif', 'webp']}
              widths={[400, 640, 960]}
              sizes="(min-width: 1366px) 480px, 36vw"
            />
          </Parallax>
        )}
      </div>
      <div class="itin">
        <RouteLine
          class="itin-line"
          d={`M20 0 ${itineraryPath}`}
          viewBox="0 0 40 1000"
          preserveAspectRatio="none"
          draw="scroll"
          strokeWidth={4}
        />
        <ol>
          {data.itinerary.map((stop) => (
            <Reveal as="li" class="day">
              <span class="day-num" aria-hidden="true">
                {stop.day}
              </span>
              <p class="t-eyebrow">Day {stop.day}</p>
              <h3 class="t-h3">{stop.title}</h3>
              <p class="day-text">{stop.description}</p>
            </Reveal>
          ))}
        </ol>
      </div>
      <div class="pk-phone">
        <Accordion id="day-acc" items={dayRows} open={[0]} phoneRows />
        <div class="pk-gallery" role="region" aria-label="Photos from this trip">
          <ul>
            {photos.map((photo) => (
              <li>
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={['avif', 'webp']}
                  widths={[400, 640, 960]}
                  sizes="calc(100vw - 2.5rem)"
                  loading="lazy"
                />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="white" aria-labelledby="included-title" class="sec-compact">
    <div data-reveal class="section-head">
      <h2 id="included-title" class="t-h2">
        What the price covers
      </h2>
      <p>
        The indicative price is {data.priceBasis}. We confirm everything in writing before you book.
      </p>
    </div>
    <div class="inc-grid">
      <div class="inc-col">
        <h3 class="t-h4">Included</h3>
        <TickList items={data.inclusions} />
      </div>
      <div class="inc-col">
        <h3 class="t-h4">Not included</h3>
        <TickList items={data.exclusions} mark="close" />
      </div>
    </div>
    <div class="pk-phone inc-acc">
      <Accordion id="price-acc" items={priceRows} phoneRows />
    </div>
    <p class="inc-more">
      <Link href={routes.holidays} variant="standalone">
        See all holidays
      </Link>
    </p>
  </Section>

  <EnquirySection
    title="Ask about"
    accent="this trip."
    intro={`Tell us your dates and who is travelling, and send it to us on WhatsApp or by email. Or ask for a call back about ${data.title}.`}
    topic={`the ${data.title} holiday`}
    formType="holiday"
    formTitle="Your trip details"
    prefill={{ holiday: data.title }}
    packageRef={pkg.id}
    foldLabel="Enquire about this trip"
    class="sec-compact"
    rounded
  />
</PageLayout>

<style>
  .pk-grid {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-16);
  }

  .pk-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: center;
    min-width: 0;
  }

  .pk-title {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 6rem);
  }

  .pk-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pk-chips li {
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .pk-chip-red {
    background: var(--red-600);
    color: var(--white);
  }

  .pk-chip-ink {
    background: var(--ink);
    color: var(--white);
  }

  .pk-chip-line {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .pk-price p:first-child {
    color: var(--text-muted);
  }

  .pk-price strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .pk-basis,
  .pk-valid {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .pk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .pk-arch {
    aspect-ratio: 4 / 5;
    width: min(100%, 27rem);
    justify-self: center;
  }

  .pk-arch :global(picture) {
    display: block;
    height: 100%;
  }

  @media (min-width: 1024px) {
    .pk-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-16);
      padding-block: var(--space-12) var(--space-24);
    }

    .pk-arch {
      width: 100%;
    }
  }

  /* Highlights */
  .hl-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .hl-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .hl-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hl-card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-height: 10rem;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
  }

  .hl-card.tone-white {
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  .hl-num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    line-height: 1;
    color: var(--accent-display);
  }

  .hl-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  /* Itinerary */
  .itin-grid {
    display: grid;
    gap: var(--space-10);
  }

  .itin-head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .itin-head :global(.itin-photo) {
    display: none;
  }

  @media (min-width: 1024px) {
    .itin-grid {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }

    .itin-head {
      position: sticky;
      top: var(--space-8);
      align-self: start;
    }

    .itin-head :global(.itin-photo) {
      display: block;
      aspect-ratio: 4 / 3;
      margin-top: var(--space-4);
    }
  }

  .itin {
    position: relative;
    padding-left: var(--space-16);
  }

  .itin :global(.itin-line) {
    position: absolute;
    top: 1.25rem;
    left: 0.25rem;
    width: 40px;
    height: calc(100% - 2.5rem);
  }

  .day {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-12);
  }

  .day:last-child {
    padding-bottom: 0;
  }

  .day-num {
    position: absolute;
    top: 0;
    left: calc(var(--space-16) * -1);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--red-600);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-black);
    box-shadow: 0 0 0 5px var(--paper);
  }

  .day-text {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  /* Inclusions */
  .inc-grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .inc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .inc-col {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .inc-more {
    margin-top: var(--space-10);
  }

  /* Desktop: the phone-only pieces stay out. */
  .pk-strip,
  .pk-copy :global(.pk-enquire),
  .pk-phone {
    display: none;
  }

  /* Phones: full-bleed photo, then a cream sheet with the title, the facts and one button. */
  @media (max-width: 767.98px) {
    .pk-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-block: 0;
      margin-inline: calc(-1 * var(--gutter));
    }

    .pk-arch {
      order: -1;
      width: 100%;
      height: 20rem;
      aspect-ratio: auto;
      border-radius: 0;
    }

    .pk-copy {
      position: relative;
      z-index: var(--z-raised);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      margin-top: -2rem;
      padding: 2rem 1.25rem;
      border-radius: 2rem 2rem 0 0;
      background: var(--paper);
    }

    .pk-title {
      order: 1;
      font-size: 2.5rem;
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .pk-strip {
      order: 2;
      display: grid;
      gap: var(--space-2);
    }

    .pk-copy :global(.pk-enquire) {
      order: 3;
      display: inline-flex;
      width: 100%;
      min-height: 3.5rem;
      font-size: 1.0625rem;
    }

    .pk-chips {
      order: 4;
    }

    .pk-copy > .t-lede {
      order: 5;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--stone-600);
    }

    .pk-copy > :global(.pk-crumbs) {
      order: 6;
    }

    .pk-chip-red,
    .pk-price,
    .pk-actions,
    .pk-formlink {
      display: none;
    }

    .pk-stats {
      display: grid;
      grid-template-columns: 0.8fr 1fr 1.2fr;
      margin: 0;
    }

    .pk-stats > div {
      display: grid;
      align-content: start;
      padding-inline: var(--space-3);
      border-left: 1px solid var(--sand-200);
    }

    .pk-stats > div:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .pk-stats dt {
      font-size: 0.8125rem;
      color: var(--text-muted);
    }

    .pk-stats dd {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: var(--weight-bold);
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .pk-stats dd.pk-sub {
      font-family: var(--font-text);
      font-size: 0.8125rem;
      font-weight: var(--weight-medium);
      letter-spacing: 0;
      color: var(--text-muted);
    }

    .pk-strip-basis {
      font-size: 0.8125rem;
      color: var(--text-muted);
    }

    .pk-phone {
      display: block;
    }

    /* Highlights: a compact numbered list. */
    .hl-grid {
      gap: 0;
      border-top: 1px solid var(--sand-200);
    }

    .hl-card,
    .hl-card.tone-white {
      grid-template-columns: 2.25rem 1fr;
      align-items: baseline;
      gap: var(--space-2);
      min-height: 0;
      padding: var(--space-4) 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: var(--ink);
      border-bottom: 1px solid var(--sand-200);
    }

    .hl-num {
      font-size: var(--text-lg);
      color: var(--red-700);
    }

    .hl-text {
      font-size: 1.1875rem;
    }

    /* Day by day */
    .itin-grid {
      gap: var(--space-4);
    }

    .itin {
      display: none;
    }

    .pk-gallery {
      margin-top: var(--space-6);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .pk-gallery::-webkit-scrollbar {
      display: none;
    }

    .pk-gallery ul {
      display: flex;
      gap: var(--space-3);
    }

    .pk-gallery li {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    .pk-gallery :global(img) {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: var(--radius-lg);
    }

    /* What the price covers */
    .inc-grid {
      display: none;
    }

    .inc-more {
      margin-top: var(--space-4);
    }

    .inc-acc :global(.inc-list) {
      display: grid;
      gap: var(--space-2);
      padding-left: var(--space-5);
      list-style: disc;
    }
  }

  /* Short phones (e.g. 375x667): a shorter photo keeps the button above the bottom bar. */
  @media (max-width: 767.98px) and (max-height: 700px) {
    .pk-arch {
      height: 13.5rem;
    }
  }
</style>
