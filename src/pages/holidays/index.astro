---
import { getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ladakh from '../../assets/photos/ladakh-1.jpg';
import kerala from '../../assets/photos/kerala-backwaters-1.jpg';
import switzerland from '../../assets/photos/switzerland-1.jpg';
import andaman from '../../assets/photos/andaman-1.jpg';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';
import PackageCard from '../../components/ui/PackageCard.astro';
import SampleLabel from '../../components/ui/SampleLabel.astro';
import HowItWorks from '../../components/ui/HowItWorks.astro';
import Stagger from '../../components/motion/Stagger.astro';
import HolidayFilters from '../../components/holidays/HolidayFilters.astro';
import EnquirySection from '../../components/forms/EnquirySection.astro';
import { getPackages } from '../../lib/content';
import { formatDate } from '../../lib/format';
import {
  budgetBandFor,
  durationBandFor,
  packageTypeLabels,
  regionLabels,
} from '../../lib/packages';
import { packageHref, routes } from '../../lib/routes';
import { greeting, whatsappFor } from '../../lib/enquiry';

const leisure = await getEntry('services', 'leisure');
if (!leisure) throw new Error('The leisure service entry is missing');
const packages = await getPackages('featured');
const hasSample = packages.some((item) => item.data.demo);
/** Photos for the hero crossfade; the first one is the LCP image. */
const heroPhotos = [
  { src: ladakh, alt: 'A turquoise lake ringed by bare mountains under a blue sky' },
  { src: kerala, alt: 'A traditional houseboat gliding along a palm-lined backwater in Kerala' },
  { src: switzerland, alt: 'A still alpine lake below snow-capped Swiss peaks' },
  { src: andaman, alt: 'Coconut palms leaning over a white sand beach and turquoise water' },
];
---

<PageLayout
  title={leisure.data.seo.title}
  description={leisure.data.seo.description}
  topic="a holiday"
  overlayHeader
  message={greeting('I would like help planning a holiday.')}
  enquiry={{
    title: 'Not quite',
    accent: 'it?',
    text: 'Every trip here can change: more days, another city, a different hotel. Or tell us your own idea and we will plan it from scratch.',
  }}
>
  <PageHero
    title="Holidays, planned"
    photos={heroPhotos}
    accent="around you."
    lede={leisure.data.intro}
    crumbs={[{ label: 'Home', href: routes.home }, { label: 'Holidays' }]}
    size="display"
    sheet
  >
    <div class="hero-actions">
      <Button href={routes.planMyTrip} size="lg" iconEnd="arrow-right">
        Plan my trip
      </Button>
      <Button
        href={whatsappFor('a holiday')}
        variant="secondary"
        size="lg"
        iconStart="whatsapp"
        external
      >
        Ask on WhatsApp
      </Button>
    </div>
  </PageHero>

  <Section tone="sand" rounded aria-labelledby="list-title" id="packages" class="sec-compact">
    <div data-reveal class="section-head">
      <h2 id="list-title" class="t-h2">
        Sample <span class="t-accent">holidays</span>
      </h2>
      <p>
        Trips in India and abroad to start from. Prices are indicative, per person, and valid until
        the date shown on each trip. {hasSample && <SampleLabel />}
      </p>
    </div>
    <HolidayFilters packages={packages} />
    <Stagger as="ul" class="list-grid">
      {packages.map((item) => (
        <li
          data-package={item.id}
          data-type={item.data.type}
          data-region={item.data.region}
          data-duration={durationBandFor(item.data.duration.days).id}
          data-budget={budgetBandFor(item.data.fromPrice).id}
          data-themes={item.data.themes.join(' ')}
        >
          <PackageCard
            name={item.data.title}
            region={`${packageTypeLabels[item.data.type]} · ${regionLabels[item.data.region]}`}
            days={item.data.duration.days}
            nights={item.data.duration.nights}
            fromPrice={item.data.fromPrice}
            priceBasis={item.data.priceBasis}
            validTo={formatDate(item.data.priceValidUntil)}
            image={item.data.images.hero.src}
            alt={item.data.images.hero.alt}
            href={packageHref(item)}
            demo={item.data.demo}
            headingLevel={3}
            sizes="(min-width: 1366px) 300px, (min-width: 1024px) 22vw, (min-width: 768px) 45vw, calc(100vw - 2rem)"
          />
        </li>
      ))}
    </Stagger>
    <button type="button" class="list-more" data-show-more hidden>
      Show more
    </button>
    <div class="list-empty" data-filter-empty hidden>
      <h3 class="t-h3">No holidays match all of those filters</h3>
      <p>Try fewer filters, or tell us what you have in mind and we will plan a trip around it.</p>
      <div class="list-empty-actions">
        <Button href={routes.planMyTrip} iconEnd="arrow-right">
          Plan my trip
        </Button>
        <button type="button" class="list-empty-clear" data-filters-clear>
          Clear filters
        </button>
      </div>
    </div>
  </Section>

  <Section tone="paper" aria-labelledby="how-title" class="sec-compact">
    <div data-reveal class="section-head">
      <h2 id="how-title" class="t-h2">
        How a holiday comes together
      </h2>
      <p>
        You do not need a full plan to start.{' '}
        <Link href={routes.faqs + '#faq-leisure'}>Read the holiday FAQs</Link>.
      </p>
    </div>
    <HowItWorks steps={leisure.data.howItWorks} list />
  </Section>

  <EnquirySection
    title="Rather talk it"
    accent="through?"
    intro="Leave your number and we will call you about your holiday. Or plan it step by step with the guided trip request."
    topic="a holiday"
    tone="sand"
    rounded
    foldLabel="Request a call back"
    class="sec-compact"
  />
</PageLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .list-grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .list-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12) var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .list-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .list-more {
    display: none;
  }

  /* Phones: a hero action fills the sheet (the WhatsApp link is in the bottom bar); the cards
     are a calm single column with a 16:10 photo; the cards after the sixth wait behind "Show more". */
  @media (max-width: 767.98px) {
    .hero-actions {
      display: grid;
    }

    .hero-actions > :global(a) {
      width: 100%;
      justify-content: center;
    }

    .hero-actions > :global(a:nth-child(2)) {
      display: none;
    }

    .list-grid {
      gap: var(--space-6);
    }

    /* The heading above the list carries the "Sample content" label for every card. */
    .list-grid :global(.sample-label) {
      display: none;
    }

    .list-grid > :global(li.is-folded) {
      display: none;
    }

    .list-grid :global(.pkg-photo) {
      aspect-ratio: 16 / 10;
      border-radius: 1.25rem;
    }

    .list-grid :global(.pkg-body) {
      gap: 0.25rem;
      padding-top: var(--space-3);
    }

    .list-grid :global(.pkg-name) {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .list-grid :global(.pkg-price) {
      font-size: 0.875rem;
    }

    .list-grid :global(.pkg-basis),
    .list-grid :global(.pkg-valid) {
      font-size: 0.8125rem;
      line-height: 1.4;
    }

    .list-grid :global(.pkg-price strong) {
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .list-more:not([hidden]) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 3.5rem;
      margin-top: var(--space-8);
      padding: var(--space-3) var(--space-6);
      border: 0;
      border-radius: var(--radius-pill);
      background: transparent;
      color: var(--ink);
      box-shadow: inset 0 0 0 2px var(--ink);
      font: inherit;
      font-size: 1.0625rem;
      font-weight: var(--weight-black);
      cursor: pointer;
    }

    .list-more:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }
  }

  .list-empty {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  .list-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .list-empty-clear {
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink);
    font: inherit;
    font-weight: var(--weight-black);
    cursor: pointer;
  }

  .list-empty-clear:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
</style>
