---
import { getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';
import PackageCard from '../../components/ui/PackageCard.astro';
import SampleLabel from '../../components/ui/SampleLabel.astro';
import HowItWorks from '../../components/ui/HowItWorks.astro';
import Stagger from '../../components/motion/Stagger.astro';
import HolidayFilters from '../../components/holidays/HolidayFilters.astro';
import EnquirySection from '../../components/forms/EnquirySection.astro';
import { getPackages } from '../../lib/content';
import { formatDate } from '../../lib/format';
import {
  budgetBandFor,
  durationBandFor,
  packageTypeLabels,
  regionLabels,
} from '../../lib/packages';
import { packageHref, routes } from '../../lib/routes';
import { greeting, whatsappFor } from '../../lib/enquiry';

const leisure = await getEntry('services', 'leisure');
if (!leisure) throw new Error('The leisure service entry is missing');
const packages = await getPackages('featured');
const hasSample = packages.some((item) => item.data.demo);
---

<PageLayout
  title={leisure.data.seo.title}
  description={leisure.data.seo.description}
  topic="a holiday"
  message={greeting('I would like help planning a holiday.')}
  enquiry={{
    title: 'Not quite',
    accent: 'it?',
    text: 'Every trip here can change: more days, another city, a different hotel. Or tell us your own idea and we will plan it from scratch.',
  }}
>
  <PageHero
    title="Holidays, planned"
    accent="around you."
    lede={leisure.data.intro}
    crumbs={[{ label: 'Home', href: routes.home }, { label: 'Holidays' }]}
    size="display"
  >
    <div class="hero-actions">
      <Button href={routes.planMyTrip} size="lg" iconEnd="arrow-right">
        Plan my trip
      </Button>
      <Button
        href={whatsappFor('a holiday')}
        variant="secondary"
        size="lg"
        iconStart="whatsapp"
        external
      >
        Ask on WhatsApp
      </Button>
    </div>
  </PageHero>

  <Section tone="sand" rounded aria-labelledby="list-title" id="packages">
    <div data-reveal class="section-head">
      <h2 id="list-title" class="t-h2">
        Sample <span class="t-accent">holidays</span>
      </h2>
      <p>
        Trips in India and abroad to start from. Prices are indicative, per person, and valid until
        the date shown on each trip. {hasSample && <SampleLabel />}
      </p>
    </div>
    <HolidayFilters packages={packages} />
    <Stagger as="ul" class="list-grid">
      {packages.map((item) => (
        <li
          data-package={item.id}
          data-type={item.data.type}
          data-region={item.data.region}
          data-duration={durationBandFor(item.data.duration.days).id}
          data-budget={budgetBandFor(item.data.fromPrice).id}
          data-themes={item.data.themes.join(' ')}
        >
          <PackageCard
            name={item.data.title}
            region={`${packageTypeLabels[item.data.type]} · ${regionLabels[item.data.region]}`}
            days={item.data.duration.days}
            nights={item.data.duration.nights}
            fromPrice={item.data.fromPrice}
            priceBasis={item.data.priceBasis}
            validTo={formatDate(item.data.priceValidUntil)}
            image={item.data.images.hero.src}
            alt={item.data.images.hero.alt}
            href={packageHref(item)}
            demo={item.data.demo}
            headingLevel={3}
            sizes="(min-width: 1366px) 300px, (min-width: 1024px) 22vw, (min-width: 768px) 45vw, calc(100vw - 2rem)"
          />
        </li>
      ))}
    </Stagger>
    <div class="list-empty" data-filter-empty hidden>
      <h3 class="t-h3">No holidays match all of those filters</h3>
      <p>Try fewer filters, or tell us what you have in mind and we will plan a trip around it.</p>
      <div class="list-empty-actions">
        <Button href={routes.planMyTrip} iconEnd="arrow-right">
          Plan my trip
        </Button>
        <button type="button" class="list-empty-clear" data-filters-clear>
          Clear filters
        </button>
      </div>
    </div>
  </Section>

  <Section tone="paper" aria-labelledby="how-title">
    <div data-reveal class="section-head">
      <h2 id="how-title" class="t-h2">
        How a holiday comes together
      </h2>
      <p>
        You do not need a full plan to start.{' '}
        <Link href={routes.faqs + '#faq-leisure'}>Read the holiday FAQs</Link>.
      </p>
    </div>
    <HowItWorks steps={leisure.data.howItWorks} />
  </Section>

  <EnquirySection
    title="Rather talk it"
    accent="through?"
    intro="Leave your number and we will call you about your holiday. Or plan it step by step with the guided trip request."
    topic="a holiday"
    tone="sand"
    rounded
  />
</PageLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .list-grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .list-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12) var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .list-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .list-empty {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  .list-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .list-empty-clear {
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink);
    font: inherit;
    font-weight: var(--weight-black);
    cursor: pointer;
  }

  .list-empty-clear:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
</style>
