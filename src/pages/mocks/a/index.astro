---
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MockBar from '../_shared/MockBar.astro';
import Masthead from '../_a/Masthead.astro';
import Enquiry from '../_a/Enquiry.astro';
import {
  brand,
  callHref,
  formatPrice,
  mobile,
  office,
  packages,
  serviceGroups,
  whatsappFor,
} from '../_shared/data';
import heroJourney from '../../../assets/photos/hero-journey.jpg';
import mapTexture from '../../../assets/photos/texture-map.jpg';
import '../_shared/route.css';
import '../_a/a.css';

const [lead, ...rest] = packages;
const others = rest.slice(0, 3);
---

<BaseLayout
  title={`Mock A, Atlas: ${brand}`}
  description="Design direction A for the Unicorp Travel demo: editorial serif type on paper and ink."
>
  <div class="atlas">
    <MockBar letter="a" name="Atlas" />
    <Masthead />
    <main>
      <section class="a-hero" aria-labelledby="hero-title">
        <div class="texture" aria-hidden="true">
          <Image src={mapTexture} alt="" widths={[800, 1600]} sizes="100vw" loading="eager" />
        </div>
        <div class="wrap a-hero-grid">
          <div class="a-hero-copy">
            <p class="eyebrow">
              Business travel and holidays{office ? `, ${office.locality}` : ''}
            </p>
            <h1 id="hero-title" class="display">
              Every journey, <em>drawn</em> with care.
            </h1>
            <p class="lede">
              {brand} plans business trips for companies and holidays for families. Tell us where
              you need to be and when; we work out the route, the bookings and the paperwork.
            </p>
            <div class="actions">
              <a class="btn" href={whatsappFor()}>
                Plan a trip on WhatsApp
              </a>
              {callHref && mobile && (
                <a class="link" href={callHref}>
                  Call {mobile.display}
                </a>
              )}
            </div>
          </div>
          <figure class="a-hero-figure route-photo">
            <Picture
              src={heroJourney}
              alt="A winding road snaking through green mountain valleys, seen from above"
              formats={['avif', 'webp']}
              widths={[480, 768, 1080, 1440, 1920]}
              sizes="(min-width: 1024px) 48vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
            <svg viewBox="0 0 2000 1629" fill="none" aria-hidden="true">
              <path
                class="route-draw route-halo"
                pathLength="1"
                stroke-width="18"
                stroke-linecap="round"
                d="M1062 1629 C1040 1530 990 1440 900 1340 C820 1250 700 1170 620 1110 C520 1035 420 980 410 905 C405 850 450 815 520 800 C620 780 760 760 860 705 C900 680 880 640 840 610 C810 585 840 565 900 545 C980 520 1060 515 1150 518"
              ></path>
              <path
                class="route-draw route-ink"
                pathLength="1"
                stroke-width="7"
                stroke-linecap="round"
                d="M1062 1629 C1040 1530 990 1440 900 1340 C820 1250 700 1170 620 1110 C520 1035 420 980 410 905 C405 850 450 815 520 800 C620 780 760 760 860 705 C900 680 880 640 840 610 C810 585 840 565 900 545 C980 520 1060 515 1150 518"
              ></path>
              <circle
                class="route-fade"
                cx="1150"
                cy="518"
                r="22"
                fill="#a8361b"
                stroke="#f4efe6"
                stroke-width="8"
              ></circle>
            </svg>
          </figure>
        </div>
      </section>

      <section class="section" aria-labelledby="services-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="services-title" class="display">
              Business trips and holidays, <em>one desk.</em>
            </h2>
            <p>
              The same team handles your company’s travel and your family’s holiday, so the details
              are looked after whichever trip you are on.
            </p>
          </div>
          <div class="a-services route-scroll">
            <svg
              class="a-services-rule"
              viewBox="0 0 1200 8"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <defs>
                <mask
                  id="a-rule-mask"
                  maskUnits="userSpaceOnUse"
                  x="0"
                  y="0"
                  width="1200"
                  height="8"
                >
                  <path
                    class="route-draw"
                    pathLength="1"
                    d="M0 4 H1200"
                    stroke="#fff"
                    stroke-width="8"
                  ></path>
                </mask>
              </defs>
              <path
                d="M0 4 H1200"
                stroke="#a8361b"
                stroke-width="2"
                stroke-dasharray="8 8"
                mask="url(#a-rule-mask)"
              ></path>
            </svg>
            <ol class="a-services-list">
              {serviceGroups.map((group, index) => (
                <li class="a-service">
                  <span class="a-service-num display">{String(index + 1).padStart(2, '0')}</span>
                  <h3 class="display">{group.name}</h3>
                  <p>{group.copy}</p>
                  <ul>
                    {group.items.map((item) => (
                      <li>{item.name}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <section class="section a-packages" aria-labelledby="packages-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="packages-title" class="display">
              Holidays, <em>day by day.</em>
            </h2>
            <p>
              A few routes we can plan for you. Each one is a starting point; we change the pace,
              hotels and length to suit you. <span class="sample">Sample content</span>
            </p>
          </div>
          <div class="a-pkg-grid">
            {lead && (
              <article class="a-pkg-lead">
                <Picture
                  src={lead.image}
                  alt={lead.alt}
                  formats={['avif', 'webp']}
                  widths={[480, 768, 1080, 1440]}
                  sizes="(min-width: 1024px) 55vw, 100vw"
                />
                <div class="a-pkg-body">
                  <p class="a-pkg-meta">
                    {lead.region} · {lead.days} days · {lead.theme}
                  </p>
                  <h3 class="display">
                    <a href="/mocks/a/package">{lead.name}</a>
                  </h3>
                  <p class="a-pkg-price">
                    From <strong>{formatPrice(lead.fromPrice)}</strong> per person, valid to{' '}
                    {lead.validTo}
                  </p>
                  <span class="sample">Sample content</span>
                </div>
              </article>
            )}
            <ul class="a-pkg-list">
              {others.map((item) => (
                <li class="a-pkg-row">
                  <Picture
                    src={item.image}
                    alt={item.alt}
                    formats={['avif', 'webp']}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 12rem, 38vw"
                  />
                  <div>
                    <p class="a-pkg-meta">
                      {item.region} · {item.days} days
                    </p>
                    <h3 class="display">{item.name}</h3>
                    <p class="a-pkg-price">
                      From <strong>{formatPrice(item.fromPrice)}</strong>
                    </p>
                    <span class="sample">Sample content</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </main>
    <Enquiry />
  </div>
</BaseLayout>

<style is:global>
  .atlas .a-hero {
    position: relative;
    isolation: isolate;
  }

  .atlas .a-hero .texture {
    z-index: -1;
  }

  .atlas .a-hero-grid {
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 4rem;
  }

  .atlas .a-hero-copy {
    display: grid;
    gap: 1.5rem;
    align-content: center;
  }

  .atlas .a-hero h1 {
    font-size: clamp(3rem, 1.6rem + 6vw, 6.75rem);
  }

  .atlas .a-hero-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2400 / 1955;
    object-fit: cover;
    border-radius: 2px;
  }

  @media (min-width: 1024px) {
    .atlas .a-hero-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-block: 4.5rem 6rem;
    }
  }

  /* Services */
  .atlas .a-services {
    position: relative;
  }

  .atlas .a-services-rule {
    display: none;
  }

  .atlas .a-services-list {
    display: grid;
    gap: 3rem;
  }

  .atlas .a-service {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-left: 1.5rem;
    border-left: 2px dashed rgb(168 54 27 / 0.45);
  }

  .atlas .a-service-num {
    font-style: italic;
    font-size: 1.25rem;
    color: var(--accent);
  }

  .atlas .a-service h3 {
    font-size: 2rem;
    line-height: 1.05;
  }

  .atlas .a-service > p {
    color: var(--ink-soft);
  }

  .atlas .a-service ul {
    margin-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }

  .atlas .a-service ul li {
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  @media (min-width: 1024px) {
    .atlas .a-services-rule {
      display: block;
      width: 100%;
      height: 8px;
      margin-bottom: 2rem;
    }

    .atlas .a-services-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }

    .atlas .a-service {
      padding-left: 0;
      border-left: 0;
    }

    .atlas .a-service::before {
      content: '';
      position: absolute;
      top: calc(-2rem - 10px);
      left: 0;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--paper);
      border: 2px solid var(--accent);
    }
  }

  /* Packages */
  .atlas .a-packages {
    background: var(--paper-deep);
  }

  .atlas .a-pkg-grid {
    display: grid;
    gap: 2.5rem;
  }

  .atlas .a-pkg-lead img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .atlas .a-pkg-body {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding-top: 1.25rem;
  }

  .atlas .a-pkg-lead h3 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .atlas .a-pkg-lead h3 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .atlas .a-pkg-meta {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .atlas .a-pkg-price {
    color: var(--ink-soft);
  }

  .atlas .a-pkg-price strong {
    color: var(--ink);
  }

  .atlas .a-pkg-list {
    display: grid;
    border-top: 1px solid var(--rule);
  }

  .atlas .a-pkg-row {
    display: grid;
    grid-template-columns: 38% 1fr;
    gap: 1rem;
    align-items: start;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .atlas .a-pkg-row > div {
    display: grid;
    gap: 0.25rem;
    justify-items: start;
  }

  .atlas .a-pkg-row img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .atlas .a-pkg-row h3 {
    font-size: 1.375rem;
    line-height: 1.1;
  }

  @media (min-width: 1024px) {
    .atlas .a-pkg-grid {
      grid-template-columns: 7fr 5fr;
      gap: 4rem;
    }

    .atlas .a-pkg-row {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }
  }
</style>
