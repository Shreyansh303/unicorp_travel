---
/** Closing enquiry band for the direction C mocks, on the red tone. Facts come from site.ts. */
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
import { callHref, email, mailHref, mobile, office, whatsappFor } from '../_shared/data';

interface Props {
  topic?: string;
}

const { topic } = Astro.props;
---

<Section tone="red" mood="holiday" aria-labelledby="enquiry-title" class="enquiry">
  <div class="enquiry-grid">
    <div class="enquiry-copy">
      <h2 id="enquiry-title" class="t-h2">
        Where to <span class="t-accent">next?</span>
      </h2>
      <p class="enquiry-lede">
        Tell us who is travelling, roughly when, and what you love doing. We will send back a
        day-by-day plan to talk through.
      </p>
      <div class="enquiry-actions">
        <Button href={whatsappFor(topic)} iconStart="whatsapp" size="lg" external>
          Chat on WhatsApp
        </Button>
        {callHref && mobile && (
          <Button href={callHref} variant="secondary" iconStart="phone" size="lg">
            Call {mobile.display}
          </Button>
        )}
      </div>
    </div>
    <dl class="enquiry-card">
      {email && mailHref && (
        <div>
          <dt>Email</dt>
          <dd>
            <a href={mailHref}>{email}</a>
          </dd>
        </div>
      )}
      {office && (
        <div>
          <dt>Visit us</dt>
          <dd>
            <address>
              {office.lines.map((line) => (
                <span>{line}</span>
              ))}
            </address>
          </dd>
        </div>
      )}
    </dl>
  </div>
</Section>

<style>
  .enquiry-grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 1024px) {
    .enquiry-grid {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }

  .enquiry-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .enquiry-lede {
    max-width: 30rem;
    font-size: var(--text-lg);
  }

  .enquiry-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .enquiry-card {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--red-700);
  }

  .enquiry-card dt {
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* At least 24px tall (WCAG 2.5.8). */
  .enquiry-card a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    color: var(--white);
    font-weight: var(--weight-bold);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .enquiry-card address span {
    display: block;
  }
</style>
