---
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MockBar from '../_shared/MockBar.astro';
import Enquiry from '../_c/Enquiry.astro';
import Header from '../../../components/ui/Header.astro';
import Footer from '../../../components/ui/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import SampleLabel from '../../../components/ui/SampleLabel.astro';
import FloatingContact from '../../../components/ui/FloatingContact.astro';
import RouteLine from '../../../components/motion/RouteLine.astro';
import Stagger from '../../../components/motion/Stagger.astro';
import Parallax from '../../../components/motion/Parallax.astro';
import { brand, featured, formatPrice, whatsappFor } from '../_shared/data';
import { mockFooterGroups, mockNav } from '../_shared/nav';

const pkg = featured;
const topic = `the ${pkg.name} holiday`;
const highlightTones = ['tone-red', 'tone-white', 'tone-ink', 'tone-white'];
const message = `Hello ${brand}, I would like to know more about ${topic}.`;
---

<BaseLayout
  title={`Mock C, Monsoon in red: ${pkg.name}, ${brand}`}
  description={`Design direction C for the ${brand} demo, recoloured: a sample holiday package page.`}
>
  <MockBar name="C, Monsoon in red, black and white" />
  <Header
    items={mockNav}
    homeHref="/mocks/c"
    currentPath="/mocks/c/package"
    whatsappMessage={message}
  />
  <main id="main">
    <Section tone="paper" spacing="none" aria-labelledby="pk-title">
      <div class="pk-grid">
        <div class="pk-copy">
          <Breadcrumbs
            items={[
              { label: 'Home', href: '/mocks/c' },
              { label: 'Holidays', href: '/mocks/c#packages' },
              { label: pkg.region },
            ]}
          />
          <SampleLabel />
          <h1 id="pk-title" class="t-display">
            Kerala, <span class="t-accent">slowly.</span>
          </h1>
          <p class="pk-sub">{pkg.name}</p>
          <p class="t-lede">{pkg.intro}</p>
          <ul class="pk-chips">
            <li class="pk-chip-red">
              {pkg.days} days, {pkg.nights} nights
            </li>
            <li class="pk-chip-ink">{pkg.route}</li>
            <li class="pk-chip-line">{pkg.theme} holiday</li>
          </ul>
          <div class="pk-price">
            <p>
              from <strong>{formatPrice(pkg.fromPrice)}</strong> per person
            </p>
            <p class="pk-valid">Valid to {pkg.validTo}</p>
          </div>
          <Button href={whatsappFor(topic)} size="lg" iconStart="whatsapp" external>
            Ask about this trip
          </Button>
        </div>
        <figure class="arch pk-arch">
          <Picture
            src={pkg.image}
            alt={pkg.alt}
            formats={['avif', 'webp']}
            widths={[400, 640, 960, 1280]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </Section>

    <Section tone="sand" rounded aria-labelledby="highlights-title">
      <div class="section-head">
        <h2 id="highlights-title" class="t-h2">
          The good <span class="t-accent">bits</span>
        </h2>
        <p>
          Four things this trip is built around. <SampleLabel />
        </p>
      </div>
      <Stagger as="ul" class="hl-grid">
        {pkg.highlights.map((item, index) => (
          <li class:list={['hl-card', highlightTones[index % highlightTones.length]]}>
            <h3 class="t-h4 hl-title">{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </Stagger>
    </Section>

    <Section tone="paper" aria-labelledby="itinerary-title">
      <div class="itin-grid">
        <div class="itin-head">
          <h2 id="itinerary-title" class="t-h2">
            Day by day
          </h2>
          <p class="t-muted">
            Follow the line from Kochi and back. <SampleLabel />
          </p>
          <Parallax class="itin-photo">
            <Picture
              src={pkg.secondImage}
              alt={pkg.secondAlt}
              formats={['avif', 'webp']}
              widths={[400, 640, 960]}
              sizes="(min-width: 1024px) 30vw, 100vw"
            />
          </Parallax>
        </div>
        <div class="itin">
          <RouteLine
            class="itin-line"
            d="M20 0 C36 60 4 110 20 166 S36 276 20 333 S4 443 20 500 S36 610 20 666 S4 776 20 833 S36 943 20 1000"
            viewBox="0 0 40 1000"
            preserveAspectRatio="none"
            draw="scroll"
            strokeWidth={4}
          />
          <ol>
            {pkg.itinerary.map((stop) => (
              <li class="day">
                <span class="day-num" aria-hidden="true">
                  {stop.day}
                </span>
                <p class="t-eyebrow">
                  Day {stop.day} · {stop.place}
                </p>
                <h3 class="t-h3">{stop.title}</h3>
                <p class="day-text">{stop.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Section>
  </main>
  <Enquiry topic={topic} />
  <Footer homeHref="/mocks/c" groups={mockFooterGroups} />
  <FloatingContact message={message} />
</BaseLayout>

<style>
  .pk-grid {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-16);
  }

  .pk-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: center;
  }

  .pk-sub {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .pk-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pk-chips li {
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .pk-chip-red {
    background: var(--red-600);
    color: var(--white);
  }

  .pk-chip-ink {
    background: var(--ink);
    color: var(--white);
  }

  .pk-chip-line {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .pk-price p:first-child {
    color: var(--text-muted);
  }

  .pk-price strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .pk-valid {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .pk-arch {
    aspect-ratio: 4 / 5;
  }

  .pk-arch :global(picture) {
    display: block;
    height: 100%;
  }

  @media (min-width: 1024px) {
    .pk-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-16);
      padding-block: var(--space-12) var(--space-24);
    }
  }

  /* Highlights */
  .hl-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .hl-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .hl-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hl-card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-height: 12rem;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
  }

  .hl-card.tone-white {
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  .hl-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    line-height: 1.05;
  }

  /* Itinerary */
  .itin-grid {
    display: grid;
    gap: var(--space-10);
  }

  .itin-head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .itin-head :global(.itin-photo) {
    display: none;
  }

  @media (min-width: 1024px) {
    .itin-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-20, 5rem);
    }

    .itin-head {
      position: sticky;
      top: var(--space-8);
      align-self: start;
    }

    .itin-head :global(.itin-photo) {
      display: block;
      aspect-ratio: 4 / 3;
      margin-top: var(--space-4);
    }
  }

  .itin {
    position: relative;
    padding-left: var(--space-16);
  }

  .itin :global(.itin-line) {
    position: absolute;
    top: 1.25rem;
    left: 0.25rem;
    width: 40px;
    height: calc(100% - 2.5rem);
  }

  .day {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-12);
  }

  .day:last-child {
    padding-bottom: 0;
  }

  .day-num {
    position: absolute;
    top: 0;
    left: calc(var(--space-16) * -1);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--red-600);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-black);
    box-shadow: 0 0 0 5px var(--paper);
  }

  .day-text {
    max-width: var(--measure);
    color: var(--text-muted);
  }
</style>
