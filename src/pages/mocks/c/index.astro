---
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MockBar from '../_shared/MockBar.astro';
import Nav from '../_c/Nav.astro';
import Enquiry from '../_c/Enquiry.astro';
import { brand, formatPrice, packages, serviceGroups, whatsappFor } from '../_shared/data';
import udaipur from '../../../assets/photos/rajasthan-1.jpg';
import '../_shared/route.css';
import '../_c/c.css';

const order = ['leisure', 'corporate', 'related'] as const;
const groups = order
  .map((id) => serviceGroups.find((group) => group.id === id))
  .filter((group) => group !== undefined);
const tone: Record<string, string> = {
  leisure: 'c-tone-marigold',
  corporate: 'c-tone-peacock',
  related: 'c-tone-rani',
};
const shown = packages.filter((item) =>
  ['kerala', 'andaman', 'bali', 'switzerland'].includes(item.slug),
);
const routePath =
  'M0 470 C80 560 200 560 250 500 C300 440 230 390 200 430 C170 470 260 540 360 500 C440 470 470 380 480 300 C488 230 470 160 440 110';
---

<BaseLayout
  title={`Mock C, Monsoon: ${brand}`}
  description="Design direction C for the Unicorp Travel demo: warm, vivid colour and expressive type."
>
  <div class="monsoon">
    <MockBar letter="c" name="Monsoon" />
    <Nav />
    <main>
      <section class="c-hero" aria-labelledby="hero-title">
        <div class="wrap c-hero-grid">
          <div class="c-hero-copy">
            <p class="tag">Holidays in India and abroad</p>
            <h1 id="hero-title" class="display">
              Pack light. <span class="c-hl">We’ll plan</span> the rest.
            </h1>
            <p class="lede">
              Backwaters, deserts, islands or the Alps: tell us who is travelling and what you love,
              and we plan the holiday day by day. Business travel too, handled just as carefully.
            </p>
            <div class="actions">
              <a class="btn" href={whatsappFor('a holiday')}>
                Plan my holiday
              </a>
              <a class="btn btn-line" href="/mocks/c/package">
                See a sample trip
              </a>
            </div>
          </div>
          <div class="c-hero-art">
            <figure class="arch c-hero-arch">
              <Picture
                src={udaipur}
                alt="The City Palace complex in Udaipur rising above the lake under a clear blue sky"
                formats={['avif', 'webp']}
                widths={[400, 640, 960, 1280]}
                sizes="(min-width: 1024px) 34vw, 82vw"
                loading="eager"
                fetchpriority="high"
              />
              <figcaption class="c-chip">Udaipur, Rajasthan</figcaption>
            </figure>
            <svg class="c-hero-route" viewBox="0 0 496 580" fill="none" aria-hidden="true">
              <path
                class="route-draw route-halo"
                pathLength="1"
                d={routePath}
                stroke-width="11"
                stroke-linecap="round"
              ></path>
              <path
                class="route-draw route-ink"
                pathLength="1"
                d={routePath}
                stroke-width="5"
                stroke-linecap="round"
              ></path>
              <circle
                class="route-fade"
                style="--fade-delay: 2.6s"
                cx="440"
                cy="110"
                r="11"
                fill="#f4a118"
                stroke="#fff4e2"
                stroke-width="4"
              ></circle>
            </svg>
          </div>
        </div>
      </section>

      <section class="section c-services" aria-labelledby="services-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="services-title" class="h2">
              Holidays first. Everything else, sorted.
            </h2>
            <p>
              We plan family holidays, honeymoons and group trips, and look after the visas, forex
              and bookings around them. Companies use the same team for business travel.
            </p>
          </div>
          <ul class="c-svc-grid">
            {groups.map((group) => (
              <li class:list={['c-svc', tone[group.id]]}>
                <h3 class="display">{group.name}</h3>
                <p>{group.copy}</p>
                <ul>
                  {group.items.map((item) => (
                    <li>{item.name}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section c-packages" aria-labelledby="packages-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="packages-title" class="h2">
              Trips to start dreaming about
            </h2>
            <p>
              Sample trips to show the idea. We change the pace, the hotels and the length to suit
              you. <span class="sample">Sample content</span>
            </p>
          </div>
          <div class="c-pkg-wrap route-scroll">
            <svg
              class="c-pkg-route"
              viewBox="0 0 1200 60"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path
                class="route-draw route-ink"
                pathLength="1"
                stroke-width="4"
                stroke-linecap="round"
                d="M0 30 C100 0 200 60 300 30 S500 0 600 30 S800 60 900 30 S1100 0 1200 30"
              ></path>
            </svg>
            <ul class="c-pkg-grid">
              {shown.map((item) => (
                <li class="c-pkg">
                  <div class="arch">
                    <Picture
                      src={item.image}
                      alt={item.alt}
                      formats={['avif', 'webp']}
                      widths={[400, 640, 800]}
                      sizes="(min-width: 1024px) 22vw, (min-width: 768px) 45vw, 100vw"
                    />
                  </div>
                  <div class="c-pkg-body">
                    <p class="c-pkg-meta">
                      {item.region} · {item.days} days
                    </p>
                    <h3 class="display">
                      {item.slug === 'kerala' ? (
                        <a href="/mocks/c/package">{item.name}</a>
                      ) : (
                        item.name
                      )}
                    </h3>
                    <p class="c-pkg-price">
                      from <strong>{formatPrice(item.fromPrice)}</strong>
                    </p>
                    <span class="sample">Sample content</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </main>
    <Enquiry topic="a holiday" />
  </div>
</BaseLayout>

<style is:global>
  .monsoon .c-hero-grid {
    display: grid;
    gap: 3rem;
    padding-block: 1.5rem 4rem;
  }

  .monsoon .c-hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    align-content: center;
  }

  .monsoon .c-hero h1 {
    font-size: clamp(3.25rem, 1.6rem + 7vw, 7.5rem);
  }

  .monsoon .c-hl {
    color: var(--rani);
  }

  .monsoon .c-hero-art {
    position: relative;
    width: 82%;
    margin-inline: auto;
    aspect-ratio: 400 / 500;
  }

  .monsoon .c-hero-arch {
    position: relative;
    height: 100%;
  }

  .monsoon .c-hero-arch picture,
  .monsoon .c-hero-arch img {
    height: 100%;
  }

  .monsoon .c-hero-route {
    position: absolute;
    top: -8%;
    left: -12%;
    width: 124%;
    height: 116%;
    pointer-events: none;
  }

  .monsoon .c-chip {
    position: absolute;
    left: -0.75rem;
    top: 44%;
    transform: rotate(-4deg);
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--sand);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .monsoon .c-hero-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 4rem;
      padding-block: 3rem 6rem;
    }

    .monsoon .c-hero-art {
      width: 78%;
    }
  }

  /* Services */
  .monsoon .c-services {
    background: var(--sand-2);
    border-radius: 2.5rem 2.5rem 0 0;
  }

  .monsoon .c-svc-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .monsoon .c-svc-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .monsoon .c-svc.c-tone-rani {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .monsoon .c-svc {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.75rem;
    border-radius: var(--radius);
  }

  .monsoon .c-svc h3 {
    font-size: 2.25rem;
  }

  .monsoon .c-svc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .monsoon .c-svc ul li {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .monsoon .c-tone-marigold {
    background: var(--marigold);
    color: var(--ink);
  }

  .monsoon .c-tone-marigold li {
    background: rgb(255 244 226 / 0.6);
  }

  .monsoon .c-tone-peacock {
    background: var(--peacock);
    color: var(--sand);
  }

  .monsoon .c-tone-peacock li {
    border: 1px solid rgb(255 244 226 / 0.4);
  }

  .monsoon .c-tone-rani {
    background: var(--rani);
    color: #fff;
  }

  .monsoon .c-tone-rani li {
    border: 1px solid rgb(255 255 255 / 0.45);
  }

  /* Packages */
  .monsoon .c-pkg-wrap {
    position: relative;
  }

  .monsoon .c-pkg-route {
    display: none;
  }

  .monsoon .c-pkg-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .monsoon .c-pkg-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .monsoon .c-pkg-route {
      display: block;
      position: absolute;
      top: 38%;
      left: 0;
      width: 100%;
      height: 60px;
      z-index: 0;
    }

    .monsoon .c-pkg-grid {
      position: relative;
      z-index: 1;
      grid-template-columns: repeat(4, 1fr);
    }

    .monsoon .c-pkg:nth-child(even) {
      transform: translateY(2.5rem);
    }
  }

  .monsoon .c-pkg .arch img {
    aspect-ratio: 4 / 5;
  }

  .monsoon .c-pkg-body {
    display: grid;
    gap: 0.375rem;
    justify-items: start;
    padding-top: 1rem;
  }

  .monsoon .c-pkg-meta {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rani);
  }

  .monsoon .c-pkg h3 {
    font-size: 1.75rem;
    line-height: 1;
  }

  .monsoon .c-pkg h3 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--marigold);
    text-decoration-thickness: 4px;
    text-underline-offset: 0.15em;
  }

  .monsoon .c-pkg-price {
    color: var(--ink-soft);
  }

  .monsoon .c-pkg-price strong {
    font-family: var(--display);
    font-size: 1.375rem;
    color: var(--ink);
  }
</style>
