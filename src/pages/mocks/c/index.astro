---
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MockBar from '../_shared/MockBar.astro';
import Enquiry from '../_c/Enquiry.astro';
import Header from '../../../components/ui/Header.astro';
import Footer from '../../../components/ui/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
import ServiceCard from '../../../components/ui/ServiceCard.astro';
import PackageCard from '../../../components/ui/PackageCard.astro';
import SampleLabel from '../../../components/ui/SampleLabel.astro';
import FloatingContact from '../../../components/ui/FloatingContact.astro';
import RouteLine from '../../../components/motion/RouteLine.astro';
import Stagger from '../../../components/motion/Stagger.astro';
import Reveal from '../../../components/motion/Reveal.astro';
import { brand, packages, serviceGroups, whatsappFor } from '../_shared/data';
import { mockFooterGroups, mockNav } from '../_shared/nav';
import udaipur from '../../../assets/photos/rajasthan-1.jpg';

const tones = { leisure: 'red', corporate: 'ink', related: 'white' } as const;
const order = ['leisure', 'corporate', 'related'] as const;
const groups = order
  .map((id) => serviceGroups.find((group) => group.id === id))
  .filter((group) => group !== undefined);
const featured = packages.filter((item) =>
  ['kerala', 'andaman', 'bali', 'switzerland'].includes(item.slug),
);
const heroRoute =
  'M0 470 C80 560 200 560 250 500 C300 440 230 390 200 430 C170 470 260 540 360 500 C440 470 470 380 480 300 C488 230 470 160 440 110';
---

<BaseLayout
  title={`Mock C, Monsoon in red: ${brand}`}
  description={`Design direction C for the ${brand} demo, recoloured in the brand’s red, black and white.`}
>
  <MockBar name="C, Monsoon in red, black and white" />
  <Header
    items={mockNav}
    homeHref="/mocks/c"
    currentPath="/mocks/c"
    whatsappMessage={`Hello ${brand}, I would like help planning a holiday.`}
  />
  <main id="main">
    <Section tone="paper" spacing="none" aria-labelledby="hero-title" class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-tag">Holidays in India and abroad</p>
          <h1 id="hero-title" class="t-display">
            Pack light. <span class="t-accent">We’ll plan</span> the rest.
          </h1>
          <p class="t-lede">
            Backwaters, deserts, islands or the Alps: tell us who is travelling and what you love,
            and we plan the holiday day by day. Business travel too, handled just as carefully.
          </p>
          <div class="hero-actions">
            <Button href={whatsappFor('a holiday')} size="lg" iconStart="whatsapp" external>
              Plan my holiday
            </Button>
            <Button href="/mocks/c/package" variant="secondary" size="lg">
              See a sample trip
            </Button>
          </div>
        </div>
        <div class="hero-art">
          <figure class="arch hero-arch">
            <Picture
              src={udaipur}
              alt="The City Palace complex in Udaipur rising above the lake under a clear blue sky"
              formats={['avif', 'webp']}
              widths={[400, 640, 960, 1280]}
              sizes="(min-width: 1024px) 34vw, 82vw"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
          <p class="hero-chip">Udaipur, Rajasthan</p>
          <RouteLine
            class="hero-route"
            d={heroRoute}
            viewBox="0 0 496 580"
            halo
            markers={[{ cx: 440, cy: 110, r: 11 }]}
          />
        </div>
      </div>
    </Section>

    <Section tone="sand" rounded aria-labelledby="services-title" id="services">
      <div class="section-head">
        <h2 id="services-title" class="t-h2">
          Holidays first. <span class="t-accent">Everything else,</span> sorted.
        </h2>
        <p>
          We plan family holidays, honeymoons and group trips, and look after the visas, forex and
          bookings around them. Companies use the same team for business travel.
        </p>
      </div>
      <Stagger as="ul" class="svc-grid">
        {groups.map((group) => (
          <li class:list={['svc-cell', `svc-${group.id}`]}>
            <ServiceCard
              title={group.name}
              text={group.copy}
              items={group.items.map((item) => item.name)}
              tone={tones[group.id]}
            />
          </li>
        ))}
      </Stagger>
    </Section>

    <Section tone="paper" aria-labelledby="packages-title" id="packages">
      <div class="section-head">
        <h2 id="packages-title" class="t-h2">
          Trips to start dreaming about
        </h2>
        <p>
          Sample trips to show the idea. We change the pace, the hotels and the length to suit you.
          <SampleLabel />
        </p>
      </div>
      <div class="pkg-wrap">
        <RouteLine
          class="pkg-route"
          d="M0 30 C100 0 200 60 300 30 S500 0 600 30 S800 60 900 30 S1100 0 1200 30"
          viewBox="0 0 1200 60"
          preserveAspectRatio="none"
          draw="scroll"
          strokeWidth={4}
        />
        <Stagger as="ul" class="pkg-grid">
          {featured.map((item) => (
            <li class="pkg-cell">
              <PackageCard
                name={item.name}
                region={item.region}
                days={item.days}
                nights={item.nights}
                fromPrice={item.fromPrice}
                image={item.image}
                alt={item.alt}
                href={item.slug === 'kerala' ? '/mocks/c/package' : undefined}
                demo
              />
            </li>
          ))}
        </Stagger>
      </div>
    </Section>

    <Section tone="ink" mood="corporate" aria-labelledby="corporate-title">
      <Reveal class="corp">
        <div>
          <p class="t-eyebrow">Corporate travel</p>
          <h2 id="corporate-title" class="t-h2">
            One desk for every business trip.
          </h2>
        </div>
        <div class="corp-copy">
          <p class="t-lede">
            Flights, hotels and visas for your teams, booked within your travel policy, with a named
            team who knows your account.
          </p>
          <Button href={whatsappFor('corporate travel')} iconStart="whatsapp" external>
            Talk to the corporate desk
          </Button>
        </div>
      </Reveal>
    </Section>
  </main>
  <Enquiry topic="a holiday" />
  <Footer homeHref="/mocks/c" groups={mockFooterGroups} />
  <FloatingContact message={`Hello ${brand}, I would like help planning a holiday.`} />
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-6) var(--space-16);
  }

  .hero-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    align-content: center;
  }

  .hero-tag {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-art {
    position: relative;
    width: 82%;
    margin-inline: auto;
    aspect-ratio: 400 / 500;
  }

  .hero-arch {
    height: 100%;
  }

  .hero-arch :global(picture) {
    display: block;
    height: 100%;
  }

  .hero-art :global(.hero-route) {
    position: absolute;
    top: -8%;
    left: -12%;
    width: 124%;
    height: 116%;
  }

  .hero-chip {
    position: absolute;
    left: -0.75rem;
    top: 44%;
    z-index: 1;
    rotate: -4deg;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-16);
      padding-block: var(--space-12) var(--space-24);
    }

    .hero-art {
      width: 78%;
    }
  }

  /* Services */
  .svc-grid {
    display: grid;
    gap: var(--space-4);
  }

  .svc-cell {
    display: grid;
  }

  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }

    .svc-related {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  /* Packages */
  .pkg-wrap {
    position: relative;
  }

  .pkg-wrap :global(.pkg-route) {
    display: none;
  }

  .pkg-grid {
    position: relative;
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .pkg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10) var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .pkg-wrap :global(.pkg-route) {
      display: block;
      position: absolute;
      top: 34%;
      left: 0;
      width: 100%;
      height: 60px;
    }

    .pkg-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .pkg-cell:nth-child(even) {
      margin-top: var(--space-10);
    }
  }

  /* Corporate band */
  .corp {
    display: grid;
    gap: var(--space-8);
  }

  .corp .t-eyebrow {
    margin-bottom: var(--space-3);
  }

  .corp-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  @media (min-width: 1024px) {
    .corp {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
    }
  }
</style>
