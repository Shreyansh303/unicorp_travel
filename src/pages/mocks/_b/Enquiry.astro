---
import { callHref, email, mailHref, mobile, office, whatsappFor } from '../_shared/data';

interface Props {
  topic?: string;
}

const { topic } = Astro.props;
---

<section class="enquiry" aria-labelledby="enquiry-title">
  <div class="wrap enquiry-grid">
    <div>
      <p class="mono kicker">Next step</p>
      <h2 id="enquiry-title" class="h-section" style="margin-top: 1rem">
        Tell us the trip. We will come back with a plan.
      </h2>
      <p style="margin-top: 1rem; max-width: 32rem; color: var(--muted)">
        Share the dates, the travellers and any policy we should follow. A call or a message is
        enough to start.
      </p>
      <div class="actions" style="margin-top: 2rem">
        <a class="btn" href={whatsappFor(topic)}>
          Message on WhatsApp{' '}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        {callHref && mobile && (
          <a class="btn btn-ghost" href={callHref}>
            Call {mobile.display}
          </a>
        )}
      </div>
    </div>
    <dl class="mono">
      {mobile && callHref && (
        <div>
          <dt>Phone</dt>
          <dd>
            <a href={callHref}>{mobile.display}</a>
          </dd>
        </div>
      )}
      {email && mailHref && (
        <div>
          <dt>Email</dt>
          <dd style="text-transform: none">
            <a href={mailHref}>{email}</a>
          </dd>
        </div>
      )}
      {office && (
        <div>
          <dt>Office</dt>
          <dd>
            <address>
              {office.lines.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </address>
          </dd>
        </div>
      )}
    </dl>
  </div>
</section>
