---
import { callHref, email, mailHref, mobile, office, whatsappFor } from '../_shared/data';

interface Props {
  topic?: string;
}

const { topic } = Astro.props;
---

<section class="enquiry" aria-labelledby="enquiry-title">
  <div class="wrap enquiry-grid">
    <div>
      <h2 id="enquiry-title" class="display" style="font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem)">
        Tell us where you <em>need to be.</em>
      </h2>
      <p style="margin-top: 1rem; max-width: 30rem; color: #d9d2c5">
        Send a message with your dates and how many people are travelling. We reply with a plan and
        a price.
      </p>
      <div class="actions" style="margin-top: 2rem">
        <a class="btn" href={whatsappFor(topic)}>
          Message us on WhatsApp
        </a>
        {callHref && mobile && (
          <a class="link" href={callHref}>
            Call {mobile.display}
          </a>
        )}
      </div>
    </div>
    <dl>
      {email && mailHref && (
        <div>
          <dt>Email</dt>
          <dd>
            <a href={mailHref}>{email}</a>
          </dd>
        </div>
      )}
      {office && (
        <div>
          <dt>Office</dt>
          <dd>
            <address>
              {office.lines.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </address>
          </dd>
        </div>
      )}
    </dl>
  </div>
</section>
