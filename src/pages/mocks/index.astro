---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brand } from './_shared/data';
import heroJourney from '../../assets/photos/hero-journey.jpg';
import cityDusk from '../../assets/photos/corporate-city.jpg';
import udaipur from '../../assets/photos/rajasthan-1.jpg';

const directions = [
  {
    letter: 'a',
    name: 'Atlas',
    mood: 'Editorial, calm, quietly premium',
    image: heroJourney,
    alt: 'A winding road snaking through green mountain valleys, seen from above',
    swatches: ['#f4efe6', '#1d1b18', '#a8361b', '#e9e1d2'],
    rationale:
      'Paper and ink. Fraunces, a soft high-contrast serif, sets the headlines in large editorial sizes with italic accents; Source Sans 3 carries the body text. The palette is warm paper, near-black ink and one vermilion accent, with an antique world map as a faint texture. The route line is a vermilion pen stroke: in the hero it follows the winding road in the photograph, then reappears as a dashed survey line across the three service groups and down the day-by-day itinerary. The same restraint suits corporate buyers and holiday makers, so the two moods differ only in photography.',
  },
  {
    letter: 'b',
    name: 'Departure board',
    mood: 'Precise, corporate-first, confident',
    image: cityDusk,
    alt: 'A business district skyline glowing in golden evening light',
    swatches: ['#0a1628', '#102139', '#ffb81c', '#f3f5f8'],
    rationale:
      'A travel desk that runs on time. Schibsted Grotesk, a tight, sturdy grotesk, does the headlines and text; IBM Plex Mono labels codes, meta and facts like a flight board. The palette is deep navy with a signal amber and a cool light grey for holiday sections. The route line behaves like a transit map: straight runs and 45-degree turns between airport-code stops in the hero, and a solid amber line with square stations down the itinerary. Corporate pages lead on navy; holiday content sits on light panels within the same grid.',
  },
  {
    letter: 'c',
    name: 'Monsoon',
    mood: 'Warm, vivid, holiday-first',
    image: udaipur,
    alt: 'The City Palace complex in Udaipur rising above the lake under a clear blue sky',
    swatches: ['#fff4e2', '#f4a118', '#b8155a', '#0b5557'],
    rationale:
      'Colour and joy. Bricolage Grotesque, an expressive display face with lively curves, sets big, playful headlines; Figtree keeps the text friendly and easy to read. The palette is sand with marigold, rani pink and peacock teal, and photographs sit in arch frames that nod to the jharokha window. The route line is a looping rani-pink ribbon that swirls across the hero photograph, waves between the holiday cards and meanders down the itinerary past marigold day markers. Corporate travel appears as one of three colour cards, so the mood stays warm throughout.',
  },
];
---

<BaseLayout
  title={`Design directions: ${brand}`}
  description="Three visual directions for the Unicorp Travel demo website, for review."
>
  <main class="mocks-index">
    <header class="mi-head">
      <p class="mi-eyebrow">{brand} demo · Milestone 2</p>
      <h1>Three design directions</h1>
      <p>
        Each direction is a variation of the same idea: a thin route line drawn between destinations
        runs through the site. Every direction has a home page (hero, services and featured
        holidays) and a sample package page (hero, highlights and a day-by-day itinerary traced by
        the line). Packages and prices are sample content. Pick one to take forward.
      </p>
    </header>
    <ol class="mi-list">
      {directions.map((item) => (
        <li class="mi-card">
          <Picture
            src={item.image}
            alt={item.alt}
            formats={['avif', 'webp']}
            widths={[400, 640, 960]}
            sizes="(min-width: 1024px) 26rem, 100vw"
          />
          <div class="mi-body">
            <p class="mi-letter">Direction {item.letter.toUpperCase()}</p>
            <h2>{item.name}</h2>
            <p class="mi-mood">{item.mood}</p>
            <ul class="mi-swatches" aria-label={`${item.name} palette`}>
              {item.swatches.map((colour) => (
                <li style={`background: ${colour}`}>
                  <span class="mi-sr">{colour}</span>
                </li>
              ))}
            </ul>
            <p>{item.rationale}</p>
            <ul class="mi-links">
              <li>
                <a href={`/mocks/${item.letter}`}>Home page mock</a>
              </li>
              <li>
                <a href={`/mocks/${item.letter}/package`}>Package page mock</a>
              </li>
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>

<style is:global>
  .mocks-index {
    min-height: 100vh;
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1rem 5rem;
    background: #fafafa;
    color: #171717;
    font-family: system-ui, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }

  body:has(.mocks-index) {
    background: #fafafa;
  }

  @media (min-width: 768px) {
    .mocks-index {
      padding-inline: 2.5rem;
    }
  }

  .mocks-index a:focus-visible {
    outline: 2px solid #171717;
    outline-offset: 3px;
  }

  .mi-head {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .mi-eyebrow,
  .mi-letter {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #525252;
  }

  .mi-head h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .mi-head > p:last-child {
    color: #404040;
  }

  .mi-list {
    display: grid;
    gap: 2rem;
  }

  .mi-card {
    display: grid;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 0.75rem;
  }

  .mi-card img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 22rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .mi-card {
      grid-template-columns: 26rem 1fr;
    }

    .mi-card img {
      max-height: none;
      aspect-ratio: auto;
    }

    .mi-card picture {
      display: block;
      height: 100%;
    }
  }

  .mi-body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .mi-body {
      padding: 2rem;
    }
  }

  .mi-body h2 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .mi-mood {
    font-weight: 600;
    color: #404040;
  }

  .mi-body > p:not([class]) {
    color: #404040;
  }

  .mi-swatches {
    display: flex;
    gap: 0.375rem;
  }

  .mi-swatches li {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .mi-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .mi-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .mi-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: #171717;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .mi-links li + li a {
    background: transparent;
    color: #171717;
    box-shadow: inset 0 0 0 1.5px #171717;
  }
</style>
