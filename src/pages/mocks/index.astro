---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import { brand } from './_shared/data';
import udaipur from '../../assets/photos/rajasthan-1.jpg';

const swatches = [
  { name: 'Brand red', value: 'var(--red-600)' },
  { name: 'Deep red', value: 'var(--red-700)' },
  { name: 'Ink', value: 'var(--ink)' },
  { name: 'Paper', value: 'var(--paper)' },
  { name: 'White', value: 'var(--white)' },
];
---

<BaseLayout
  title={`Design review: ${brand}`}
  description={`The chosen visual direction for the ${brand} demo website and its styleguide, for review.`}
>
  <main>
    <Section tone="paper">
      <div class="mi">
        <div class="mi-copy">
          <p class="t-eyebrow">{brand} demo · Milestone 2</p>
          <h1 class="t-h2">
            Direction C, <span class="t-accent">in brand red</span>
          </h1>
          <p class="t-lede">
            Monsoon’s warm, expressive layout, Bricolage Grotesque and Figtree type, arched
            photographs and the looping route line, recoloured in the brand’s red, black and white.
            Red is kept for buttons, the route line and one word in a headline; black and white
            sections carry the rest. Packages and prices on the mocks are sample content.
          </p>
          <ul class="mi-swatches" aria-label="Palette">
            {swatches.map((swatch) => (
              <li>
                <span class="mi-chip" style={`background: ${swatch.value}`} />
                {swatch.name}
              </li>
            ))}
          </ul>
          <div class="mi-actions">
            <Button href="/mocks/c">Home page mock</Button>
            <Button href="/mocks/c/package" variant="secondary">
              Package page mock
            </Button>
            <Button href="/styleguide" variant="ghost" iconEnd="arrow-right">
              Styleguide
            </Button>
          </div>
        </div>
        <figure class="arch mi-photo">
          <Picture
            src={udaipur}
            alt="The City Palace complex in Udaipur rising above the lake under a clear blue sky"
            formats={['avif', 'webp']}
            widths={[400, 640, 960]}
            sizes="(min-width: 1024px) 30vw, 80vw"
            loading="eager"
          />
        </figure>
      </div>
    </Section>
  </main>
</BaseLayout>

<style>
  .mi {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .mi {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .mi-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .mi-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .mi-swatches li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mi-chip {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(20 17 16 / 0.2);
  }

  .mi-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .mi-photo {
    width: min(100%, 24rem);
    margin-inline: auto;
    aspect-ratio: 4 / 5;
  }

  .mi-photo :global(picture) {
    display: block;
    height: 100%;
  }
</style>
