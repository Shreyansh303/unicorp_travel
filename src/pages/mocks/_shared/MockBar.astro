---
/** Thin strip above each mock page naming the direction, with links back to the review pages. */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<nav class="mockbar" aria-label="Design review">
  <p>Design mock: {name}</p>
  <ul>
    <li>
      <a href="/mocks">All mocks</a>
    </li>
    <li>
      <a href="/styleguide">Styleguide</a>
    </li>
  </ul>
</nav>

<style>
  .mockbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-2) var(--gutter);
    background: var(--ink);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
  }

  .mockbar ul {
    display: flex;
    gap: var(--space-4);
  }

  .mockbar a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .mockbar a:focus-visible {
    outline-color: var(--white);
  }
</style>
