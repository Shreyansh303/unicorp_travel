---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Icon from '../components/ui/Icon.astro';
import FactsBlock from '../components/ui/FactsBlock.astro';
import ContactDesks from '../components/ui/ContactDesks.astro';
import MapPanel from '../components/ui/MapPanel.astro';
import EnquirySection from '../components/forms/EnquirySection.astro';
import {
  desksFor,
  listedPhones,
  shown,
  site,
  telHref,
  weekdays,
  whatsappHref,
  type Weekday,
} from '../config/site';
import { emailFor, greeting, mobile } from '../lib/enquiry';
import { routes } from '../lib/routes';

const office = shown(site.offices.operating);
const message = greeting('I would like to get in touch about a trip.');
const officeIn = office ? ` in ${office.locality}` : '';
const email = shown(site.email);
const mailHref = emailFor('Travel enquiry');
const phones = listedPhones();
const desks = desksFor('contact');

// Hours render only when site.ts allows them to be shown, and only for days with both times.
const hours = shown(site.hours);
const dayNames: Record<Weekday, string> = {
  monday: 'Monday',
  tuesday: 'Tuesday',
  wednesday: 'Wednesday',
  thursday: 'Thursday',
  friday: 'Friday',
  saturday: 'Saturday',
  sunday: 'Sunday',
};
const hourRows = hours
  ? weekdays
      .map((day) => ({ day: dayNames[day], value: hours[day] }))
      .filter((row) => row.value?.opens && row.value.closes)
  : [];
---

<PageLayout
  title="Contact us"
  description={`Phone, WhatsApp, email and the office address${officeIn}. Message us about a holiday, business travel or any travel service.`}
  topic="a trip"
  message={message}
  mood="corporate"
  noPhoneBar
  enquiry={{
    title: 'Not sure where',
    accent: 'to start?',
    text: 'Use the guided trip request: answer a few questions about your trip and send them to us in one go.',
  }}
>
  <PageHero
    title="Contact us"
    eyebrow="Talk to a person"
    lede="Message us on WhatsApp, call, email or visit the office. Tell us a little about the trip and we will take it from there."
    crumbs={[{ label: 'Home', href: routes.home }, { label: 'Contact' }]}
    mood="corporate"
    compact
  />

  <Section
    tone="sand"
    mood="corporate"
    aria-labelledby="ways-title"
    class="sec-compact ways-section"
  >
    <h2 id="ways-title" class="sr-only">
      Ways to reach us
    </h2>
    <div class="contact-grid">
      <ul class="ways">
        {mobile && (
          <li class="way way-wa">
            <span class="way-icon" aria-hidden="true">
              <Icon name="whatsapp" size={24} />
            </span>
            <h3 class="t-h4">WhatsApp</h3>
            <p class="t-muted">Send your plans, dates and questions in one chat.</p>
            <a
              class="way-link"
              href={whatsappHref(message)}
              target="_blank"
              rel="noopener noreferrer"
            >
              Chat on WhatsApp<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        )}
        {phones.length > 0 && (
          <li class="way way-phone">
            <span class="way-icon" aria-hidden="true">
              <Icon name="phone" size={24} />
            </span>
            <h3 class="t-h4">Phone</h3>
            <dl class="way-phones">
              {phones.map((entry) => (
                <div>
                  <span class="way-icon way-icon-row" aria-hidden="true">
                    <Icon name="phone" size={20} />
                  </span>
                  <dt>{entry.label}</dt>
                  <dd>
                    <a class="way-link" href={telHref(entry.phone)}>
                      {entry.phone.display}
                    </a>
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        )}
        {email && mailHref && (
          <li class="way way-mail">
            <span class="way-icon" aria-hidden="true">
              <Icon name="mail" size={24} />
            </span>
            <h3 class="t-h4">Email</h3>
            <p class="t-muted">Good for longer requests and company travel.</p>
            <a class="way-link" href={mailHref}>
              {email}
            </a>
          </li>
        )}
        {hourRows.length > 0 && (
          <li class="way way-hoursrow">
            <h3 class="t-h4">Office hours</h3>
            <dl class="way-hours">
              {hourRows.map((row) => (
                <div>
                  <dt>{row.day}</dt>
                  <dd>
                    {row.value?.opens} to {row.value?.closes}
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        )}
      </ul>
      {office && (
        <div class="visit">
          <h3 class="t-h4 visit-title">Visit the office</h3>
          <MapPanel address={office} compact />
        </div>
      )}
    </div>
  </Section>

  {desks.length > 0 && (
    <Section tone="white" mood="corporate" aria-labelledby="who-title" class="sec-compact">
      <div class="who-grid">
        <div class="who-head">
          <h2 id="who-title" class="t-h2">
            Who to contact
          </h2>
          <p class="t-muted">
            For a booking or a bill, reach the person who handles it. For anything else, use the
            ways above.
          </p>
        </div>
        <ContactDesks desks={desks} />
      </div>
    </Section>
  )}

  <EnquirySection
    title="Or write to us"
    accent="here."
    intro="Send a question about a holiday, business travel or any travel service, then choose WhatsApp or email to send it. Or ask us to call you."
    topic="a trip"
    formType="general"
    formTitle="Your question"
    tone="paper"
    mood="corporate"
  />

  <Section tone="white" mood="corporate" aria-labelledby="facts-title" class="sec-compact">
    <div class="facts-grid">
      <h2 id="facts-title" class="t-h2">
        Company details
      </h2>
      <FactsBlock />
    </div>
  </Section>
</PageLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  .ways {
    display: grid;
    gap: var(--space-4);
  }

  .way {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  .way-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--white);
  }

  .way-wa .way-icon {
    background: var(--red-600);
  }

  .way-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: var(--red-600);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .way-link:hover {
    text-decoration-thickness: 4px;
  }

  .way-phones,
  .way-hours {
    display: grid;
    gap: var(--space-2);
  }

  .way-phones dt,
  .way-hours dt {
    font-size: var(--text-sm);
    color: var(--stone-600);
  }

  .visit {
    display: grid;
    gap: var(--space-4);
  }

  .who-grid {
    display: grid;
    gap: var(--space-6);
  }

  .who-head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .facts-grid {
    display: grid;
    gap: var(--space-8);
  }

  .way-icon-row {
    display: none;
  }

  /*
   * Phones: the ways to reach us are 64px rows with hairlines and an arrow; the whole row is the
   * link. Visit comes after Email, the hours follow as a small list. Colour and radius as before.
   */
  @media (max-width: 767.98px) {
    .contact-grid {
      gap: 0;
    }

    .ways {
      display: contents;
    }

    .way {
      position: relative;
      order: 1;
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: center;
      align-content: center;
      min-height: 4rem;
      padding: var(--space-2) 2rem var(--space-2) 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      border-top: 1px solid var(--stone-300);
    }

    .way-phone {
      order: 2;
      display: block;
      padding: 0;
      border-top: 0;
    }

    .way-mail {
      order: 3;
    }

    .visit {
      order: 4;
    }

    .way-hoursrow {
      order: 5;
    }

    .way .way-icon {
      grid-row: 1 / span 2;
      width: 2.5rem;
      height: 2.5rem;
      margin: 0;
      border-radius: 50%;
    }

    .way-phone > .way-icon {
      display: none;
    }

    /* Each number is its own row, so the "Phone" heading is read out but not shown. */
    .way-phone > .t-h4 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .way-icon-row {
      display: grid;
    }

    .way > .t-h4,
    .way-phones dt {
      grid-column: 2;
      font-family: var(--font-text);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      letter-spacing: 0;
      line-height: 1.2;
      color: var(--stone-600);
    }

    .way > .t-muted {
      display: none;
    }

    .way-link {
      grid-column: 2;
      min-height: 0;
      font-size: 1.0625rem;
      line-height: 1.3;
      text-decoration: none;
    }

    /* The link covers the row; the arrow is a drawn chevron at its right edge. */
    .way-link::before {
      content: '';
      position: absolute;
      inset: 0;
    }

    .way-link::after {
      content: '';
      position: absolute;
      top: 50%;
      right: 0.375rem;
      width: 0.625rem;
      height: 0.625rem;
      border-top: 2px solid var(--ink);
      border-right: 2px solid var(--ink);
      transform: translateY(-50%) rotate(45deg);
    }

    .way-link:focus-visible {
      outline: none;
    }

    .way-link:focus-visible::before {
      outline: 3px solid var(--ink);
      outline-offset: -3px;
    }

    .way-phones {
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .way-phones > div {
      position: relative;
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: center;
      align-content: center;
      min-height: 4rem;
      padding: var(--space-2) 2rem var(--space-2) 0;
      border-top: 1px solid var(--stone-300);
    }

    .way-phones .way-icon-row {
      grid-row: 1 / span 2;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
    }

    .way-phones dt,
    .way-phones dd {
      grid-column: 2;
    }

    .visit {
      gap: var(--space-3);
      padding-block: var(--space-4);
      border-top: 1px solid var(--stone-300);
    }

    .visit-title {
      font-family: var(--font-text);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      letter-spacing: 0;
      color: var(--stone-600);
    }

    /* Office hours: a small two-column list under the rows. */
    .way-hoursrow {
      display: block;
      min-height: 0;
      padding: var(--space-4) 0 0;
      border-top: 1px solid var(--stone-300);
    }

    .way-hoursrow > .t-h4 {
      margin-bottom: var(--space-2);
    }

    .way-hours {
      gap: var(--space-1);
      font-size: var(--text-sm);
    }

    .way-hours > div {
      display: flex;
      justify-content: space-between;
      gap: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .facts-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-16);
    }
  }
</style>
