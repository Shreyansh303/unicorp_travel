---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import FactsBlock from '../components/ui/FactsBlock.astro';
import HowItWorks from '../components/ui/HowItWorks.astro';
import { shown, site } from '../config/site';
import { routes } from '../lib/routes';
import indiaGate from '../assets/photos/about-delhi-ncr.jpg';

const directors = shown(site.directors) ?? [];
const office = shown(site.offices.operating);
const where = office ? ` in ${office.locality}` : '';

const groups = Object.fromEntries(site.services.map((group) => [group.id, group]));

const cards = [
  {
    title: groups['leisure']?.name ?? 'Leisure travel',
    text: 'Domestic and international holidays for couples, families and groups.',
    href: routes.holidays,
    tone: 'red',
  },
  {
    title: groups['corporate']?.name ?? 'Corporate travel',
    text: 'Bookings for company travellers, checked against the company’s travel policy.',
    href: routes.corporate,
    tone: 'ink',
  },
  {
    title: groups['related']?.name ?? 'Travel-related services',
    text: 'Air tickets, visas and passports, hotels, forex, insurance, cruises, MICE, cars and coaches, international rail and FRRO help.',
    href: routes.services,
    tone: 'white',
  },
] as const;

const steps = [
  {
    title: 'You tell us',
    text: 'Where, when, who is travelling and roughly what you want to spend. A rough idea is enough to start.',
  },
  {
    title: 'We propose',
    text: 'We come back with a plan and a price: an itinerary for a holiday, or a setup for a company’s travel.',
  },
  {
    title: 'You decide',
    text: 'Ask for changes until it suits you. Nothing is booked until you say yes.',
  },
  {
    title: 'We arrange it',
    text: 'We make the bookings and send your documents before you leave.',
  },
];
---

<PageLayout
  title="About us"
  description={`${site.displayName} is a travel agency${where} for holidays, business travel and the visas, forex and bookings around a trip.`}
  topic="your company"
  mood="corporate"
  enquiry={{ title: 'Start with', accent: 'a conversation.', next: 'contact' }}
>
  <PageHero
    title={`About ${site.displayName}`}
    eyebrow="Who we are"
    lede={`We are a travel agency${where}. We plan holidays in India and abroad for families, couples and groups, and look after travel for companies, from hotels, cars and rail tickets to meetings and events. We also handle the paperwork that comes with a trip: visas and passports, foreign exchange, travel insurance and FRRO assistance. Every plan starts with a conversation, and nothing is booked until you agree.`}
    crumbs={[{ label: 'Home', href: routes.home }, { label: 'About' }]}
    image={{ src: indiaGate, alt: 'India Gate in New Delhi against a pink and purple sky' }}
    mood="corporate"
    compact
  >
    <Button href={routes.contact} size="lg" iconEnd="arrow-right" class="hero-contact">
      Contact us
    </Button>
  </PageHero>

  <Section tone="sand" mood="corporate" aria-labelledby="what-title" class="sec-compact">
    <div data-reveal class="section-head">
      <h2 id="what-title" class="t-h2">
        What we do
      </h2>
      <p>
        One team works across holidays, business travel and the services around them, so you can
        bring us the whole trip or just one part of it.
      </p>
    </div>
    <ul class="what-grid">
      {cards.map((card) => (
        <li>
          <ServiceCard title={card.title} text={card.text} href={card.href} tone={card.tone} />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="white" mood="corporate" aria-labelledby="how-title" class="sec-compact">
    <div data-reveal class="section-head">
      <h2 id="how-title" class="t-h2">
        How we work
      </h2>
      <p>The same four steps, whether it is a weekend away or a year of business trips.</p>
    </div>
    <HowItWorks steps={steps} list />
  </Section>

  <Section tone="paper" mood="corporate" aria-labelledby="facts-title" class="sec-compact">
    <div class="facts-grid">
      <div class="facts-head">
        <h2 id="facts-title" class="t-h2">
          Company details
        </h2>
        <p class="t-muted">The registered details of the company behind {site.displayName}.</p>
        {directors.length > 0 && (
          <div class="directors">
            <h3 class="t-h4">Who runs it</h3>
            <ul class="directors-list">
              {directors.map((director) => (
                <li>
                  <span class="director-name">{director.name}</span>, {director.title}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <FactsBlock />
    </div>
  </Section>
</PageLayout>

<style>
  .what-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .what-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .what-grid li {
    display: grid;
  }

  /* Phones: the contact link is in the bottom bar and the band; the cards are tighter. */
  @media (max-width: 767.98px) {
    :global(.hero-contact) {
      display: none;
    }

    .what-grid {
      gap: var(--space-3);
    }

    .what-grid :global(.svc-card) {
      gap: var(--space-2);
      padding: var(--space-5);
    }

    .what-grid :global(.svc-title) {
      font-size: var(--text-xl);
    }
  }

  .facts-grid {
    display: grid;
    gap: var(--space-8);
  }

  .facts-head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .directors {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .director-name {
    font-weight: var(--weight-bold);
  }

  @media (min-width: 1024px) {
    .facts-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-16);
    }
  }
</style>
