---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import FactsBlock from '../components/ui/FactsBlock.astro';
import HowItWorks from '../components/ui/HowItWorks.astro';
import { getEntry } from 'astro:content';
import { shown, site } from '../config/site';
import { routes } from '../lib/routes';
import indiaGate from '../assets/photos/about-delhi-ncr.jpg';

const office = shown(site.offices.operating);
const where = office ? ` in ${office.locality}` : '';

const groups = Object.fromEntries(site.services.map((group) => [group.id, group]));
// The corporate offer is sample content until the client confirms it.
const corporateDemo = (await getEntry('services', 'corporate'))?.data.demo ?? true;

const cards = [
  {
    title: groups['leisure']?.name ?? 'Leisure travel',
    text: 'Domestic and international holidays for couples, families and groups.',
    href: routes.holidays,
    tone: 'red',
    demo: false,
  },
  {
    title: groups['corporate']?.name ?? 'Corporate travel',
    text: 'Bookings for company travellers, checked against the company’s travel policy.',
    href: routes.corporate,
    tone: 'ink',
    demo: corporateDemo,
  },
  {
    title: groups['related']?.name ?? 'Travel-related services',
    text: 'Visas and passports, hotels, forex, insurance, cruises, MICE, cars and coaches, international rail and FRRO help.',
    href: routes.services,
    tone: 'white',
    demo: false,
  },
] as const;

const steps = [
  {
    title: 'You tell us',
    text: 'Where, when, who is travelling and roughly what you want to spend. A rough idea is enough to start.',
  },
  {
    title: 'We propose',
    text: 'We come back with a plan and a price: an itinerary for a holiday, or a setup for a company’s travel.',
  },
  {
    title: 'You decide',
    text: 'Ask for changes until it suits you. Nothing is booked until you say yes.',
  },
  {
    title: 'We arrange it',
    text: 'We make the bookings and send your documents before you leave.',
  },
];
---

<PageLayout
  title="About us"
  description={`${site.displayName} is a travel agency${where} for holidays, business travel and the visas, forex and bookings around a trip.`}
  topic="your company"
  mood="corporate"
  enquiry={{ title: 'Start with', accent: 'a conversation.', next: 'contact' }}
>
  <PageHero
    title={`About ${site.displayName}`}
    eyebrow="Who we are"
    lede={`We are a travel agency${where}. We plan holidays in India and abroad, look after travel for companies, and handle the paperwork and bookings that come with a trip.`}
    crumbs={[{ label: 'Home', href: routes.home }, { label: 'About' }]}
    image={{ src: indiaGate, alt: 'India Gate in New Delhi against a pink and purple sky' }}
    mood="corporate"
  >
    <Button href={routes.contact} size="lg" iconEnd="arrow-right">
      Contact us
    </Button>
  </PageHero>

  <Section tone="sand" mood="corporate" aria-labelledby="what-title">
    <div class="section-head">
      <h2 id="what-title" class="t-h2">
        What we do
      </h2>
      <p>
        One team works across holidays, business travel and the services around them, so you can
        bring us the whole trip or just one part of it.
      </p>
    </div>
    <ul class="what-grid">
      {cards.map((card) => (
        <li>
          <ServiceCard
            title={card.title}
            text={card.text}
            href={card.href}
            tone={card.tone}
            demo={card.demo}
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="white" mood="corporate" aria-labelledby="how-title">
    <div class="section-head">
      <h2 id="how-title" class="t-h2">
        How we work
      </h2>
      <p>The same four steps, whether it is a weekend away or a year of business trips.</p>
    </div>
    <HowItWorks steps={steps} />
  </Section>

  <Section tone="paper" mood="corporate" aria-labelledby="facts-title">
    <div class="facts-grid">
      <div class="facts-head">
        <h2 id="facts-title" class="t-h2">
          Company details
        </h2>
        <p class="t-muted">The registered details of the company behind {site.displayName}.</p>
      </div>
      <FactsBlock />
    </div>
  </Section>
</PageLayout>

<style>
  .what-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .what-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .what-grid li {
    display: grid;
  }

  .facts-grid {
    display: grid;
    gap: var(--space-8);
  }

  .facts-head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  @media (min-width: 1024px) {
    .facts-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-16);
    }
  }
</style>
