---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Icon from '../components/ui/Icon.astro';
import { greeting } from '../lib/enquiry';
import { routes } from '../lib/routes';

const links = [
  { href: routes.holidays, title: 'Holidays', text: 'Sample trips in India and abroad.' },
  {
    href: routes.services,
    title: 'Travel services',
    text: 'Visas, forex, insurance, hotels and more.',
  },
  {
    href: routes.corporate,
    title: 'Corporate travel',
    text: 'Business travel for companies.',
  },
  {
    href: routes.planMyTrip,
    title: 'Plan my trip',
    text: 'Tell us about your trip in five questions.',
  },
  { href: routes.contact, title: 'Contact', text: 'Phone, WhatsApp, email and the office.' },
  { href: routes.home, title: 'Home page', text: 'Start again from the beginning.' },
];
---

<PageLayout
  title="Page not found"
  description="This page does not exist. Find holidays, travel services, corporate travel or our contact details from here."
  message={greeting('I could not find a page on your website. Can you help?')}
  canonical={false}
  noPhoneBar
>
  <PageHero
    title="This page took"
    accent="a wrong turn."
    lede="The address may be mistyped, or the page may have moved. These links will get you back on the road."
    size="display"
    compact
  />
  <Section tone="sand" rounded aria-labelledby="links-title" class="sec-compact nf-links">
    <h2 id="links-title" class="t-h3 links-title">
      Where would you like to go?
    </h2>
    <ul class="links">
      {links.map((link) => (
        <li>
          <a class:list={['link-tile', link.href === routes.home && 'link-home']} href={link.href}>
            <span class="link-title">
              {link.title}
              <Icon name="arrow-right" size={22} class="tile-arrow" />
            </span>
            <span class="link-text">{link.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>
</PageLayout>

<style>
  .links-title {
    margin-bottom: var(--space-6);
  }

  .links {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .links li {
    display: grid;
  }

  .link-tile {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--sand-200);
    /* Only transform animates; the shadow changes at once. */
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .link-tile:hover {
    transform: translateY(var(--lift));
    box-shadow: var(--shadow-lg);
  }

  .link-tile:active {
    transform: scale(var(--press-scale-card));
    box-shadow: var(--shadow-md);
    transition-duration: var(--duration-instant);
  }

  .link-tile:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
    box-shadow: 0 0 0 7px var(--white);
  }

  .link-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-heading);
  }

  .link-tile :global(.tile-arrow) {
    color: var(--red-700);
  }

  .link-text {
    color: var(--stone-600);
  }

  /* Phones: a compact list of rows; the way home is the one red action, at the end. */
  @media (max-width: 767.98px) {
    /* Do not tuck under the short header: its "Read more" stays clear. */
    :global(.section-rounded.nf-links:not(:first-child)) {
      margin-top: 0;
    }

    .links {
      gap: 0;
    }

    .links-title {
      margin-bottom: var(--space-3);
    }

    .links li {
      border-top: 1px solid var(--sand-200);
    }

    .link-tile {
      gap: 2px;
      min-height: 4rem;
      padding: var(--space-3) 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      align-content: center;
    }

    .link-tile:hover,
    .link-tile:active {
      transform: none;
      box-shadow: none;
    }

    .link-tile:focus-visible {
      box-shadow: none;
      outline-offset: 2px;
    }

    .link-title {
      justify-content: space-between;
      font-size: 1.1875rem;
    }

    .link-text {
      font-size: 0.9375rem;
    }

    .links li:last-child {
      margin-top: var(--space-5);
      border-top: 0;
    }

    .link-tile.link-home {
      min-height: 3.5rem;
      padding: var(--space-3) var(--space-5);
      border-radius: var(--radius-pill);
      background: var(--accent);
      color: var(--on-accent);
      justify-items: center;
      text-align: center;
    }

    .link-home .link-title {
      justify-content: center;
    }

    .link-home :global(.tile-arrow),
    .link-home .link-text {
      color: var(--on-accent);
    }
  }
</style>
