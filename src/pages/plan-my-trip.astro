---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import journey from '../assets/photos/hero-journey.jpg';
import bali from '../assets/photos/bali-1.jpg';
import dubai from '../assets/photos/dubai-2.jpg';
import singapore from '../assets/photos/singapore-1.jpg';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import PlanMyTrip from '../components/planner/PlanMyTrip';
import { site, whatsappHref } from '../config/site';
import { callHref, emailFor, greeting, mobile } from '../lib/enquiry';
import { routes } from '../lib/routes';
import { tripBudgetOptions } from '../lib/forms';
import { regionIds, regionLabels, themeIds, themeLabels } from '../lib/packages';

/** The WhatsApp and email template for visitors who would rather not use the planner. */
const prompts = [
  'Trip type:',
  'Destination ideas:',
  'Dates and flexibility:',
  'Travellers:',
  'Budget per person and interests:',
];

const template = [
  `Hello ${site.displayName}, I would like to plan a trip.`,
  '',
  ...prompts.map((prompt) => `${prompt} `),
].join('\n');

const waHref = mobile ? whatsappHref(template) : null;
const regionOptions = regionIds.map((id) => ({ value: id, label: regionLabels[id] }));
const themeOptions = themeIds.map((id) => ({ value: id, label: themeLabels[id] }));
const mailHref = emailFor('Plan my trip', template);
/** Photos for the hero crossfade; the first one is the LCP image. */
// Singapore leads: the lightest of the four on phones, so the first photo (the LCP image) paints in budget.
const heroPhotos = [
  { src: singapore, alt: 'Aerial view of the Marina Bay waterfront in Singapore at dusk' },
  { src: journey, alt: 'A winding road snaking through green mountain valleys, seen from above' },
  { src: bali, alt: 'Green rice terraces among palm trees in Tegalalang, Bali' },
  {
    src: dubai,
    alt: 'The Dubai skyline in silhouette at sunset with the Burj Khalifa rising above it',
  },
];
---

<PageLayout
  title="Plan my trip"
  description="Tell us the trip type, destinations, dates, travellers and budget, and we will plan the trip with you. Send it by WhatsApp, phone or email."
  topic="planning a trip"
  noPhoneBar
  message={greeting('I would like to plan a trip with you.')}
  enquiry={{
    title: 'Rather just',
    accent: 'talk?',
    text: 'Call or message us and we will ask the questions for you.',
    next: 'contact',
  }}
>
  <PageHero
    title="Plan my"
    photos={heroPhotos}
    accent="trip."
    lede="Answer five quick questions, check them, then send them to us on WhatsApp or by email. We reply with ideas, a day-wise plan and a price to talk through. Nothing is booked until you agree."
    crumbs={[{ label: 'Home', href: routes.home }, { label: 'Plan my trip' }]}
    size="display"
    sheet
  >
    <noscript>
      <style is:inline>
        @media (max-width: 767.98px) {
          .hero-actions {
            display: flex !important;
            flex-direction: column;
          }
          .hero-note {
            display: block !important;
          }
        }
      </style>
    </noscript>
    <div class="hero-actions">
      {waHref && (
        <Button href={waHref} size="lg" iconStart="whatsapp" external>
          Send on WhatsApp
        </Button>
      )}
      {callHref && mobile && (
        <Button href={callHref} variant="secondary" size="lg" iconStart="phone">
          Call {mobile.display}
        </Button>
      )}
    </div>
    <p class="hero-note">
      The WhatsApp message opens with the five questions ready for your answers.
    </p>
    <div class="hero-start">
      <Link href="#planner" variant="standalone" data-needs-js>
        Or answer them step by step here
      </Link>
    </div>
  </PageHero>

  <Section
    tone="sand"
    rounded
    aria-labelledby="plan-step-title"
    id="planner"
    class="sec-compact plan-section"
    data-needs-js
  >
    <PlanMyTrip
      client:visible
      regions={regionOptions}
      themes={themeOptions}
      budgets={tripBudgetOptions}
      privacyHref={routes.privacy}
    />
  </Section>

  <Section tone="paper" aria-labelledby="send-title" class="sec-compact">
    <div class="send-grid">
      <div class="send-head">
        <h2 id="send-title" class="t-h2">
          Send it your way
        </h2>
        <p class="t-muted">
          Pick whichever suits you. Your message goes straight from your phone or email to us; this
          website does not store it.
        </p>
      </div>
      <ul class="send-list">
        {waHref && (
          <li>
            <h3 class="t-h4">WhatsApp</h3>
            <p class="t-muted">Opens a chat with the questions filled in.</p>
            <Link href={waHref} variant="standalone" external>
              Send on WhatsApp
            </Link>
          </li>
        )}
        {mailHref && (
          <li>
            <h3 class="t-h4">Email</h3>
            <p class="t-muted">Opens your email app with the same questions.</p>
            <Link href={mailHref} variant="standalone">
              Write an email
            </Link>
          </li>
        )}
        {callHref && mobile && (
          <li>
            <h3 class="t-h4">Phone</h3>
            <p class="t-muted">Talk it through and we will note the details.</p>
            <Link href={callHref} variant="standalone">
              Call {mobile.display}
            </Link>
          </li>
        )}
        <li>
          <h3 class="t-h4">Other ways</h3>
          <p class="t-muted">Office address, all phone numbers and company details.</p>
          <Link href={routes.contact} variant="standalone">
            Contact page
          </Link>
        </li>
      </ul>
    </div>
  </Section>
</PageLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .send-grid {
    display: grid;
    gap: var(--space-10);
  }

  .send-head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  @media (min-width: 1024px) {
    .send-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-16);
    }
  }

  .send-list {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .send-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .send-list li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  /* Phones: the one hero action starts the planner (the WhatsApp and call links are in "Send it
     your way" below); "Send it your way" becomes plain rows. */
  @media (max-width: 767.98px) {
    .hero-actions,
    .hero-note {
      display: none;
    }

    .hero-start :global(.link) {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      min-height: 3.5rem;
      border-radius: var(--radius-pill);
      background: var(--accent);
      color: var(--on-accent);
      font-size: 1.0625rem;
      text-decoration: none;
    }

    .hero-start :global(.link .link-arrow) {
      display: none;
    }

    .send-grid {
      gap: var(--space-6);
    }

    .send-list {
      gap: 0;
    }

    .send-list li {
      gap: var(--space-1);
      padding: var(--space-4) 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      border-top: 1px solid var(--sand-200);
    }

    .send-list li:last-child {
      border-bottom: 1px solid var(--sand-200);
    }
  }
</style>
