---
import { Picture } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import PackageCard from '../components/ui/PackageCard.astro';
import SampleLabel from '../components/ui/SampleLabel.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import RouteLine from '../components/motion/RouteLine.astro';
import Stagger from '../components/motion/Stagger.astro';
import Reveal from '../components/motion/Reveal.astro';
import { shown, site } from '../config/site';
import { getEntry } from 'astro:content';
import { getFeaturedPackages } from '../lib/content';
import { whatsappFor } from '../lib/enquiry';
import { formatDate } from '../lib/format';
import { regionLabels } from '../lib/packages';
import { packageHref, routes } from '../lib/routes';
import udaipur from '../assets/photos/rajasthan-1.jpg';

const office = shown(site.offices.operating);
const from = office ? ` from ${office.locality}` : '';
const featured = await getFeaturedPackages();
// The corporate offer is sample content until the client confirms it (24/7 support among it),
// so everything about it on this page sits inside a labelled block.
const corporateDemo = (await getEntry('services', 'corporate'))?.data.demo ?? true;

// One shared price-valid-until date can go in the phone footnote; differing dates are left out.
const validDates = new Set(featured.map((item) => formatDate(item.data.priceValidUntil)));
const sharedValidTo = validDates.size === 1 ? [...validDates][0] : undefined;
const packageSizes = '(min-width: 1024px) 22vw, (min-width: 768px) 45vw, calc(100vw - 2.5rem)';

const groupNames = Object.fromEntries(site.services.map((group) => [group.id, group]));
const shownItems = (id: string) =>
  (groupNames[id]?.items ?? [])
    .filter((item) => item.status === 'verified' || item.status === 'confirm')
    .map((item) => item.name);

const serviceCards = [
  {
    id: 'leisure',
    title: groupNames['leisure']?.name ?? 'Leisure travel',
    text: 'Holidays in India and abroad, planned day by day around who is travelling and what they enjoy.',
    items: shownItems('leisure'),
    href: routes.holidays,
    tone: 'red',
    demo: false,
  },
  {
    id: 'corporate',
    title: groupNames['corporate']?.name ?? 'Corporate travel',
    text: 'Flights, hotels and visas for your company’s travellers, booked within your travel policy.',
    items: shownItems('corporate'),
    href: routes.corporate,
    tone: 'ink',
    demo: corporateDemo,
  },
  {
    id: 'related',
    title: groupNames['related']?.name ?? 'Travel-related services',
    text: 'The paperwork and bookings around a trip, whether or not we plan the trip itself.',
    items: shownItems('related'),
    href: routes.services,
    tone: 'white',
    demo: false,
  },
] as const;

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'check-circle',
    title: 'One desk for holidays and business',
    text: 'One team plans family holidays and looks after company travel.',
  },
  {
    icon: 'info',
    title: 'The paperwork, handled with you',
    text: 'Visa and passport help, foreign exchange, travel insurance and FRRO assistance sit alongside the bookings.',
  },
  {
    icon: 'arrow-right',
    title: 'Plans that start with you',
    text: 'You tell us the dates, the travellers and the budget. We propose a plan, and nothing is booked until you agree.',
  },
  {
    icon: 'map-pin',
    title: office ? `An office in ${office.locality}` : 'Talk to a person',
    text: office
      ? `Our office is in ${office.locality}, ${office.region}. Visit us, or reach us by WhatsApp, phone or email.`
      : 'Reach us by WhatsApp, phone or email.',
  },
];

const heroRoute =
  'M0 470 C80 560 200 560 250 500 C300 440 230 390 200 430 C170 470 260 540 360 500 C440 470 470 380 480 300 C488 230 470 160 440 110';
---

<PageLayout
  overlayHeader
  title={`Holidays and business travel${from}`}
  description={`Holidays in India and abroad, corporate travel and visa, forex and insurance help, from one travel desk${office ? ` in ${office.locality}` : ''}. Send us an enquiry.`}
>
  <Section tone="paper" spacing="none" aria-labelledby="page-title" class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-tag hero-pop">Holidays and business travel</p>
        <h1 id="page-title" class="t-display">
          Pack light. <span class="t-accent">We’ll plan</span> the rest.
        </h1>
        <p class="t-lede hero-enter">
          Backwaters, deserts, islands or the Alps: tell us who is travelling and what you love, and
          we plan the holiday day by day. Business travel too, from the same desk.
        </p>
        <div class="hero-actions hero-enter" style="--enter-index: 2">
          <Button href={routes.planMyTrip} size="lg" iconEnd="arrow-right">
            Plan my trip
          </Button>
          <Button href={routes.holidays} variant="secondary" size="lg">
            See holidays
          </Button>
        </div>
        <p class="hero-corp hero-enter" style="--enter-index: 3">
          Booking for a company? <Link href={routes.corporate}>See corporate travel</Link>
        </p>
      </div>
      <div class="hero-art">
        <figure class="arch hero-arch">
          <Picture
            src={udaipur}
            alt="The City Palace complex in Udaipur rising above the lake under a clear blue sky"
            formats={['avif', 'webp']}
            widths={[400, 640, 960, 1280]}
            sizes="(min-width: 1366px) 440px, (min-width: 1024px) 34vw, (min-width: 768px) 82vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <p class="hero-chip hero-pop" style="--enter-delay: var(--delay-late)">
          Udaipur, Rajasthan
        </p>
        <RouteLine
          class="hero-route"
          d={heroRoute}
          viewBox="0 0 496 580"
          halo
          markers={[{ cx: 440, cy: 110, r: 11, shape: 'pin' }]}
        />
      </div>
    </div>
  </Section>

  <Section tone="sand" rounded aria-labelledby="services-title" id="services" class="fold-section">
    <div data-reveal class="section-head svc-head">
      <h2 id="services-title" class="t-h2">
        Holidays first. <span class="t-accent">Everything else,</span> sorted.
      </h2>
      <p>
        We plan family holidays, honeymoons and group trips, and look after the visas, forex and
        bookings around them. Companies use the same team for business travel.
      </p>
    </div>
    <Stagger as="ul" class="svc-grid" data-fold-group>
      {serviceCards.map((card) => (
        <li class:list={['svc-cell', `svc-${card.id}`]}>
          <ServiceCard
            title={card.title}
            text={card.text}
            items={card.items}
            tone={card.tone}
            href={card.href}
            demo={card.demo}
            fold
          />
        </li>
      ))}
    </Stagger>
  </Section>

  <Section tone="paper" aria-labelledby="packages-title" id="packages" class="fold-section">
    <div data-reveal class="section-head pkg-head">
      <h2 id="packages-title" class="t-h2">
        Trips to start dreaming about
      </h2>
      <p>
        Sample trips to show the idea. We change the pace, the hotels and the length to suit you.{' '}
        <SampleLabel />
      </p>
    </div>
    <div class="pkg-wrap" data-pager>
      <RouteLine
        class="pkg-route"
        d="M0 30 C100 0 200 60 300 30 S500 0 600 30 S800 60 900 30 S1100 0 1200 30"
        viewBox="0 0 1200 60"
        preserveAspectRatio="none"
        draw="scroll"
        strokeWidth={4}
      />
      <Stagger as="ul" class="pkg-grid" data-pager-track>
        {featured.map((item) => (
          <li class="pkg-cell">
            <PackageCard
              name={item.data.title}
              region={regionLabels[item.data.region]}
              days={item.data.duration.days}
              nights={item.data.duration.nights}
              fromPrice={item.data.fromPrice}
              priceBasis={item.data.priceBasis}
              validTo={formatDate(item.data.priceValidUntil)}
              image={item.data.images.hero.src}
              alt={item.data.images.hero.alt}
              href={packageHref(item)}
              demo={item.data.demo}
              sizes={packageSizes}
              fold
            />
          </li>
        ))}
      </Stagger>
      {/* Phones only: the script shows these under 768px. The row also swipes and tabs natively. */}
      <div class="pkg-pager" data-pager-controls hidden>
        <p class="pkg-count" aria-live="polite" data-pager-count>
          1 of {featured.length}
        </p>
        <div class="pkg-arrows">
          <button
            type="button"
            class="pkg-arrow pkg-prev"
            aria-label="Previous trip"
            data-pager-prev
          >
            <Icon name="arrow-right" size={20} />
          </button>
          <button type="button" class="pkg-arrow pkg-next" aria-label="Next trip" data-pager-next>
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>
    </div>
    <p class="pkg-note">
      Sample trips to show the idea{sharedValidTo ? `, valid to ${sharedValidTo}` : ''}. We change
      the pace, the hotels and the length to suit you. <SampleLabel />
    </p>
    <div class="pkg-more">
      <Link href={routes.holidays} variant="standalone">
        See all holidays
      </Link>
    </div>
  </Section>

  <Section tone="white" mood="corporate" aria-labelledby="why-title">
    <div data-reveal class="section-head">
      <h2 id="why-title" class="t-h2">
        Why people come to us
      </h2>
      <p>What we do, plainly put. Ask us anything about a trip before you decide.</p>
    </div>
    <Stagger as="ul" class="why-grid">
      {reasons.map((reason) => (
        <li class="why-item">
          <span class="why-icon" aria-hidden="true">
            <Icon name={reason.icon} size={22} />
          </span>
          <h3 class="t-h4">{reason.title}</h3>
          <p class="t-muted">{reason.text}</p>
        </li>
      ))}
    </Stagger>
  </Section>

  <Section tone="ink" mood="corporate" aria-labelledby="corporate-title">
    <Reveal class="corp">
      <div>
        <p class="t-eyebrow">Corporate travel</p>
        <h2 id="corporate-title" class="t-h2">
          One desk for every business trip.
        </h2>
      </div>
      <div class="corp-copy">
        <p class="t-lede">
          Flights, hotels and visas for your teams, checked against your travel policy, with a
          dedicated team for your account.
        </p>
        {corporateDemo && <SampleLabel />}
        <div class="corp-actions">
          <Button href={routes.corporate} iconEnd="arrow-right">
            Corporate travel
          </Button>
          <Button
            href={whatsappFor('corporate travel for my company')}
            variant="secondary"
            iconStart="whatsapp"
            external
          >
            Talk to the corporate desk
          </Button>
        </div>
      </div>
    </Reveal>
  </Section>
</PageLayout>

<style>
  .hero-grid {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-6) var(--space-16);
  }

  .hero-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    align-content: center;
  }

  .hero-tag {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-corp {
    color: var(--text-muted);
  }

  .hero-art {
    position: relative;
    width: 82%;
    max-width: 26rem;
    margin-inline: auto;
    aspect-ratio: 400 / 500;
  }

  .hero-arch {
    height: 100%;
  }

  .hero-arch :global(picture) {
    display: block;
    height: 100%;
  }

  .hero-art :global(.hero-route) {
    position: absolute;
    top: -8%;
    left: -12%;
    width: 124%;
    height: 116%;
  }

  .hero-chip {
    position: absolute;
    left: -0.75rem;
    top: 44%;
    z-index: 1;
    rotate: -4deg;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  /* Phones: full-bleed photo, then the headline on a cream sheet that overlaps it by 32px. */
  @media (max-width: 767.98px) {
    .hero-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-block: 0;
      margin-inline: calc(-1 * var(--gutter));
    }

    .hero-art {
      order: -1;
      width: 100%;
      max-width: none;
      height: 23.75rem;
      margin: 0;
      aspect-ratio: auto;
    }

    .hero-arch {
      border-radius: 0;
    }

    .hero-arch :global(img) {
      object-position: 55% 50%;
    }

    .hero-art :global(.hero-route) {
      display: none;
    }

    .hero-chip {
      left: 1.25rem;
      top: auto;
      bottom: 3rem;
      rotate: 0deg;
    }

    .hero-copy {
      position: relative;
      z-index: var(--z-raised);
      margin-top: -2rem;
      padding: 2rem 1.25rem 2.5rem;
      border-radius: 2rem 2rem 0 0;
      background: var(--paper);
      justify-items: stretch;
    }

    .hero-tag,
    .hero-corp {
      display: none;
    }

    .hero-copy h1 {
      font-size: 3.125rem;
      line-height: 0.96;
      letter-spacing: -0.045em;
    }

    .hero-copy .t-lede {
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--stone-600);
      margin-top: -0.625rem;
    }

    .hero-actions {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.25rem;
    }

    .hero-actions :global(.btn-primary) {
      width: 100%;
      min-height: 3.5rem;
      font-size: 1.0625rem;
    }

    .hero-actions :global(.btn-secondary),
    .hero-actions :global(.btn-secondary:hover) {
      min-height: 3rem;
      padding: 0;
      background: transparent;
      box-shadow: none;
      transform: none;
      color: var(--ink);
      font-size: 1rem;
      font-weight: var(--weight-bold);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-16);
      padding-block: var(--space-12) var(--space-24);
    }

    .hero-art {
      width: 78%;
      max-width: none;
    }
  }

  /* The two-column hero is narrow up to 1280px: a smaller headline keeps it to three lines. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero-copy h1 {
      font-size: clamp(3.25rem, 6.5vw, 7.5rem);
    }
  }

  /* Phones: the Services and Trips sections use a 20px gutter and 48px of air. */
  @media (max-width: 767.98px) {
    .fold-section {
      --gutter: 1.25rem;
      --space-section: 3rem;
    }

    .svc-head,
    .pkg-head {
      margin-bottom: var(--space-4);
    }

    .svc-head > p,
    .pkg-head > p {
      display: none;
    }
  }

  /* Services */
  .svc-grid {
    display: grid;
    gap: var(--space-4);
  }

  .svc-cell {
    display: grid;
  }

  @media (max-width: 767.98px) {
    .svc-grid {
      gap: 0;
      border-top: 1px solid var(--stone-300);
    }
  }

  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }

    .svc-related {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  /* Packages */
  .pkg-wrap {
    position: relative;
  }

  .pkg-wrap :global(.pkg-route) {
    display: none;
  }

  .pkg-grid {
    position: relative;
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .pkg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10) var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .pkg-wrap :global(.pkg-route) {
      display: block;
      position: absolute;
      top: 34%;
      left: 0;
      width: 100%;
      height: 60px;
    }

    .pkg-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .pkg-cell:nth-child(even) {
      margin-top: var(--space-10);
    }
  }

  .pkg-pager,
  .pkg-note {
    display: none;
  }

  /* Phones: one trip at a time in a swipeable row; the buttons and the counter drive the same row. */
  @media (max-width: 767.98px) {
    .pkg-grid {
      display: flex;
      gap: 1.5rem;
      /* Room for the focus ring inside the clipping scroller; the margin cancels the padding. */
      margin: -0.75rem;
      padding: 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0.75rem;
      scrollbar-width: none;
    }

    .pkg-grid::-webkit-scrollbar {
      display: none;
    }

    .pkg-cell {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    /* Cards beside the visible one are clipped, not below the fold: never hide them for a reveal. */
    .pkg-cell.reveal-armed {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .pkg-pager:not([hidden]) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1.25rem;
    }

    .pkg-count {
      font-size: 0.9375rem;
      font-weight: 700;
    }

    .pkg-arrows {
      display: flex;
      gap: 0.5rem;
    }

    .pkg-arrow {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      padding: 0;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      transition: transform var(--duration-fast) var(--ease-bounce);
    }

    .pkg-arrow:active {
      transform: scale(var(--press-scale));
    }

    .pkg-next {
      background: var(--ink);
      color: var(--white);
    }

    .pkg-prev :global(svg) {
      transform: scaleX(-1);
    }

    .pkg-note {
      display: block;
      margin-top: 1.25rem;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--stone-600);
    }
  }

  .pkg-more {
    margin-top: var(--space-10);
  }

  @media (max-width: 767.98px) {
    .pkg-more {
      margin-top: 0.75rem;
    }
  }

  /* Why */
  .why-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .why-item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 2px solid var(--ink);
  }

  .why-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--white);
  }

  /* Corporate band */
  .corp {
    display: grid;
    gap: var(--space-8);
  }

  .corp .t-eyebrow {
    margin-bottom: var(--space-3);
  }

  .corp-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .corp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 1024px) {
    .corp {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
    }
  }
</style>

<script>
  /**
   * Trips pager (phones, under 768px). The cards stay one scroll-snap row, so swiping, tabbing
   * and every link keep working natively; the buttons and the "1 of N" counter are added on top.
   * At 768px and up the controls stay hidden and the row is a grid.
   */
  const phone = window.matchMedia('(max-width: 767.98px)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function bind(root: HTMLElement): void {
    const track = root.querySelector<HTMLElement>('[data-pager-track]');
    const controls = root.querySelector<HTMLElement>('[data-pager-controls]');
    const count = root.querySelector<HTMLElement>('[data-pager-count]');
    const prev = root.querySelector<HTMLButtonElement>('[data-pager-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-pager-next]');
    if (!track || !controls || !count || !prev || !next) return;
    const cards = Array.from(track.children) as HTMLElement[];
    const total = cards.length;
    let timer = 0;

    const step = (): number => {
      const [first, second] = cards;
      return first && second ? second.offsetLeft - first.offsetLeft : track.clientWidth;
    };
    const current = (): number =>
      Math.min(total - 1, Math.max(0, Math.round(track.scrollLeft / step())));
    const show = (): void => {
      count.textContent = `${current() + 1} of ${total}`;
    };
    const go = (index: number): void => {
      track.scrollTo({ left: index * step(), behavior: reduced.matches ? 'auto' : 'smooth' });
    };

    // The counter settles once the row stops moving, so a wrap-around does not announce every card.
    track.addEventListener('scroll', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(show, 90);
    });
    prev.addEventListener('click', () => go((current() - 1 + total) % total));
    next.addEventListener('click', () => go((current() + 1) % total));

    const sync = (): void => {
      controls.hidden = !phone.matches;
      if (phone.matches) show();
    };
    phone.addEventListener('change', sync);
    sync();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-pager]').forEach((root) => {
      if (root.dataset['bound']) return;
      root.dataset['bound'] = 'true';
      bind(root);
    });
  });
</script>
