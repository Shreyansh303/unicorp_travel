---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import PackageCard from '../components/ui/PackageCard.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import HeroCrossfade from '../components/ui/HeroCrossfade.astro';
import RouteLine from '../components/motion/RouteLine.astro';
import Stagger from '../components/motion/Stagger.astro';
import Reveal from '../components/motion/Reveal.astro';
import { shown, site } from '../config/site';
import { getFeaturedPackages } from '../lib/content';
import { whatsappFor } from '../lib/enquiry';
import { formatDate } from '../lib/format';
import { regionLabels } from '../lib/packages';
import { packageHref, routes } from '../lib/routes';
import udaipur from '../assets/photos/rajasthan-1.jpg';
import kerala from '../assets/photos/kerala-backwaters-1.jpg';
import bali from '../assets/photos/bali-1.jpg';
import singapore from '../assets/photos/singapore-1.jpg';
import switzerland from '../assets/photos/switzerland-1.jpg';
import airport from '../assets/photos/corporate-airport.jpg';
import { getImage } from 'astro:assets';

const office = shown(site.offices.operating);
const from = office ? ` from ${office.locality}` : '';
const featured = await getFeaturedPackages();

// One shared price-valid-until date can go in the phone footnote; differing dates are left out.
const validDates = new Set(featured.map((item) => formatDate(item.data.priceValidUntil)));
const sharedValidTo = validDates.size === 1 ? [...validDates][0] : undefined;
const packageSizes = '(min-width: 1024px) 22vw, (min-width: 768px) 45vw, calc(100vw - 2.5rem)';

const groupNames = Object.fromEntries(site.services.map((group) => [group.id, group]));
const shownItems = (id: string) =>
  (groupNames[id]?.items ?? [])
    .filter((item) => item.status === 'verified' || item.status === 'confirm')
    .map((item) => item.name);

const serviceCards = [
  {
    id: 'leisure',
    title: groupNames['leisure']?.name ?? 'Leisure travel',
    text: 'Holidays in India and abroad, planned day by day around who is travelling and what they enjoy.',
    items: shownItems('leisure'),
    href: routes.holidays,
    linkLabel: 'See holidays',
    tone: 'red',
  },
  {
    id: 'corporate',
    title: groupNames['corporate']?.name ?? 'Corporate travel',
    text: 'Flights, hotels and visas for your company’s travellers, booked within your travel policy.',
    items: shownItems('corporate'),
    href: routes.corporate,
    linkLabel: 'See corporate travel',
    tone: 'ink',
  },
  {
    id: 'related',
    title: groupNames['related']?.name ?? 'Travel-related services',
    text: 'The paperwork and bookings around a trip, whether or not we plan the trip itself.',
    items: shownItems('related'),
    href: routes.services,
    linkLabel: 'See all services',
    tone: 'white',
  },
] as const;

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'check-circle',
    title: 'One desk for holidays and business',
    text: 'One team plans family holidays and looks after company travel.',
  },
  {
    icon: 'info',
    title: 'The paperwork, handled with you',
    text: 'Visa and passport help, foreign exchange, travel insurance and FRRO assistance sit alongside the bookings.',
  },
  {
    icon: 'arrow-right',
    title: 'Your trip, planned your way',
    text: 'You tell us the dates, the travellers and the budget. We propose a plan, and nothing is booked until you agree.',
  },
  {
    icon: 'check',
    title: 'Stays and transport, sorted',
    text: 'Hotels, cars and coaches with drivers, rail tickets and cruises, booked as part of the same plan.',
  },
];

/** Photos for the hero crossfade; the first is the LCP image. Each caption names its photo. */
const heroPhotos = [
  {
    src: udaipur,
    alt: 'The City Palace complex in Udaipur rising above the lake under a clear blue sky',
    caption: 'Udaipur, Rajasthan',
  },
  {
    src: kerala,
    alt: 'A traditional houseboat gliding along a palm-lined backwater in Kerala',
    caption: 'Kerala backwaters',
  },
  {
    src: bali,
    alt: 'Green rice terraces among palm trees in Tegalalang, Bali',
    caption: 'Tegalalang, Bali',
  },
  {
    src: singapore,
    alt: 'Aerial view of the Marina Bay waterfront in Singapore at dusk',
    caption: 'Marina Bay, Singapore',
  },
  {
    src: switzerland,
    alt: 'A still alpine lake below snow-capped Swiss peaks',
    caption: 'Swiss Alps',
  },
];
const heroSizes =
  '(min-width: 1366px) 440px, (min-width: 1024px) 34vw, (min-width: 768px) 82vw, 100vw';

// Corporate band photo, phones only. Its sources match only below 768px and the fallback is an
// empty pixel, so a desktop browser has no reason to fetch the photo (the slot is also display:none
// there, and lazy). The slot is about 350px wide on a 390px phone.
const corpPhotoSizes = 'calc(100vw - 2.5rem)';
const corpPhotoSources = await Promise.all(
  (['avif', 'webp'] as const).map(async (format) => {
    const image = await getImage({
      src: airport,
      format,
      widths: [350, 700, 1050],
      sizes: corpPhotoSizes,
    });
    return { type: `image/${format}`, srcset: image.srcSet.attribute };
  }),
);
const emptyPixel = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---

<PageLayout
  overlayHeader
  title={`Holidays and business travel${from}`}
  brandFirst
  description={`Holidays in India and abroad, corporate travel and visa, forex and insurance help, from one travel desk${office ? ` in ${office.locality}` : ''}. Send us an enquiry.`}
>
  <Section tone="paper" spacing="none" aria-labelledby="page-title" class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-tag hero-pop">Holidays and Business Travel Pvt Ltd</p>
        <h1 id="page-title" class="t-display">
          Pack light. <span class="t-accent">We’ll plan</span> the rest.
        </h1>
        <p class="t-lede hero-enter">
          Backwaters, deserts, islands or the Alps: tell us who is travelling and what you love, and
          we plan the holiday day by day. Business travel too, from the same desk.
        </p>
        <div class="hero-actions hero-enter" style="--enter-index: 2">
          <Button href={routes.planMyTrip} size="lg" iconEnd="arrow-right">
            Plan my trip
          </Button>
          <Button href={routes.holidays} variant="secondary" size="lg">
            See holidays
          </Button>
        </div>
        <p class="hero-corp hero-enter" style="--enter-index: 3">
          Booking for a company? <Link href={routes.corporate}>See corporate travel</Link>
        </p>
      </div>
      <HeroCrossfade variant="home" photos={heroPhotos} sizes={heroSizes} />
    </div>
  </Section>

  <Section tone="sand" rounded aria-labelledby="services-title" id="services" class="fold-section">
    <div data-reveal class="section-head svc-head">
      <h2 id="services-title" class="t-h2">
        Holidays first. <span class="t-accent">Everything else,</span> sorted.
      </h2>
      <p>
        We plan family holidays, honeymoons and group trips, and look after the visas, forex and
        bookings around them. Companies use the same team for business travel.
      </p>
    </div>
    <Stagger as="ul" class="svc-grid" data-fold-group>
      {serviceCards.map((card) => (
        <li class:list={['svc-cell', `svc-${card.id}`]}>
          <ServiceCard
            title={card.title}
            text={card.text}
            items={card.items}
            tone={card.tone}
            href={card.href}
            linkLabel={card.linkLabel}
            fold
          />
        </li>
      ))}
    </Stagger>
  </Section>

  <Section tone="paper" aria-labelledby="packages-title" id="packages" class="fold-section">
    <div data-reveal class="section-head pkg-head">
      <h2 id="packages-title" class="t-h2">
        Trips to start dreaming about
      </h2>
      <p>
        Trips to start from. We change the pace, the hotels and the length to suit you.
      </p>
    </div>
    <div class="pkg-wrap" data-pager>
      <RouteLine
        class="pkg-route"
        d="M0 30 C100 0 200 60 300 30 S500 0 600 30 S800 60 900 30 S1100 0 1200 30"
        viewBox="0 0 1200 60"
        preserveAspectRatio="none"
        draw="scroll"
        strokeWidth={4}
      />
      <Stagger as="ul" class="pkg-grid" data-pager-track>
        {featured.map((item) => (
          <li class="pkg-cell">
            <PackageCard
              name={item.data.title}
              region={regionLabels[item.data.region]}
              days={item.data.duration.days}
              nights={item.data.duration.nights}
              fromPrice={item.data.fromPrice}
              priceBasis={item.data.priceBasis}
              validTo={formatDate(item.data.priceValidUntil)}
              image={item.data.images.hero.src}
              alt={item.data.images.hero.alt}
              href={packageHref(item)}
              sizes={packageSizes}
              fold
            />
          </li>
        ))}
      </Stagger>
      {/* Phones only: the script shows these under 768px. The row also swipes and tabs natively. */}
      <div class="pkg-pager" data-pager-controls hidden>
        <p class="pkg-count" aria-live="polite" data-pager-count>
          1 of {featured.length}
        </p>
        <div class="pkg-arrows">
          <button
            type="button"
            class="pkg-arrow pkg-prev"
            aria-label="Previous trip"
            data-pager-prev
          >
            <Icon name="arrow-right" size={20} />
          </button>
          <button type="button" class="pkg-arrow pkg-next" aria-label="Next trip" data-pager-next>
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>
    </div>
    <p class="pkg-note">
      Prices are indicative{sharedValidTo ? `, valid to ${sharedValidTo}` : ''}. We change the pace,
      the hotels and the length to suit you.
    </p>
    <div class="pkg-more">
      <Link href={routes.holidays} variant="standalone">
        See all holidays
      </Link>
    </div>
  </Section>

  <Section tone="white" mood="corporate" aria-labelledby="why-title" class="why-section">
    <div data-reveal class="section-head why-head">
      <h2 id="why-title" class="t-h2">
        Why people come to us
      </h2>
      <p>What we do, plainly put. Ask us anything about a trip before you decide.</p>
    </div>
    <Stagger as="ul" class="why-grid" data-why-row>
      {reasons.map((reason, index) => (
        <li class="why-item">
          <span class="why-num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="why-icon" aria-hidden="true">
            <Icon name={reason.icon} size={22} />
          </span>
          <h3 class="t-h4">{reason.title}</h3>
          <p class="t-muted">{reason.text}</p>
        </li>
      ))}
    </Stagger>
  </Section>

  <Section tone="ink" mood="corporate" aria-labelledby="corporate-title" class="corp-section">
    <Reveal class="corp">
      <div class="corp-photo" aria-hidden="true">
        <picture>
          {corpPhotoSources.map((source) => (
            <source
              type={source.type}
              srcset={source.srcset}
              sizes={corpPhotoSizes}
              media="(max-width: 767.98px)"
            />
          ))}
          <img src={emptyPixel} alt="" width="350" height="160" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div>
        <p class="t-eyebrow">Corporate travel</p>
        <h2 id="corporate-title" class="t-h2">
          One desk for every business trip.
        </h2>
      </div>
      <div class="corp-copy">
        <p class="t-lede">
          Flights, hotels and visas for your teams, checked against your travel policy, with a
          dedicated team for your account.
        </p>
        <div class="corp-actions">
          <Button href={routes.corporate} iconEnd="arrow-right" class="corp-link">
            Corporate travel
          </Button>
          <Button
            href={whatsappFor('corporate travel for my company')}
            variant="secondary"
            iconStart="whatsapp"
            external
            class="corp-desk"
          >
            Talk to the corporate desk
          </Button>
        </div>
      </div>
    </Reveal>
  </Section>
</PageLayout>

<style>
  .hero-grid {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-2) var(--space-10);
  }

  .hero-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    align-content: center;
  }

  .hero-tag {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-corp {
    color: var(--text-muted);
  }

  /* Phones: full-bleed photo, then the headline on a cream sheet that overlaps it by 32px. */
  @media (max-width: 767.98px) {
    .hero-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-block: 0;
      margin-inline: calc(-1 * var(--gutter));
    }

    .hero-copy {
      position: relative;
      z-index: var(--z-raised);
      margin-top: -2rem;
      padding: 2rem 1.25rem 2.5rem;
      border-radius: 2rem 2rem 0 0;
      background: var(--paper);
      justify-items: stretch;
    }

    .hero-tag,
    .hero-corp {
      display: none;
    }

    .hero-copy h1 {
      font-size: 3.125rem;
      line-height: 0.96;
      letter-spacing: -0.045em;
    }

    .hero-copy .t-lede {
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--stone-600);
      margin-top: -0.625rem;
    }

    .hero-actions {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.25rem;
    }

    .hero-actions :global(.btn-primary) {
      width: 100%;
      min-height: 3.5rem;
      font-size: 1.0625rem;
    }

    .hero-actions :global(.btn-secondary),
    .hero-actions :global(.btn-secondary:hover) {
      min-height: 3rem;
      padding: 0;
      background: transparent;
      box-shadow: none;
      transform: none;
      color: var(--ink);
      font-size: 1rem;
      font-weight: var(--weight-bold);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-16);
      padding-block: var(--space-2) var(--space-12);
    }
  }

  /* The two-column hero is narrow up to 1280px: a smaller headline keeps it to three lines. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero-copy h1 {
      font-size: clamp(3.25rem, 6.5vw, 7.5rem);
    }
  }

  /* Phones: the Services and Trips sections use a 20px gutter and 48px of air. */
  @media (max-width: 767.98px) {
    .fold-section {
      --gutter: 1.25rem;
      --space-section: 3rem;
    }

    .svc-head,
    .pkg-head {
      margin-bottom: var(--space-4);
    }

    .svc-head > p,
    .pkg-head > p {
      display: none;
    }
  }

  /* Services */
  .svc-grid {
    display: grid;
    gap: var(--space-4);
  }

  .svc-cell {
    display: grid;
  }

  @media (max-width: 767.98px) {
    .svc-grid {
      gap: 0;
      border-top: 1px solid var(--stone-300);
    }
  }

  @media (min-width: 768px) {
    .svc-grid {
      gap: 0;
      border-top: 1px solid var(--stone-600);
    }
  }

  /* Packages */
  .pkg-wrap {
    position: relative;
  }

  .pkg-wrap :global(.pkg-route) {
    display: none;
  }

  .pkg-grid {
    position: relative;
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .pkg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10) var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .pkg-wrap :global(.pkg-route) {
      display: block;
      position: absolute;
      top: 34%;
      left: 0;
      width: 100%;
      height: 60px;
    }

    .pkg-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .pkg-cell:nth-child(even) {
      margin-top: var(--space-10);
    }
  }

  .pkg-pager,
  .pkg-note {
    display: none;
  }

  /* Phones: one trip at a time in a swipeable row; the buttons and the counter drive the same row. */
  @media (max-width: 767.98px) {
    .pkg-grid {
      display: flex;
      gap: 1.5rem;
      /* Room for the focus ring inside the clipping scroller; the margin cancels the padding. */
      margin: -0.75rem;
      padding: 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0.75rem;
      scrollbar-width: none;
    }

    .pkg-grid::-webkit-scrollbar {
      display: none;
    }

    .pkg-cell {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    /* Cards beside the visible one are clipped, not below the fold: never hide them for a reveal. */
    .pkg-cell.reveal-armed {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .pkg-pager:not([hidden]) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1.25rem;
    }

    .pkg-count {
      font-size: 0.9375rem;
      font-weight: 700;
    }

    .pkg-arrows {
      display: flex;
      gap: 0.5rem;
    }

    .pkg-arrow {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      padding: 0;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      transition: transform var(--duration-fast) var(--ease-bounce);
    }

    .pkg-arrow:active {
      transform: scale(var(--press-scale));
    }

    .pkg-next {
      background: var(--ink);
      color: var(--white);
    }

    .pkg-prev :global(svg) {
      transform: scaleX(-1);
    }

    .pkg-note {
      display: block;
      margin-top: 1.25rem;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--stone-600);
    }
  }

  .pkg-more {
    margin-top: var(--space-10);
  }

  @media (max-width: 767.98px) {
    .pkg-more {
      margin-top: 0.75rem;
    }
  }

  /* Why */
  .why-grid {
    display: grid;
    gap: var(--space-8);
  }

  .why-num {
    display: none;
  }

  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .why-item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 2px solid var(--ink);
  }

  .why-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--white);
  }

  /* Phones: four 256px cards in one native swipe row on sand; the next card peeks past the edge. */
  @media (max-width: 767.98px) {
    .why-section {
      --gutter: 1.25rem;
      --space-section: 3rem;
    }

    .why-section.tone-white {
      --bg: var(--sand-100);
    }

    .why-head {
      margin-bottom: 1.25rem;
    }

    .why-head > p {
      display: none;
    }

    .why-grid {
      display: flex;
      gap: 0.75rem;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 0.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .why-grid::-webkit-scrollbar {
      display: none;
    }

    .why-grid:focus-visible {
      outline: 3px solid var(--ink);
      outline-offset: -3px;
    }

    .why-item {
      flex: 0 0 16rem;
      box-sizing: border-box;
      min-height: 12.5rem;
      gap: 0.625rem;
      padding: 1.25rem;
      border-top: 0;
      border-radius: 1.25rem;
      background: var(--white);
      scroll-snap-align: start;
    }

    /* Cards beside the visible one are clipped, not below the fold: never hide them for a reveal. */
    .why-item.reveal-armed {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .why-icon {
      display: none;
    }

    .why-num {
      display: block;
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 800;
      line-height: 1.2;
      color: var(--red-700);
    }

    .why-item h3 {
      font-size: 1.3125rem;
      line-height: 1.1;
    }

    .why-item p {
      font-size: 0.9375rem;
      line-height: 1.5;
      color: var(--stone-600);
    }
  }

  /* Corporate band */
  .corp {
    display: grid;
    gap: var(--space-8);
  }

  .corp .t-eyebrow {
    margin-bottom: var(--space-3);
  }

  .corp-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .corp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .corp-photo {
    display: none;
  }

  @media (min-width: 1024px) {
    .corp {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
    }
  }

  /* Phones: a 160px photo, the label and heading, then the outlined desk button and a text link. */
  @media (max-width: 767.98px) {
    .corp-section {
      --gutter: 1.25rem;
      --space-section: 3rem;
    }

    .corp {
      gap: 1rem;
    }

    .corp-photo {
      display: block;
      height: 10rem;
      border-radius: 1.25rem;
      overflow: hidden;
      background: var(--stone-800);
    }

    .corp-photo :global(picture),
    .corp-photo :global(img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .corp .t-eyebrow {
      margin-bottom: 1rem;
      color: var(--red-300);
    }

    .corp h2 {
      font-size: 2rem;
      line-height: 1.05;
    }

    .corp .t-lede {
      font-size: 1rem;
      line-height: 1.55;
    }

    .corp-copy {
      gap: 1rem;
      justify-items: stretch;
    }

    /* Stacked in DOM order (text link, then the outlined button), so focus order matches. */
    .corp-actions {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.25rem;
      margin-top: 0.5rem;
    }

    .corp-actions :global(.corp-desk) {
      width: 100%;
      min-height: 3.25rem;
      font-size: 1rem;
    }

    .corp-actions :global(.corp-link),
    .corp-actions :global(.corp-link:hover) {
      align-self: flex-start;
      min-height: 3rem;
      padding: 0;
      background: transparent;
      transform: none;
      color: var(--white);
      font-size: 1rem;
      font-weight: var(--weight-bold);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }
</style>

<script>
  /**
   * Trips pager (phones, under 768px). The cards stay one scroll-snap row, so swiping, tabbing
   * and every link keep working natively; the buttons and the "1 of N" counter are added on top.
   * At 768px and up the controls stay hidden and the row is a grid.
   */
  const phone = window.matchMedia('(max-width: 767.98px)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function bind(root: HTMLElement): void {
    const track = root.querySelector<HTMLElement>('[data-pager-track]');
    const controls = root.querySelector<HTMLElement>('[data-pager-controls]');
    const count = root.querySelector<HTMLElement>('[data-pager-count]');
    const prev = root.querySelector<HTMLButtonElement>('[data-pager-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-pager-next]');
    if (!track || !controls || !count || !prev || !next) return;
    const cards = Array.from(track.children) as HTMLElement[];
    const total = cards.length;
    let timer = 0;

    const step = (): number => {
      const [first, second] = cards;
      return first && second ? second.offsetLeft - first.offsetLeft : track.clientWidth;
    };
    const current = (): number =>
      Math.min(total - 1, Math.max(0, Math.round(track.scrollLeft / step())));
    const show = (): void => {
      count.textContent = `${current() + 1} of ${total}`;
    };
    const go = (index: number): void => {
      track.scrollTo({ left: index * step(), behavior: reduced.matches ? 'auto' : 'smooth' });
    };

    // The counter settles once the row stops moving, so a wrap-around does not announce every card.
    track.addEventListener('scroll', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(show, 90);
    });
    prev.addEventListener('click', () => go((current() - 1 + total) % total));
    next.addEventListener('click', () => go((current() + 1) % total));

    const sync = (): void => {
      controls.hidden = !phone.matches;
      if (phone.matches) show();
    };
    phone.addEventListener('change', sync);
    sync();
  }

  /**
   * Why row (phones). A scroller that holds no focusable item must itself be focusable, so a keyboard
   * user can scroll it with the arrow keys. It is a tab stop and gets a name only on phones; from
   * 768px the list is a plain grid and stays as it was.
   */
  function bindWhyRow(row: HTMLElement): void {
    const sync = (): void => {
      if (phone.matches) {
        row.tabIndex = 0;
        row.setAttribute('aria-label', 'Reasons to choose us, swipe sideways');
      } else {
        row.removeAttribute('tabindex');
        row.removeAttribute('aria-label');
      }
    };
    phone.addEventListener('change', sync);
    sync();
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-why-row]').forEach((row) => {
      if (row.dataset['bound']) return;
      row.dataset['bound'] = 'true';
      bindWhyRow(row);
    });
    document.querySelectorAll<HTMLElement>('[data-pager]').forEach((root) => {
      if (root.dataset['bound']) return;
      root.dataset['bound'] = 'true';
      bind(root);
    });
  });
</script>
