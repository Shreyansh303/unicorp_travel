---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Link from '../components/ui/Link.astro';
import Accordion from '../components/ui/Accordion.astro';
import { getFaqsGroupedByService } from '../lib/content';
import { greeting } from '../lib/enquiry';
import { midSentence, routes, serviceHref, serviceLabel } from '../lib/routes';

const allGroups = await getFaqsGroupedByService();

// The topic index sorts the services into three kinds of help (user-approved mockup B,
// 2026-11-06). The page's sections follow the same order. A service not listed here goes last.
const kinds = [
  { title: 'Holidays', ids: ['leisure', 'cruises', 'rail', 'car-coach'] },
  { title: 'Business travel', ids: ['corporate', 'mice', 'air-ticketing', 'hotels'] },
  { title: 'Papers and money', ids: ['visa-passport', 'frro', 'forex', 'insurance'] },
];
const listed = kinds.flatMap((kind) => kind.ids);
const index = kinds
  .map((kind) => ({
    title: kind.title,
    groups: kind.ids
      .map((id) => allGroups.find((group) => group.service.id === id))
      .filter((group) => group !== undefined),
  }))
  .filter((kind) => kind.groups.length > 0);
const others = allGroups.filter((group) => !listed.includes(group.service.id));
if (others.length > 0) index.push({ title: 'Other services', groups: others });
const groups = index.flatMap((kind) => kind.groups);
---

<PageLayout
  title="Frequently asked questions"
  description="Answers to common questions about holidays, corporate travel, visas, forex, insurance, hotels, cruises and other travel services."
  topic="a question about my trip"
  message={greeting('I have a question that your FAQ page does not answer.')}
  mood="corporate"
  enquiry={{
    title: 'Still have',
    accent: 'a question?',
    text: 'Ask us directly. Tell us about your trip and we will answer for your situation.',
    next: 'contact',
  }}
>
  <PageHero
    title="Questions and answers"
    eyebrow="FAQs"
    lede="Short answers to the questions we hear most often, grouped by service. Pick a topic to jump to its questions."
    crumbs={[{ label: 'Home', href: routes.home }, { label: 'FAQs' }]}
    mood="corporate"
    compact
  >
    <nav class="topics" aria-label="FAQ topics">
      {index.map((kind, i) => (
        <div class="topic-kind">
          <h2 class="topic-title" id={`topic-kind-${i}`}>
            {kind.title}
          </h2>
          <ul aria-labelledby={`topic-kind-${i}`}>
            {kind.groups.map((group) => (
              <li>
                <a href={`#faq-${group.service.id}`}>
                  <span>{serviceLabel(group.service)}</span>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </PageHero>

  {groups.map((group, index) => (
    <Section
      tone={index % 2 === 0 ? 'sand' : 'white'}
      mood="corporate"
      spacing="tight"
      id={`faq-${group.service.id}`}
      aria-labelledby={`faq-${group.service.id}-title`}
      class="faq-group"
    >
      <div class="group-grid">
        <div class="group-head">
          <h2 id={`faq-${group.service.id}-title`} class="t-h3">
            {group.service.data.title}
          </h2>
          <Link href={serviceHref(group.service)} variant="standalone">
            {group.service.data.category === 'leisure'
              ? 'See holidays'
              : `More on ${midSentence(serviceLabel(group.service))}`}
          </Link>
        </div>
        <Accordion
          id={`faqs-${group.service.id}`}
          phoneRows
          singleGroup="faqs"
          items={group.faqs.map((faq) => ({
            title: faq.data.question,
            body: faq.rendered?.html ?? '',
          }))}
        />
      </div>
    </Section>
  ))}
</PageLayout>

<style>
  /* Topic index: three short lists (one per kind of help), stacked on phones. */
  .topics {
    display: grid;
    gap: var(--space-6);
    width: 100%;
    margin-top: var(--space-2);
  }

  .topic-title {
    margin-bottom: var(--space-1);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-black);
    letter-spacing: 0;
    color: var(--accent-text);
  }

  .topics ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topics li {
    border-bottom: 1px solid var(--sand-200);
  }

  .topics a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap);
    padding-block: var(--space-2);
    color: var(--text);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .topics a svg {
    flex: none;
    color: var(--text-muted);
  }

  .topics a:hover span {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .topics a:hover svg {
    color: var(--accent-text);
  }

  .topics a:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .topics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8) var(--space-12);
    }
  }

  /* Phones: the title sits on its own line, then the group link. */
  @media (max-width: 767.98px) {
    .faq-group .group-grid {
      gap: var(--space-3);
    }

    .group-grid .group-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-1) var(--space-4);
    }

    .group-grid .group-head h2 {
      flex: 0 0 100%;
    }

    :global(section.faq-group) {
      scroll-margin-top: var(--space-16);
    }
  }

  .group-grid {
    display: grid;
    gap: var(--space-6);
  }

  .group-head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    align-content: start;
  }

  @media (min-width: 1024px) {
    .group-grid {
      grid-template-columns: 4fr 8fr;
      gap: var(--space-16);
    }

    .group-head {
      position: sticky;
      top: var(--space-8);
    }
  }

  .faq-group {
    scroll-margin-top: var(--space-4);
  }
</style>
