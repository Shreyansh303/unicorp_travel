---
/**
 * The visible "Sample content" label required on every piece of demo data (roadmap section 5).
 */
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<span class:list={['sample-label', className]} {...rest}>
  Sample content
</span>

<style>
  .sample-label {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.03em;
    line-height: 1.6;
    white-space: nowrap;
  }
</style>
