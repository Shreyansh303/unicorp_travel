---
/**
 * Progress through a multi-step form ("Plan my trip"). Steps are joined by the route line:
 * solid red where you have been, dotted where you are going. The current step carries
 * aria-current="step"; finished steps say "completed" to screen readers.
 */
import Icon from './Icon.astro';
import './stepper.css';

interface Props {
  steps: string[];
  /** Zero-based index of the current step. */
  current: number;
  label?: string;
  class?: string;
}

const { steps, current, label = 'Progress', class: className } = Astro.props;
const currentLabel = steps[current] ?? '';
---

<nav class:list={['stepper', className]} aria-label={label}>
  <p class="stepper-summary" aria-hidden="true">
    Step {current + 1} of {steps.length}: <strong>{currentLabel}</strong>
  </p>
  <ol class="stepper-list">
    {steps.map((step, index) => {
      const status = index < current ? 'done' : index === current ? 'current' : 'todo';
      return (
        <li
          class:list={['step', `step-${status}`]}
          aria-current={status === 'current' ? 'step' : undefined}
        >
          <span class="step-marker" aria-hidden="true">
            {status === 'done' ? <Icon name="check" size={18} /> : index + 1}
          </span>
          <span class="step-label">
            {step}
            {status === 'done' && <span class="sr-only"> (completed)</span>}
          </span>
        </li>
      );
    })}
  </ol>
</nav>
