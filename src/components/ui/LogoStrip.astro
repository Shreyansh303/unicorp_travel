---
/**
 * "Companies we have worked with": one row of client logos that scrolls slowly and continuously
 * (user decision, 2026-10-30; the second exception to the no-moving-carousel rule in roadmap
 * section 6). The list lives in site.ts. The row is the set twice: the second copy is aria-hidden
 * and only there so the loop is seamless (the track moves by exactly one copy).
 *
 * Only transform animates. Logos are always in colour. A company with no usable official logo is a
 * typographic logotype of the same height (a round monogram or small mark, then the name; no box). The row pauses while the pointer is over it. There is no Pause
 * button (user decision, 2026-10-31; a WCAG 2.2.2 gap recorded in the roadmap); a Next button
 * (2026-11-02) glides the row forward by about one screen of logos, then the slow scroll goes on.
 * With prefers-reduced-motion nothing moves: the row becomes a wrapped, static grid and the Next
 * button is hidden.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '../../config/site';
import Icon from './Icon.astro';
import './button.css';
import Section, { type Tone } from './Section.astro';

interface Props {
  tone?: Tone;
  class?: string;
}

const { tone = 'paper', class: className } = Astro.props;

// PNG logos go through Astro's image service (one resized WebP each). SVG logos are used as they
// are, never rewritten: the file's own viewBox gives the shape, and the URL comes from Vite.
const pngs = import.meta.glob<{ default: ImageMetadata }>('../../assets/clients/*.png', {
  eager: true,
});
const svgUrls = import.meta.glob<string>('../../assets/clients/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});
const svgText = import.meta.glob<string>('../../assets/clients/*.svg', {
  eager: true,
  query: '?raw',
  import: 'default',
});

// Heights the logos are shown at: 56px on phones, 72px from 768px. Sources are delivered at 2x,
// but never above their own size (Gateway Distriparks is only 166px tall).
const deliveredHeight = 144;

async function resolveLogo(client: (typeof site.clients)[number]) {
  const { name, logo, mark, monogram } = client;
  const none = { name, src: null, ratio: 0, width: 0, height: 0, monogram, mark: null };
  if (!logo && !mark) return none;
  const file = (logo ?? mark) as string;
  const key = `../../assets/clients/${file}`;
  if (file.endsWith('.svg')) {
    const url = svgUrls[key];
    const box = svgText[key]?.match(
      /viewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)\s*"/,
    );
    if (!url || !box) return null;
    const ratio = Number(box[1]) / Number(box[2]);
    return {
      ...none,
      src: logo ? url : null,
      mark: mark ? url : null,
      ratio,
      width: Math.round(deliveredHeight * ratio),
      height: deliveredHeight,
    };
  }
  const meta = pngs[key]?.default;
  if (!meta) return null;
  const height = Math.min(deliveredHeight, meta.height);
  const image = await getImage({ src: meta, height, format: 'webp' });
  const shown = {
    src: image.src,
    ratio: meta.width / meta.height,
    width: Number(image.attributes['width']),
    height: Number(image.attributes['height']),
  };
  return logo
    ? { ...none, ...shown }
    : { ...none, mark: image.src, ratio: shown.ratio, width: shown.width, height: shown.height };
}

// A company whose logo file is missing is dropped; one with no logo at all is a logotype.
const logos = (await Promise.all(site.clients.map(resolveLogo))).filter((logo) => logo !== null);

// The row is the set twice; the second copy is hidden from assistive technology.
const copies = [{ hidden: false }, { hidden: true }];
---

{logos.length > 0 && (
  <Section
    tone={tone}
    mood="corporate"
    aria-labelledby="clients-title"
    class:list={['sec-compact', className]}
  >
    <div class="strip-wrap" data-strip-root>
      <div class="strip-head">
        <h2 id="clients-title" class="t-h2">
          Companies we have worked with
        </h2>
        <button
          type="button"
          class="strip-next"
          data-strip-next
          aria-label="Show next companies"
          hidden
        >
          <Icon name="arrow-right" size={22} />
        </button>
      </div>

      <div class="strip" data-strip>
        <div class="strip-track">
          {copies.map((copy) => (
            <ul
              class:list={['strip-set', copy.hidden && 'strip-copy']}
              aria-hidden={copy.hidden ? 'true' : undefined}
              aria-labelledby={copy.hidden ? undefined : 'clients-title'}
            >
              {logos.map((logo) => (
                <li class="strip-item">
                  {logo.src ? (
                    <img
                      class="strip-logo"
                      src={logo.src}
                      alt={copy.hidden ? '' : logo.name}
                      width={logo.width}
                      height={logo.height}
                      style={`--ar:${logo.ratio.toFixed(3)}`}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="strip-type">
                      {logo.mark ? (
                        <img
                          class="strip-mark"
                          src={logo.mark}
                          alt=""
                          width={logo.width}
                          height={logo.height}
                          style={`--ar:${logo.ratio.toFixed(3)}`}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="strip-monogram" aria-hidden="true">
                          {logo.monogram}
                        </span>
                      )}
                      <span class="strip-name">{logo.name}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </Section>
)}

<style>
  .strip-wrap {
    --logo-h: 3.5rem;
    --logo-gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .strip-wrap {
      --logo-h: 4.5rem;
      --logo-gap: var(--space-16);
    }
  }

  /* Heading and arrow share one row at every width; the arrow sits at the end of the heading,
     centred vertically on it (on phones, on the whole two-line heading). */
  .strip-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .strip-head h2 {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* The row bleeds to the edges of the section and fades out at both ends. */
  .strip {
    overflow: hidden;
    margin-inline: calc(-1 * var(--gutter));
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .strip-track {
    display: flex;
    width: max-content;
    animation: strip-scroll var(--duration-marquee) linear infinite;
    will-change: transform;
  }

  @media (hover: hover) {
    .strip:hover .strip-track {
      animation-play-state: paused;
    }
  }

  /* One copy is at least as wide as the screen; the track moves by exactly one copy. */
  .strip-set {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-around;
    gap: var(--logo-gap);
    min-width: 100vw;
    margin: 0;
    padding: 0 var(--logo-gap) 0 0;
    list-style: none;
  }

  .strip-item {
    flex: none;
    display: flex;
    align-items: center;
  }

  /* Same height for every logo; very wide wordmarks are capped in width. Always in colour. */
  .strip-logo {
    display: block;
    height: var(--logo-h);
    width: calc(var(--logo-h) * min(var(--ar), 4.2));
    max-width: none;
    object-fit: contain;
  }

  /* A company without a usable official logo: a logotype as tall as the logos. A round monogram
     (or a small mark) then the name in the display face, on one or two lines. No box. */
  .strip-type {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: var(--logo-h);
    color: var(--ink);
  }

  .strip-monogram {
    display: grid;
    flex: none;
    place-items: center;
    width: calc(var(--logo-h) * 0.72);
    height: calc(var(--logo-h) * 0.72);
    border-radius: 50%;
    background: var(--red-700);
    color: var(--white);
    font-family: var(--font-display);
    font-size: calc(var(--logo-h) * 0.26);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .strip-mark {
    display: block;
    flex: none;
    height: calc(var(--logo-h) * 0.62);
    width: calc(var(--logo-h) * 0.62 * var(--ar));
    max-width: none;
    object-fit: contain;
  }

  .strip-name {
    max-width: 9.5rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.12;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .strip-name {
      font-size: var(--text-lg);
      max-width: 11rem;
    }
  }

  @keyframes strip-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* No movement: a static, wrapped grid; the second copy is not needed. */
  @media (prefers-reduced-motion: reduce) {
    .strip {
      margin-inline: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .strip-track {
      display: block;
      width: auto;
      animation: none;
      will-change: auto;
    }

    .strip-set {
      flex: 0 1 auto;
      flex-wrap: wrap;
      justify-content: center;
      min-width: 0;
      padding: 0;
      row-gap: var(--space-8);
    }

    .strip-copy {
      display: none;
    }

    /* Everything is already on screen. (Scoped under .strip-wrap to beat the base rule below.) */
    .strip-wrap .strip-next {
      display: none;
    }
  }

  /* Next: a plain round arrow button (no text; the accessible name is on aria-label). */
  .strip-next {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .strip-next:hover {
    background: var(--ink);
    color: var(--white);
  }

  .strip-next:focus-visible {
    outline: 2px solid var(--focus, var(--ink));
    outline-offset: 3px;
  }

  .strip-next[hidden] {
    display: none;
  }

  /* Phones: a slightly smaller arrow (still a 44px target) beside the two-line heading. */
  @media (max-width: 767.98px) {
    .strip-next {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>

<script>
  // Next: glide the running loop forward by about one screen of logos. The CSS animation keeps
  // running; its time is moved forward each frame, so only transform changes and the loop wraps
  // with no gap (the track is the set twice and the animation repeats forever).
  const root = document.querySelector<HTMLElement>('[data-strip-root]');
  const button = root?.querySelector<HTMLButtonElement>('[data-strip-next]');
  const track = root?.querySelector<HTMLElement>('.strip-track');
  const row = root?.querySelector<HTMLElement>('[data-strip]');

  if (root && button && track && row && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const glideMs = 600;
    let frame = 0;

    const animation = () => track.getAnimations()[0];

    const ease = (t: number) => 1 - Math.pow(1 - t, 3);

    button.hidden = false;
    button.addEventListener('click', () => {
      const anim = animation();
      const timing = anim?.effect?.getComputedTiming();
      const duration = Number(timing?.duration);
      const copyWidth = track.scrollWidth / 2;
      if (!anim || !duration || !copyWidth) return;

      const from = Number(anim.currentTime ?? 0);
      const to = from + (row.clientWidth / copyWidth) * duration;
      const started = performance.now();
      cancelAnimationFrame(frame);
      const step = (now: number) => {
        const t = Math.min(1, (now - started) / glideMs);
        anim.currentTime = from + (to - from) * ease(t);
        if (t < 1) frame = requestAnimationFrame(step);
      };
      frame = requestAnimationFrame(step);
    });
  }
</script>
