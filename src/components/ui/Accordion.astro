---
/**
 * Accordion (F-10): each question is a heading containing a button with aria-expanded that
 * controls a labelled region. Panels start closed; `open` lists the indexes to start open.
 * Without JavaScript every panel is shown. `phoneRows` restyles the rows for phones (60px
 * tap rows in the display face) and keeps one panel open at a time there; from 768 px the
 * accordion behaves as before.
 */
import Icon from './Icon.astro';

interface Item {
  title: string;
  /** Plain text or simple HTML written in this codebase (never user input). */
  body: string;
}

interface Props {
  id: string;
  items: Item[];
  open?: number[];
  headingLevel?: 2 | 3 | 4;
  phoneRows?: boolean;
  /** With `phoneRows`: accordions sharing this name keep one panel open between them (FAQs). */
  singleGroup?: string;
  class?: string;
}

const { id, items, open = [], headingLevel = 3, phoneRows = false, singleGroup, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<div
  class:list={['accordion', phoneRows && 'acc-phone-rows', className]}
  data-accordion
  data-single-on-phone={phoneRows ? 'true' : undefined}
  data-single-group={phoneRows ? singleGroup : undefined}
>
  {items.map((item, index) => {
    const isOpen = open.includes(index);
    const buttonId = `${id}-button-${index}`;
    const panelId = `${id}-panel-${index}`;
    return (
      <div class="acc-item">
        <Heading class="acc-heading">
          <button
            type="button"
            class="acc-button"
            id={buttonId}
            aria-expanded={isOpen ? 'true' : 'false'}
            aria-controls={panelId}
            data-accordion-button
          >
            <span>{item.title}</span>
            <span class="acc-icon" aria-hidden="true">
              <Icon name="chevron-down" size={22} />
            </span>
          </button>
        </Heading>
        <div
          class="acc-panel"
          id={panelId}
          role="region"
          aria-labelledby={buttonId}
          hidden={!isOpen}
        >
          <div class="acc-body" set:html={item.body} />
        </div>
      </div>
    );
  })}
  <noscript>
    <style is:inline>
      .acc-panel[hidden] {
        display: block !important;
      }
    </style>
  </noscript>
</div>

<style>
  .accordion {
    border-top: 1px solid var(--border);
  }

  .acc-item {
    border-bottom: 1px solid var(--border);
  }

  .acc-heading {
    font-family: var(--font-text);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    letter-spacing: 0;
  }

  .acc-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    min-height: 3.5rem;
    padding: var(--space-4) var(--space-1);
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .acc-button:hover span:first-child {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .acc-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--surface-sunken);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .acc-button[aria-expanded='true'] .acc-icon {
    background: var(--accent);
    color: var(--on-accent);
    transform: rotate(var(--turn));
  }

  .acc-panel:not([hidden]) {
    animation: acc-in var(--duration-base) var(--ease-out);
  }

  @media (max-width: 767.98px) {
    .acc-phone-rows .acc-heading {
      font-family: var(--font-display);
      font-size: 1.1875rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
    }

    .acc-phone-rows .acc-button {
      min-height: 3.75rem;
    }
  }

  @keyframes acc-in {
    from {
      opacity: 0;
    }
  }

  .acc-body {
    max-width: 44rem;
    padding: 0 var(--space-1) var(--space-6);
    color: var(--text-muted);
  }
</style>

<script>
  const phone = window.matchMedia('(max-width: 767.98px)');

  function bind(root: HTMLElement): void {
    if (root.dataset['bound']) return;
    root.dataset['bound'] = 'true';
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-accordion-button]'));
    const set = (button: HTMLButtonElement, open: boolean): void => {
      const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
      button.setAttribute('aria-expanded', String(open));
      if (panel) panel.hidden = !open;
    };
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        if (open && root.dataset['singleOnPhone'] && phone.matches) {
          const group = root.dataset['singleGroup'];
          const scope = group
            ? Array.from(
                document.querySelectorAll<HTMLButtonElement>(
                  `[data-single-group="${group}"] [data-accordion-button]`,
                ),
              )
            : buttons;
          scope.forEach((other) => {
            if (other !== button) set(other, false);
          });
        }
        set(button, open);
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-accordion]').forEach(bind);
  });
</script>
