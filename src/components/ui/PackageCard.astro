---
/**
 * Holiday package card: arched photo, region and length, name, indicative "from" price and
 * what that price covers (the entry's priceBasis).
 * With `demo` it carries the visible "Sample content" label (roadmap section 5).
 * With `href` the whole card is one link.
 * With `fold` (Home) the card is a 380px photo card on phones, with the details on a white inset
 * panel; the per-card label and "Valid to" line step aside there (the section carries both).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SampleLabel from './SampleLabel.astro';
import { formatINR } from '../../lib/format';

interface Props {
  name: string;
  region: string;
  days: number;
  nights: number;
  fromPrice: number;
  /** What the price covers, e.g. "per person, twin sharing, land arrangements only". */
  priceBasis?: string;
  validTo?: string;
  image: ImageMetadata;
  alt: string;
  href?: string | undefined;
  demo?: boolean;
  /** Phone photo-card layout (Home pager). */
  fold?: boolean;
  headingLevel?: 2 | 3 | 4;
  sizes?: string;
  state?: 'hover' | 'focus';
  class?: string;
}

const {
  name,
  region,
  days,
  nights,
  fromPrice,
  priceBasis,
  validTo,
  image,
  alt,
  href,
  demo = false,
  fold = false,
  headingLevel = 3,
  sizes = '(min-width: 1024px) 22vw, (min-width: 768px) 45vw, 100vw',
  state,
  class: className,
  ...rest
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<article
  class:list={[
    'pkg-card',
    href && 'pkg-card-link',
    fold && 'pkg-fold',
    state && `is-${state}`,
    className,
  ]}
  {...rest}
>
  <div class="arch pkg-photo">
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[400, 640, 800]}
      sizes={sizes}
    />
  </div>
  <div class="pkg-body">
    <p class="pkg-meta">
      {region} ·{' '}
      <span class="pkg-nowrap">
        {days} days, {nights} nights
      </span>
    </p>
    <Heading class="pkg-name">{href ? <a href={href}>{name}</a> : name}</Heading>
    <p class="pkg-price">
      from <strong>{formatINR(fromPrice)}</strong>
    </p>
    {priceBasis && <p class="pkg-basis">{priceBasis}</p>}
    {validTo && <p class="pkg-valid">Valid to {validTo}</p>}
    {demo && <SampleLabel />}
  </div>
</article>

<style>
  .pkg-card {
    position: relative;
    display: grid;
    align-content: start;
    border-radius: var(--radius-lg);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .pkg-card-link:where(:active, .is-active) {
    transform: scale(var(--press-scale-card));
    transition-duration: var(--duration-instant);
  }

  .pkg-nowrap {
    white-space: nowrap;
  }

  .pkg-photo {
    aspect-ratio: 4 / 5;
  }

  .pkg-photo :global(picture),
  .pkg-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .pkg-body {
    display: grid;
    gap: var(--space-1);
    justify-items: start;
    padding-top: var(--space-4);
  }

  .pkg-meta {
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .pkg-name {
    font-size: var(--text-xl);
    line-height: 1.05;
  }

  .pkg-name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.18em;
  }

  .pkg-name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .pkg-name a:focus-visible {
    outline: none;
  }

  .pkg-card:has(a:focus-visible),
  .pkg-card.is-focus {
    outline: 3px solid var(--ink);
    outline-offset: 6px;
    box-shadow: 0 0 0 9px var(--white);
  }

  .pkg-card-link:where(:hover, .is-hover) .pkg-photo :global(img) {
    transform: scale(var(--hover-scale));
  }

  .pkg-card-link:where(:hover, .is-hover) .pkg-name a {
    text-decoration-thickness: 5px;
  }

  .pkg-price {
    color: var(--text-muted);
  }

  .pkg-price strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .pkg-basis,
  .pkg-valid {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ---------- Phone photo card (Home only: the card has `fold`) ---------- */
  @media (max-width: 767.98px) {
    .pkg-fold {
      align-content: end;
      height: 23.75rem;
      padding: 0.75rem;
      border-radius: var(--radius-lg);
      background: var(--stone-800);
    }

    .pkg-fold .pkg-photo {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      border-radius: var(--radius-lg);
    }

    /* A grid item with z-index paints above the photo and leaves the card as the link's box. */
    .pkg-fold .pkg-body {
      z-index: 1;
      gap: 0.375rem;
      padding: 1rem;
      border-radius: var(--radius-md);
      background: var(--white);
      color: var(--ink);
    }

    .pkg-fold .pkg-meta {
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: var(--red-700);
    }

    .pkg-fold .pkg-name {
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .pkg-fold .pkg-name a {
      text-decoration: none;
    }

    .pkg-fold .pkg-price {
      margin-top: 0.125rem;
      font-size: 0.875rem;
      color: var(--stone-600);
    }

    .pkg-fold .pkg-price strong {
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .pkg-fold .pkg-basis {
      font-size: 0.8125rem;
      line-height: 1.4;
      color: var(--stone-600);
    }

    .pkg-fold .pkg-valid,
    .pkg-fold :global(.sample-label) {
      display: none;
    }

    /* The scrolling row would clip an outside ring, so the ring sits inside the card edge. */
    .pkg-fold:has(a:focus-visible) {
      outline: none;
      box-shadow: none;
    }

    .pkg-fold:has(a:focus-visible) .pkg-name a::after {
      box-shadow:
        inset 0 0 0 3px var(--ink),
        inset 0 0 0 6px var(--white);
    }
  }
</style>
