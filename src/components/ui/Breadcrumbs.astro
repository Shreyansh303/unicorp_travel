---
/** Breadcrumb trail: a labelled nav with an ordered list; the last crumb is the current page. */
import Icon from './Icon.astro';
import type { Crumb } from './types';

interface Props {
  items: Crumb[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav class:list={['crumbs', className]} aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li>
          {index > 0 && <Icon name="chevron-right" size={16} class="crumb-sep" />}
          {isLast || !item.href ? (
            <span aria-current={isLast ? 'page' : undefined}>{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .crumbs :global(.crumb-sep) {
    color: var(--accent-text);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.2em;
  }

  .crumbs a:hover {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .crumbs [aria-current='page'] {
    color: var(--text);
    font-weight: var(--weight-bold);
  }
</style>
