---
/**
 * Staff contacts grouped by desk (names, tel: and mailto: links), from `site.contactDesks`.
 * Stacks on phones and goes to a grid on wider screens. Renders nothing when there are no desks.
 */
import { mailtoHref, telHref, type ContactDesk } from '../../config/site';

interface Props {
  desks: ContactDesk[];
  /** Heading level for each desk title. */
  headingLevel?: 3 | 4;
  class?: string;
}

const { desks, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

{desks.length > 0 && (
  <div class:list={['desks', className]}>
    {desks.map((desk) => (
      <section class="desk" aria-labelledby={`desk-${desk.id}`} data-desk={desk.id}>
        <Heading id={`desk-${desk.id}`} class="desk-title">
          {desk.name}
        </Heading>
        <ul class="desk-people">
          {desk.people.map((person) => (
            <li class="person">
              <span class="person-name">{person.name}</span>
              <a class="person-link" href={telHref(person.phone)}>
                {person.phone.display}
              </a>
              <a class="person-link person-mail" href={mailtoHref(person.email)}>
                {person.email}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}

<style>
  .desks {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .desks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .desks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .desks:has(> .desk:only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .desk {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--sand-200);
    color: var(--ink);
  }

  .desk-title {
    font-size: var(--text-lg);
  }

  .desk-people {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .desk:only-child .desk-people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .person {
    display: grid;
    gap: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--stone-300);
  }

  .person-name {
    font-weight: var(--weight-bold);
  }

  .person-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: var(--tap);
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--red-600);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .person-link:hover {
    text-decoration-thickness: 4px;
  }

  @media (max-width: 767.98px) {
    .desk {
      padding: var(--space-5);
    }
  }
</style>
