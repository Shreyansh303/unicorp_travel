---
/**
 * Site header: wordmark, main navigation with keyboard-operable submenus, a call button and,
 * below 1024px, a menu button that opens the navigation in a drawer.
 *
 * Below 768px the header row is just the logo. A fixed "Menu" pill (it shrinks to an icon once the
 * header row has scrolled away) opens a full-screen menu with the main pages and the WhatsApp
 * and call buttons. While that menu is open, <html> carries `data-menu-open`.
 * From 768px the desktop nav (1024px and up) or the drawer (768px to 1023px) is used instead.
 *
 * Submenus: a button with aria-expanded controls a list of links. Enter or Space toggles it,
 * Escape closes it and returns focus to the button, and it closes when focus or a click
 * leaves it. Facts (name, phone) come from site.ts.
 */
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import Button from './Button.astro';
import Dialog from './Dialog.astro';
import Icon from './Icon.astro';
import { hasChildren, type NavItem, type NavLink } from './types';
import { shown, site, telHref, whatsappHref } from '../../config/site';
import { routes } from '../../lib/routes';

interface Props {
  items: NavItem[];
  homeHref: string;
  /** Path of the current page; the matching link gets aria-current="page". */
  currentPath?: string;
  /** Prefix for element ids, so a second header (the styleguide demo) stays unique. */
  idPrefix?: string;
  /** Accessible name of the navigation landmark. */
  navLabel?: string;
  /** Render as a plain <div> (styleguide demos, so the page keeps one banner landmark). */
  asDemo?: boolean;
  /** Styleguide only: render the first submenu open. */
  openFirst?: boolean;
  /** WhatsApp message for the drawer's WhatsApp button. */
  whatsappMessage?: string;
  /** Phones only: the logo row sits over the photo at the top of the page (Home). */
  overlay?: boolean;
}

const {
  items,
  homeHref,
  currentPath,
  idPrefix = 'site',
  navLabel = 'Main',
  asDemo = false,
  openFirst = false,
  whatsappMessage,
  overlay = false,
} = Astro.props;

const mobile = shown(site.phones.mobile);
const drawerId = `${idPrefix}-nav-drawer`;
const menuId = `${idPrefix}-nav-menu`;
const Tag = asDemo ? 'div' : 'header';
const current = (href: string) => (currentPath === href ? 'page' : undefined);
const firstSubmenuIndex = items.findIndex(hasChildren);
const links = items.flatMap((item) => (hasChildren(item) ? item.children : [item]));
const waHref = mobile
  ? whatsappHref(whatsappMessage ?? `Hello ${site.displayName}, I would like help planning a trip.`)
  : null;

// Phone menu: the main pages as big rows (Services opens its overview page, not the 11 service
// links), then About, Contact and FAQs as a smaller group.
const bigHrefs: string[] = [routes.holidays, routes.corporate, routes.planMyTrip];
const smallHrefs: string[] = [routes.about, routes.contact];
const menuPrimary: NavLink[] = items.flatMap((item): NavLink[] =>
  hasChildren(item)
    ? [{ label: item.label, href: routes.services }]
    : bigHrefs.includes(item.href)
      ? [item]
      : [],
);
const menuSecondary: NavLink[] = [
  ...items.flatMap((item): NavLink[] =>
    !hasChildren(item) && smallHrefs.includes(item.href) ? [item] : [],
  ),
  { label: 'FAQs', href: routes.faqs },
];
---

<Tag class:list={['site-header', 'tone-paper', overlay && 'is-overlay']}>
  <div class="wrap header-row">
    <a class="wordmark" href={homeHref}>
      <Image
        class="wordmark-logo"
        src={logo}
        alt={site.displayName}
        height={40}
        densities={[1, 2]}
        loading="eager"
      />
    </a>

    <nav class="nav-desktop" aria-label={navLabel}>
      <ul class="nav-list">
        {items.map((item, index) =>
          hasChildren(item) ? (
            <li class="nav-item" data-submenu>
              <button
                type="button"
                class="nav-link nav-trigger"
                aria-expanded={openFirst && index === firstSubmenuIndex ? 'true' : 'false'}
                aria-controls={`${idPrefix}-submenu-${index}`}
                data-submenu-trigger
              >
                {item.label}
                <Icon name="chevron-down" size={18} class="nav-chevron" />
              </button>
              <ul
                id={`${idPrefix}-submenu-${index}`}
                class="submenu"
                hidden={!(openFirst && index === firstSubmenuIndex)}
              >
                {item.children.map((child) => (
                  <li>
                    <a class="submenu-link" href={child.href} aria-current={current(child.href)}>
                      <span class="submenu-label">{child.label}</span>
                      {child.description && <span class="submenu-desc">{child.description}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="nav-item">
              <a class="nav-link" href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="header-actions">
      {mobile && (
        <Button variant="secondary" size="sm" href={telHref(mobile)} iconStart="phone">
          <span class="call-text">Call</span>
          <span class="call-number">&nbsp;{mobile.display}</span>
        </Button>
      )}
      <button
        type="button"
        class="menu-btn"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-dialog-open={drawerId}
      >
        <Icon name="menu" size={22} />
        <span>Menu</span>
      </button>
    </div>
  </div>

  {/* Without JavaScript the submenu and drawer cannot open, so every link is listed plainly. */}
  <noscript>
    <nav class="nav-noscript" aria-label={`${navLabel} (all links)`}>
      <ul class="wrap">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <style is:inline>
      .menu-btn,
      .menu-pill,
      .nav-desktop {
        display: none !important;
      }
    </style>
  </noscript>

  <Dialog id={drawerId} title="Menu" variant="drawer">
    <nav aria-label={`${navLabel} (menu)`}>
      <ul class="drawer-list">
        {items.map((item) =>
          hasChildren(item) ? (
            <li>
              <p class="drawer-group">{item.label}</p>
              <ul>
                {item.children.map((child) => (
                  <li>
                    <a class="drawer-link" href={child.href} aria-current={current(child.href)}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a class="drawer-link" href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
    <div class="drawer-actions">
      {waHref && (
        <Button href={waHref} iconStart="whatsapp" external>
          Chat on WhatsApp
        </Button>
      )}
      {mobile && (
        <Button variant="secondary" href={telHref(mobile)} iconStart="phone">
          Call {mobile.display}
        </Button>
      )}
    </div>
  </Dialog>

  {!asDemo && (
    <Dialog id={menuId} title="Menu" variant="fullscreen">
      <Fragment slot="head">
        <a class="menu-logo" href={homeHref} data-dialog-close>
          <Image
            class="wordmark-logo"
            src={logo}
            alt={site.displayName}
            height={40}
            densities={[1, 2]}
          />
        </a>
        <button type="button" class="menu-close" data-dialog-close>
          <Icon name="close" size={20} />
          Close
        </button>
      </Fragment>
      <nav class="menu-nav" aria-label={`${navLabel} (menu)`}>
        <ul class="menu-primary">
          {menuPrimary.map((link) => (
            <li>
              <a
                class="menu-link"
                href={link.href}
                aria-current={current(link.href)}
                data-dialog-close
              >
                {link.label}
                <Icon name="arrow-right" size={24} />
              </a>
            </li>
          ))}
        </ul>
        <ul class="menu-secondary">
          {menuSecondary.map((link) => (
            <li>
              <a
                class="menu-small"
                href={link.href}
                aria-current={current(link.href)}
                data-dialog-close
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="menu-actions">
        {waHref && (
          <Button href={waHref} iconStart="whatsapp" external>
            Chat on WhatsApp
          </Button>
        )}
        {mobile && (
          <Button variant="secondary" href={telHref(mobile)} iconStart="phone">
            Call {mobile.display}
          </Button>
        )}
      </div>
    </Dialog>
  )}
</Tag>

{!asDemo && (
  <button
    type="button"
    class="menu-pill"
    aria-haspopup="dialog"
    aria-expanded="false"
    data-dialog-open={menuId}
    data-menu-pill
    data-state="expanded"
  >
    <Icon name="menu" size={20} />
    <span class="menu-pill-label">Menu</span>
  </button>
)}

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    background: var(--bg);
    color: var(--text);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
    padding-block: var(--space-2);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-height: var(--tap);
    padding-block: 0;
  }

  /* The client's logo (dark text on transparent), so the header stays on a light surface. */
  .wordmark-logo {
    display: block;
    width: auto;
    height: 3.25rem;
  }

  .nav-desktop {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: var(--weight-bold);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-trigger[aria-expanded='true'] {
    background: var(--surface-sunken);
  }

  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.35em;
  }

  .nav-link :global(.nav-chevron) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-trigger[aria-expanded='true'] :global(.nav-chevron) {
    transform: rotate(var(--turn));
  }

  .submenu {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: var(--z-raised);
    display: grid;
    gap: var(--space-1);
    width: max-content;
    min-width: 16rem;
    max-width: 22rem;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow:
      var(--shadow-lg),
      0 0 0 1px var(--sand-200);
  }

  .submenu:not([hidden]) {
    animation: submenu-in var(--duration-base) var(--ease-out);
  }

  @keyframes submenu-in {
    from {
      opacity: 0;
      transform: translateY(calc(var(--reveal-distance) * -0.4));
    }
  }

  .submenu-link {
    display: grid;
    gap: 0.125rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
  }

  .submenu-link:hover {
    background: var(--red-50);
  }

  .submenu-label {
    font-weight: var(--weight-bold);
  }

  .submenu-link:hover .submenu-label,
  .submenu-link[aria-current='page'] .submenu-label {
    text-decoration: underline;
    text-decoration-color: var(--red-600);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .submenu-desc {
    font-size: var(--text-sm);
    color: var(--stone-600);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .call-number {
    display: none;
  }

  /* Below 420px the call button shows only its icon; "Call" is still its accessible name. */
  @media (max-width: 419px) {
    .call-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .header-actions :global(.btn) {
      padding-inline: var(--space-3);
    }
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-black);
    cursor: pointer;
  }

  .menu-btn:hover {
    background: var(--stone-800);
  }

  @media (min-width: 640px) {
    .call-number {
      display: inline;
    }
  }

  .header-actions :global(.btn) {
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: block;
      margin-inline: auto var(--space-4);
    }

    .menu-btn {
      display: none;
    }
  }

  /*
   * 1024px to 1279px: the six links and the call button share one row, so the links tighten
   * and the call button drops the number (the number is in the footer and on every page's
   * enquiry band). The header stays one line at every desktop width.
   */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav-desktop {
      margin-inline: auto var(--space-2);
    }

    .nav-list {
      gap: 0;
    }

    .nav-link {
      padding-inline: var(--space-3);
      font-size: var(--text-sm);
    }

    .call-number {
      display: none;
    }
  }

  /* ---------- Phones (below 768px): logo row, sticky Menu pill, full-screen menu ---------- */
  .menu-pill {
    display: none;
  }

  @media (max-width: 767.98px) {
    /* The bottom bar and the menu carry Call; the row is just the logo. */
    .header-actions {
      display: none;
    }

    /* Over a photo (Home): the 64px row floats on the photo, the logo on a cream chip. It still
       scrolls away with the page, so the Menu pill collapses as before. */
    .site-header.is-overlay {
      position: absolute;
      inset: 0 0 auto;
      background: transparent;
    }

    .is-overlay .header-row {
      min-height: 4rem;
      padding: 0 1.25rem;
    }

    .is-overlay .wordmark {
      padding-inline: 0.375rem;
      border-radius: 0.5rem;
      background: var(--paper);
    }

    .menu-pill {
      position: fixed;
      top: calc(10px + env(safe-area-inset-top, 0px));
      right: 20px;
      z-index: var(--z-overlay);
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 2.75rem;
      min-width: 2.75rem;
      padding: 0 18px 0 14px;
      border: 1.5px solid var(--ink);
      border-radius: 22px;
      background: var(--white);
      color: var(--ink);
      box-shadow: 0 2px 10px rgb(20 17 16 / 0.18);
      font-family: var(--font-text);
      font-size: 15px;
      font-weight: var(--weight-bold);
      line-height: 1;
      cursor: pointer;
      transform-origin: right center;
      view-transition-name: menu-pill;
    }

    /* Scrolled past the header row: icon only, same spot. The label stays as the accessible name. */
    .menu-pill[data-state='collapsed'] {
      width: 2.75rem;
      padding: 0;
      gap: 0;
    }

    .menu-pill[data-state='collapsed'] .menu-pill-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Only transform and opacity move; the box itself changes size at once. */
    .menu-pill[data-animate][data-state='collapsed'] {
      animation: menu-pill-a var(--duration-fast) var(--ease-out);
    }

    .menu-pill[data-animate][data-state='expanded'] {
      animation: menu-pill-b var(--duration-fast) var(--ease-out);
    }

    .menu-pill:focus-visible {
      outline: 3px solid var(--ink);
      outline-offset: 3px;
      box-shadow: 0 0 0 6px var(--white);
    }
  }

  @keyframes menu-pill-a {
    from {
      opacity: 0.4;
      transform: scale(0.88);
    }
  }

  @keyframes menu-pill-b {
    from {
      opacity: 0.4;
      transform: scale(0.88);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-pill {
      animation: none !important;
    }
  }

  /* Menu overlay: the head row (logo and Close) is slotted into the dialog's own head. */
  .menu-logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .menu-close {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 2.75rem;
    padding: 0 18px 0 14px;
    border: 1.5px solid var(--ink);
    border-radius: 22px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-text);
    font-size: 15px;
    font-weight: var(--weight-bold);
    cursor: pointer;
  }

  .menu-close:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .menu-close:focus-visible,
  .menu-link:focus-visible,
  .menu-small:focus-visible,
  .menu-logo:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  /* The middle scrolls on a short screen; the two buttons below it stay pinned. */
  .menu-nav {
    flex: 1;
    min-height: 0;
    padding: var(--space-4) 1.25rem 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    min-height: 4rem;
    border-bottom: 1px solid var(--sand-200);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: var(--weight-black);
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-decoration: none;
  }

  .menu-link[aria-current='page'],
  .menu-small[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .menu-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    padding-block: var(--space-4);
  }

  .menu-small {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .menu-actions {
    display: grid;
    flex: none;
    gap: 0.75rem;
    padding: var(--space-5) 1.25rem calc(2rem + env(safe-area-inset-bottom, 0px));
  }

  .menu-actions :global(.btn) {
    min-height: 3.5rem;
    font-size: 17px;
    white-space: nowrap;
  }

  /* No-JavaScript link list */
  :global(.nav-noscript ul) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding-bottom: var(--space-3);
  }

  :global(.nav-noscript a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    font-weight: var(--weight-bold);
    text-underline-offset: 0.25em;
  }

  /* Drawer contents */
  .drawer-list {
    display: grid;
    gap: var(--space-1);
  }

  .drawer-group {
    margin-top: var(--space-4);
    padding-inline: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .drawer-link {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .drawer-link:hover,
  .drawer-link[aria-current='page'] {
    background: var(--red-50);
  }

  .drawer-actions {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>

<style is:global>
  /* The Menu pill is the same on every page, so it holds still during page transitions. */
  ::view-transition-group(menu-pill) {
    animation: none;
  }
</style>

<script>
  function closeAll(except?: HTMLElement): void {
    document.querySelectorAll<HTMLElement>('[data-submenu]').forEach((item) => {
      if (item !== except) setOpen(item, false);
    });
  }

  function setOpen(item: HTMLElement, open: boolean): void {
    const trigger = item.querySelector<HTMLButtonElement>('[data-submenu-trigger]');
    const menu = item.querySelector<HTMLElement>('.submenu');
    if (!trigger || !menu) return;
    trigger.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  }

  function bind(item: HTMLElement): void {
    if (item.dataset['bound']) return;
    item.dataset['bound'] = 'true';
    const trigger = item.querySelector<HTMLButtonElement>('[data-submenu-trigger]');
    if (!trigger) return;

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      closeAll(item);
      setOpen(item, open);
    });

    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        setOpen(item, false);
        trigger.focus();
      }
    });

    item.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !item.contains(next)) setOpen(item, false);
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target?.closest('[data-submenu]')) closeAll();
  });

  // ---- Phones: the Menu pill and the full-screen menu ----
  let pillObserver: IntersectionObserver | undefined;
  let menuObserver: MutationObserver | undefined;

  /** The pill is a full "Menu" button while the header row is on screen, an icon after that. */
  function initPill(): void {
    pillObserver?.disconnect();
    const pill = document.querySelector<HTMLElement>('[data-menu-pill]');
    const header = document.querySelector<HTMLElement>('header.site-header');
    if (!pill || !header || !('IntersectionObserver' in window)) return;
    let settled = false;
    pillObserver = new IntersectionObserver((entries) => {
      const entry = entries[entries.length - 1];
      if (!entry) return;
      const state = entry.isIntersecting ? 'expanded' : 'collapsed';
      if (pill.dataset['state'] !== state) {
        // No pop on the first reading (a reload part-way down the page).
        if (settled) pill.setAttribute('data-animate', '');
        pill.dataset['state'] = state;
      }
      settled = true;
    });
    pillObserver.observe(header);
  }

  /** Flags <html data-menu-open> while the phone menu is open, so the bottom bar can step aside. */
  function initMenuFlag(): void {
    menuObserver?.disconnect();
    const root = document.documentElement;
    const menu = document.querySelector<HTMLDialogElement>('dialog[id$="-nav-menu"]');
    root.removeAttribute('data-menu-open');
    if (!menu) return;
    const sync = (): void => {
      root.toggleAttribute('data-menu-open', menu.open);
    };
    menuObserver = new MutationObserver(sync);
    menuObserver.observe(menu, { attributes: true, attributeFilter: ['open'] });
    sync();
  }

  // Crossing 768px swaps the phone menu for the drawer or the desktop nav: close whichever is open.
  window.matchMedia('(min-width: 768px)').addEventListener('change', () => {
    document
      .querySelectorAll<HTMLDialogElement>(
        'dialog[id$="-nav-menu"][open], dialog[id$="-nav-drawer"][open]',
      )
      .forEach((dialog) => dialog.close());
  });

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-submenu]').forEach(bind);
    initPill();
    initMenuFlag();
  });
</script>
