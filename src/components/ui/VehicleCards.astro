---
/**
 * The company's own vehicles on a service page (car and coach rentals): per vehicle a main photo
 * and up to two smaller ones, the name and edition, passenger seats, who it suits, its features
 * and a WhatsApp button that names the vehicle. Facts come from the service's `vehicles` entry.
 * One column on phones, two from 900px.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Button from './Button.astro';
import TickList from './TickList.astro';
import { photoSet } from '../../lib/photo';
import { mobile, whatsappFor } from '../../lib/enquiry';

interface Vehicle {
  name: string;
  edition: string;
  passengers: number;
  bestFor: string;
  features: string[];
  photos: { src: ImageMetadata; alt: string }[];
}

interface Props {
  vehicles: Vehicle[];
}

const { vehicles } = Astro.props;
const mainSizes =
  '(min-width: 1280px) 36rem, (min-width: 900px) calc(50vw - 5rem), calc(100vw - 2.5rem)';
const thumbSizes =
  '(min-width: 1280px) 17.5rem, (min-width: 900px) calc(25vw - 3rem), calc(50vw - 1.75rem)';

const cards = await Promise.all(
  vehicles.map(async (vehicle) => {
    const [main, ...rest] = vehicle.photos;
    if (!main) throw new Error(`${vehicle.name} needs a photo`);
    return {
      ...vehicle,
      main: {
        alt: main.alt,
        set: await photoSet(main.src, [
          { aspect: 3 / 2, widths: [400, 600, 800, 1100], sizes: mainSizes },
        ]),
      },
      thumbs: await Promise.all(
        rest.slice(0, 2).map(async (photo) => ({
          alt: photo.alt,
          set: await photoSet(photo.src, [
            { aspect: 3 / 2, widths: [300, 450, 600], sizes: thumbSizes },
          ]),
        })),
      ),
    };
  }),
);
---

<ul class="vehicles">
  {cards.map((vehicle) => (
    <li class="vehicle" data-reveal>
      <div class="vehicle-photos">
        <div class="vehicle-main">
          <Photo set={vehicle.main.set} alt={vehicle.main.alt} />
        </div>
        {vehicle.thumbs.length > 0 && (
          <div class="vehicle-thumbs">
            {vehicle.thumbs.map((thumb) => (
              <div class="vehicle-thumb">
                <Photo set={thumb.set} alt={thumb.alt} />
              </div>
            ))}
          </div>
        )}
      </div>
      <div class="vehicle-body">
        <p class="vehicle-edition">{vehicle.edition}</p>
        <h3 class="vehicle-name t-h3">{vehicle.name}</h3>
        <dl class="vehicle-facts">
          <div>
            <dt>Seats</dt>
            <dd>{vehicle.passengers} passengers</dd>
          </div>
          <div>
            <dt>Best for</dt>
            <dd>{vehicle.bestFor}</dd>
          </div>
        </dl>
        <TickList items={vehicle.features} class="vehicle-features" />
        {mobile && (
          <Button
            href={whatsappFor(`the ${vehicle.name} (${vehicle.passengers} passengers)`)}
            iconStart="whatsapp"
            external
            class="vehicle-ask"
          >
            Ask about the {vehicle.name.replace(/^Toyota |^Force /, '')}
          </Button>
        )}
      </div>
    </li>
  ))}
</ul>

<style>
  .vehicles {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vehicle {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  .vehicle-photos {
    display: grid;
    gap: var(--space-2);
  }

  .vehicle-main,
  .vehicle-thumb {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--stone-800);
    aspect-ratio: 3 / 2;
  }

  .vehicle-thumbs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .vehicle-photos :global(picture),
  .vehicle-photos :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vehicle-body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding-inline: var(--space-1);
  }

  .vehicle-edition {
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .vehicle-facts {
    display: grid;
    gap: var(--space-1);
    margin: 0;
  }

  .vehicle-facts div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }

  .vehicle-facts dt {
    color: var(--text-muted);
  }

  .vehicle-facts dt::after {
    content: ':';
  }

  .vehicle-facts dd {
    margin: 0;
    font-weight: var(--weight-bold);
  }

  .vehicle-body :global(.vehicle-ask) {
    margin-top: var(--space-2);
  }

  @media (max-width: 767.98px) {
    .vehicle-body :global(.vehicle-ask) {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .vehicles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .vehicle {
      padding: var(--space-5);
    }
  }
</style>
