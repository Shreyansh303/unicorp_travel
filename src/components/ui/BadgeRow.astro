---
/**
 * Accreditation and membership badges from the client's company profile (list in site.ts,
 * files in src/assets/badges/). A static row, no motion. Each badge sits in a white rounded chip
 * so the white backgrounds of the supplied images look intentional. Images are lazy, carry
 * width and height (no layout shift) and use the full organisation name as alt text.
 * `footer` is the compact form on the dark footer. Renders nothing while the list is empty.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '../../config/site';

interface Props {
  variant?: 'default' | 'footer';
  title?: string;
  class?: string;
}

const {
  variant = 'default',
  title = 'Memberships and registrations',
  class: className,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/badges/*.{png,jpg}', {
  eager: true,
});

// Shown 48px (phones) or 56px (wider) tall, 36px in the footer. Delivered at 2x of the largest
// size, never above the source's own height (the supplied images are small).
const badges = (
  await Promise.all(
    site.memberships.map(async (membership) => {
      const meta = files[`../../assets/badges/${membership.file}`]?.default;
      if (!meta) return null;
      const image = await getImage({
        src: meta,
        height: Math.min(112, meta.height),
        format: 'webp',
      });
      return {
        name: membership.name,
        src: image.src,
        width: Number(image.attributes['width']),
        height: Number(image.attributes['height']),
      };
    }),
  )
).filter((badge) => badge !== null);
---

{badges.length > 0 && (
  <div class:list={['badges', `badges-${variant}`, className]} data-badge-row>
    <h2 class="badges-title">{title}</h2>
    <ul class="badges-list">
      {badges.map((badge) => (
        <li class="badge-chip">
          <img
            class="badge-img"
            src={badge.src}
            alt={badge.name}
            width={badge.width}
            height={badge.height}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .badges {
    --badge-h: 3rem;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .badges {
      --badge-h: 3.5rem;
    }
  }

  .badges-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    color: var(--text);
  }

  .badges-list {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .badge-chip {
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .badge-img {
    display: block;
    height: var(--badge-h);
    width: auto;
    max-width: 100%;
  }

  /* Footer: compact, on the dark background. */
  .badges-footer {
    --badge-h: 2.25rem;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  .badges-footer .badges-title {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--red-300);
  }

  .badges-footer .badge-chip {
    padding: var(--space-1) var(--space-2);
  }
</style>
