---
/**
 * Toast region: one polite live region per page, bottom of the screen above the floating
 * contact buttons. Show a toast with `showToast()` from `./toast`, or with any button carrying
 * `data-toast="Message"` (and optionally `data-toast-tone="success|info|error"`).
 * Toasts stay for 8 seconds and can be closed at once.
 */
---

<div
  class="toast-region"
  role="status"
  aria-live="polite"
  aria-atomic="false"
  data-toast-region
></div>

<template id="toast-template">
  <div class="toast">
    <span class="toast-icon" aria-hidden="true"></span>
    <p class="toast-text"></p>
    <button type="button" class="toast-close" aria-label="Dismiss message">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>
</template>

<style is:global>
  .toast-region {
    position: fixed;
    left: 50%;
    bottom: calc(var(--floating-bar-height, 0px) + var(--space-4));
    z-index: var(--z-toast);
    display: grid;
    gap: var(--space-2);
    width: min(calc(100% - 2 * var(--gutter)), 26rem);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .toast {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--ink);
    color: var(--white);
    box-shadow: var(--shadow-lg);
    pointer-events: auto;
    animation: toast-in var(--duration-slow) var(--ease-out);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
    }
  }

  .toast-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    font-size: 0.875rem;
    font-weight: var(--weight-black);
    line-height: 1;
  }

  .toast[data-tone='success'] .toast-icon {
    background: var(--success-50);
    color: var(--success-700);
  }

  .toast[data-tone='info'] .toast-icon {
    background: var(--info-50);
    color: var(--info-700);
  }

  .toast[data-tone='error'] .toast-icon {
    background: var(--error-50);
    color: var(--error-700);
  }

  .toast-text {
    flex: 1;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .toast-close {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }

  .toast-close:hover {
    background: var(--stone-800);
  }

  .toast-close:focus-visible {
    outline-color: var(--white);
  }
</style>

<script>
  import { showToast, type ToastTone } from './toast';

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-toast]');
    if (!trigger) return;
    const tone = (trigger.dataset['toastTone'] ?? 'success') as ToastTone;
    showToast(trigger.dataset['toast'] ?? '', tone);
  });
</script>
