---
/**
 * Numbered steps of the enquiry-led process (you tell us, we propose, we arrange). The numbers
 * are decorative: an ordered list already gives the order to assistive tech. From 1024 px, where
 * the steps sit in one row, a route line draws across them on scroll; the steps reveal in turn.
 * `swipe`: on phones the steps become one scroll-snap row of cards, the next card peeking.
 */
import RouteLine from '../motion/RouteLine.astro';
import Stagger from '../motion/Stagger.astro';

interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: readonly Step[];
  headingLevel?: 3 | 4;
  swipe?: boolean;
  class?: string;
}

const { steps, headingLevel = 3, swipe = false, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

<div class:list={['steps-wrap', swipe && 'steps-swipe', className]}>
  <RouteLine
    class="steps-route"
    d="M0 20 C120 2 230 38 350 20 S580 2 700 20 S930 38 1050 20 S1170 8 1200 14"
    viewBox="0 0 1200 40"
    preserveAspectRatio="none"
    draw="scroll"
    strokeWidth={3}
  />
  <Stagger as="ol" class="steps" {...(swipe ? { 'data-swipe': '', 'aria-label': 'Steps' } : {})}>
    {steps.map((step, index) => (
      <li class="step">
        <span class="step-num" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <Heading class="t-h4 step-title">{step.title}</Heading>
        <p class="step-text">{step.text}</p>
      </li>
    ))}
  </Stagger>
</div>

<style>
  .steps-wrap :global(.steps-route) {
    display: none;
  }

  @media (min-width: 1024px) {
    .steps-wrap :global(.steps-route) {
      display: block;
      width: 100%;
      height: 2.5rem;
      margin-bottom: var(--space-4);
    }
  }

  .steps {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(var(--step-cols, 4), minmax(0, 1fr));
    }
  }

  .step {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  :global(.mood-corporate) .step {
    border-radius: var(--radius-sm);
  }

  .step-num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-heading);
    line-height: 1;
    color: var(--accent-display);
  }

  .step-text {
    color: var(--text-muted);
  }

  @media (max-width: 767.98px) {
    .steps-swipe .steps {
      display: flex;
      gap: var(--space-3);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) var(--space-1);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .steps-swipe .steps::-webkit-scrollbar {
      display: none;
    }

    .steps-swipe .steps:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: -3px;
    }

    .steps-swipe .step {
      flex: 0 0 min(17rem, 78vw);
      padding: var(--space-5);
      scroll-snap-align: start;
    }

    /* The cards sit side by side, so none of them waits for a scroll to appear. */
    .steps-swipe .step.reveal-armed {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // A scroll row has to be reachable from the keyboard when it holds nothing focusable.
  const phone = window.matchMedia('(max-width: 767.98px)');

  function sync(): void {
    document.querySelectorAll<HTMLElement>('[data-swipe]').forEach((row) => {
      if (phone.matches) row.setAttribute('tabindex', '0');
      else row.removeAttribute('tabindex');
    });
  }

  document.addEventListener('astro:page-load', sync);
  phone.addEventListener('change', sync);
</script>
