---
/**
 * Numbered steps of the enquiry-led process (you tell us, we propose, we arrange). The numbers
 * are decorative: an ordered list already gives the order to assistive tech.
 */
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: readonly Step[];
  headingLevel?: 3 | 4;
  class?: string;
}

const { steps, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

<ol class:list={['steps', className]}>
  {steps.map((step, index) => (
    <li class="step">
      <span class="step-num" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <Heading class="t-h4 step-title">{step.title}</Heading>
      <p class="step-text">{step.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(var(--step-cols, 4), minmax(0, 1fr));
    }
  }

  .step {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  :global(.mood-corporate) .step {
    border-radius: var(--radius-sm);
  }

  .step-num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-heading);
    line-height: 1;
    color: var(--accent-display);
  }

  .step-text {
    color: var(--text-muted);
  }
</style>
