---
/**
 * Opening section of an inner page: breadcrumbs, the page's only H1, a lede, calls to action
 * (default slot) and an optional photo. On phones the copy and actions come first and the photo
 * follows. The photo is the likely LCP element, so it loads eagerly with high priority and is
 * never animated.
 */
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section, { type Tone } from './Section.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import HeroCrossfade from './HeroCrossfade.astro';
import ReadMore from './ReadMore.astro';
import type { Crumb } from './types';

interface Props {
  title: string;
  /** Second part of the heading, shown in the accent colour. */
  accent?: string;
  eyebrow?: string;
  lede?: string;
  crumbs?: Crumb[];
  image?: { src: ImageMetadata; alt: string };
  /** Two or more photos for a slow crossfade (see HeroCrossfade); shown instead of `image`. */
  photos?: { src: ImageMetadata; alt: string }[];
  mood?: 'holiday' | 'corporate';
  tone?: Tone;
  /** `display` for the big holiday headline, `page` for long or corporate titles. */
  size?: 'display' | 'page';
  /**
   * Phones: the compact page header (cream, no photo, no eyebrow, lede folded to two lines with
   * "Read more"; the page's actions are left to the bottom bar). The photo stays from 768 px up
   * and is not fetched on phones. Only for pages that take a single `image`.
   */
  compact?: boolean;
}

const {
  title,
  accent,
  eyebrow,
  lede,
  crumbs = [],
  image,
  photos,
  mood = 'holiday',
  tone,
  size = 'page',
  compact = false,
} = Astro.props;

// Compact: the photo's sources match only from 768 px up and the phone fallback is an empty
// pixel, so a phone has no reason to fetch a photo that is hidden there.
const photoSizes = '(min-width: 1366px) 520px, (min-width: 1024px) 38vw, calc(100vw - 2rem)';
const photoWidths = [400, 640, 960, 1280];
const compactPhoto =
  compact && image && !(photos && photos.length > 1)
    ? {
        sources: await Promise.all(
          (['avif', 'webp'] as const).map(async (format) => {
            const result = await getImage({ src: image.src, format, widths: photoWidths });
            return { type: `image/${format}`, srcset: result.srcSet.attribute };
          }),
        ),
        fallback: await getImage({ src: image.src, widths: photoWidths }),
      }
    : null;
const emptyPixel = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---

<Section
  tone={tone ?? (mood === 'corporate' ? 'white' : 'paper')}
  mood={mood}
  spacing="none"
  aria-labelledby="page-title"
  class:list={['page-hero', compact && 'ph-compact']}
>
  <div class:list={['ph-grid', (image || photos) && 'ph-with-image']}>
    <div class="ph-copy">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="t-eyebrow">{eyebrow}</p>}
      <h1 id="page-title" class:list={[size === 'display' ? 't-display' : 'ph-title']}>
        {title}
        {accent && ' '}
        {accent && <span class="t-accent">{accent}</span>}
      </h1>
      {lede && compact && (
        <ReadMore id="page-lede" lines={2} class="t-lede hero-enter">
          {lede}
        </ReadMore>
      )}
      {lede && !compact && <p class="t-lede hero-enter">{lede}</p>}
      <slot />
    </div>
    {photos && photos.length > 1 ? (
      <HeroCrossfade photos={photos} />
    ) : compactPhoto && image ? (
      <figure
        class:list={[
          'ph-photo',
          'ph-photo-desktop',
          mood === 'corporate' ? 'ph-photo-square' : 'arch',
        ]}
      >
        <picture>
          <source media="(max-width: 767.98px)" srcset={emptyPixel} />
          {compactPhoto.sources.map((source) => (
            <source type={source.type} srcset={source.srcset} sizes={photoSizes} />
          ))}
          <img
            src={compactPhoto.fallback.src}
            srcset={compactPhoto.fallback.srcSet.attribute}
            sizes={photoSizes}
            alt={image.alt}
            width={compactPhoto.fallback.attributes['width']}
            height={compactPhoto.fallback.attributes['height']}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>
    ) : (
      image && (
        <figure class:list={['ph-photo', mood === 'corporate' ? 'ph-photo-square' : 'arch']}>
          <Picture
            src={image.src}
            alt={image.alt}
            formats={['avif', 'webp']}
            widths={photoWidths}
            sizes={photoSizes}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    )}
  </div>
</Section>

<style>
  .ph-grid {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-16);
  }

  .ph-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: center;
    min-width: 0;
  }

  .ph-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  /* Hero entrance (global.css): the lede rises, then whatever the page puts in the slot. */
  @media (prefers-reduced-motion: no-preference) {
    .ph-copy > :global(:not(h1, nav, .t-eyebrow, .t-lede)) {
      animation: hero-rise var(--duration-reveal) var(--ease-out) calc(2 * var(--stagger)) both;
    }
  }

  .ph-photo {
    aspect-ratio: 4 / 3;
  }

  .ph-photo.arch {
    aspect-ratio: 4 / 5;
    max-height: 34rem;
    width: min(100%, 27rem);
    justify-self: center;
  }

  .ph-photo-square {
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .ph-photo :global(picture),
  .ph-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Compact page header on phones: cream, one column, no photo, 220 to 300px tall. */
  @media (max-width: 767.98px) {
    :global(.page-hero.ph-compact) {
      --bg: var(--paper);
      --route-halo: var(--paper);
    }

    .ph-compact .ph-grid {
      gap: 0;
      min-height: 13.75rem;
      padding-block: var(--space-6) var(--space-4);
    }

    .ph-compact .ph-copy {
      gap: var(--space-2);
    }

    /* The crumbs already name the page; the actions are in the sticky bottom bar. */
    .ph-compact .t-eyebrow {
      display: none;
    }

    .ph-compact .ph-title {
      font-size: 2.5rem;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .ph-compact .ph-copy :global(.t-lede) {
      font-size: 1.0625rem;
      line-height: 1.5;
    }

    .ph-compact .ph-photo-desktop {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .ph-grid {
      padding-block: var(--space-12) var(--space-24);
    }

    .ph-with-image {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-16);
      align-items: center;
    }

    .ph-photo.arch {
      width: 100%;
      max-height: none;
    }
  }
</style>
