---
/**
 * Opening section of an inner page: breadcrumbs, the page's only H1, a lede, calls to action
 * (default slot) and an optional photo. On phones the copy and actions come first and the photo
 * follows. The photo is the likely LCP element, so it loads eagerly with high priority and is
 * never animated.
 */
import type { ImageMetadata } from 'astro';
import Section, { type Tone } from './Section.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import HeroCrossfade from './HeroCrossfade.astro';
import Photo from './Photo.astro';
import ReadMore from './ReadMore.astro';
import type { Crumb } from './types';
import { photoSet } from '../../lib/photo';

interface Props {
  title: string;
  /** Second part of the heading, shown in the accent colour. */
  accent?: string;
  eyebrow?: string;
  lede?: string;
  crumbs?: Crumb[];
  image?: { src: ImageMetadata; alt: string };
  /** Two or more photos for a slow crossfade (see HeroCrossfade); shown instead of `image`. */
  photos?: { src: ImageMetadata; alt: string }[];
  mood?: 'holiday' | 'corporate';
  tone?: Tone;
  /** `display` for the big holiday headline, `page` for long or corporate titles. */
  size?: 'display' | 'page';
  /**
   * Phones: the compact page header (cream, no photo, no eyebrow, lede folded to two lines with
   * "Read more"; the page's actions are left to the bottom bar). The photo stays from 768 px up
   * and is not fetched on phones. Only for pages that take a single `image`.
   */
  compact?: boolean;
  /**
   * Phones, with `photos`: a short full-bleed crossfading photo, then a cream sheet over its
   * lower edge holding the H1, a lede folded to two lines and the page's primary action (slot).
   * From 768 px nothing changes.
   */
  sheet?: boolean;
}

const {
  title,
  accent,
  eyebrow,
  lede,
  crumbs = [],
  image,
  photos,
  mood = 'holiday',
  tone,
  size = 'page',
  compact = false,
  sheet = false,
} = Astro.props;

// The single photo, cropped to its frame: 4:3 (corporate) or the 4:5 arch. Its column is about
// 516px wide from 1280px, and the full content width on tablets.
const square = mood === 'corporate';
const photo =
  image && !(photos && photos.length > 1)
    ? await photoSet(image.src, [
        square
          ? {
              aspect: 4 / 3,
              widths: [480, 640, 800, 1040, 1380],
              sizes:
                '(min-width: 1280px) 516px, (min-width: 1024px) calc(45.5vw - 4rem), calc(100vw - 5rem)',
            }
          : {
              aspect: 4 / 5,
              widths: [400, 560, 720, 880, 1040, 1280],
              sizes:
                '(min-width: 1280px) 516px, (min-width: 1024px) calc(45.5vw - 4rem), min(calc(100vw - 2.5rem), 27rem)',
            },
      ])
    : null;
---

<Section
  tone={tone ?? (mood === 'corporate' ? 'white' : 'paper')}
  mood={mood}
  spacing="none"
  aria-labelledby="page-title"
  class:list={['page-hero', compact && 'ph-compact', sheet && 'ph-sheet']}
>
  <div class:list={['ph-grid', (image || photos) && 'ph-with-image']}>
    <div class="ph-copy">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="t-eyebrow">{eyebrow}</p>}
      <h1 id="page-title" class:list={[size === 'display' ? 't-display' : 'ph-title']}>
        {title}
        {accent && ' '}
        {accent && <span class="t-accent">{accent}</span>}
      </h1>
      {lede && (compact || sheet) && (
        <ReadMore id="page-lede" lines={2} class="t-lede hero-enter">
          {lede}
        </ReadMore>
      )}
      {lede && !compact && !sheet && <p class="t-lede hero-enter">{lede}</p>}
      <slot />
    </div>
    {photos && photos.length > 1 ? (
      <HeroCrossfade photos={photos} sheet={sheet} />
    ) : (
      photo &&
      image && (
        <figure
          class:list={[
            'ph-photo',
            compact && 'ph-photo-desktop',
            square ? 'ph-photo-square' : 'arch',
          ]}
        >
          {/* Compact: phones match an empty pixel, so they never fetch the hidden photo. */}
          <Photo
            set={photo}
            alt={image.alt}
            loading="eager"
            fetchpriority="high"
            phoneHidden={compact}
          />
        </figure>
      )
    )}
  </div>
</Section>

<style>
  .ph-grid {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-16);
  }

  .ph-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: center;
    min-width: 0;
  }

  .ph-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  /* Hero entrance (global.css): the lede rises, then whatever the page puts in the slot. */
  @media (prefers-reduced-motion: no-preference) {
    .ph-copy > :global(:not(h1, nav, .t-eyebrow, .t-lede)) {
      animation: hero-rise var(--duration-reveal) var(--ease-out) calc(2 * var(--stagger)) both;
    }
  }

  .ph-photo {
    aspect-ratio: 4 / 3;
  }

  .ph-photo.arch {
    aspect-ratio: 4 / 5;
    max-height: 34rem;
    width: min(100%, 27rem);
    justify-self: center;
  }

  .ph-photo-square {
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .ph-photo :global(picture),
  .ph-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Compact page header on phones: cream, one column, no photo, 220 to 300px tall. */
  @media (max-width: 767.98px) {
    :global(.page-hero.ph-compact) {
      --bg: var(--paper);
      --route-halo: var(--paper);
    }

    .ph-compact .ph-grid {
      gap: 0;
      min-height: 13.75rem;
      padding-block: var(--space-6) var(--space-4);
    }

    .ph-compact .ph-copy {
      gap: var(--space-2);
    }

    /* The crumbs already name the page; the actions are in the sticky bottom bar. */
    .ph-compact .t-eyebrow {
      display: none;
    }

    .ph-compact .ph-title {
      font-size: 2.5rem;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    /* Title to intro: 14px (the row gap is 8px). */
    .ph-compact .ph-copy > :global(.rm) {
      margin-top: 0.375rem;
    }

    .ph-compact .ph-copy :global(.t-lede) {
      font-size: 1.0625rem;
      line-height: 1.5;
    }

    .ph-compact .ph-photo-desktop {
      display: none;
    }
  }

  /* Photo header on phones: full-bleed crossfade, then the cream sheet with the heading and action. */
  @media (max-width: 767.98px) {
    .ph-sheet .ph-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-block: 0;
      margin-inline: calc(-1 * var(--gutter));
    }

    .ph-sheet .ph-copy {
      position: relative;
      z-index: var(--z-raised);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      margin-top: -2rem;
      padding: 2rem 1.25rem var(--space-6);
      border-radius: 2rem 2rem 0 0;
      background: var(--bg);
    }

    .ph-sheet .t-eyebrow {
      display: none;
    }

    .ph-sheet .ph-title {
      font-size: 2.5rem;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .ph-sheet .ph-copy :global(.t-lede) {
      font-size: 1.0625rem;
      line-height: 1.5;
    }

    /* The breadcrumb is a 44px row at the top of the sheet, above the title. */
    .ph-sheet .ph-copy > :global(nav) {
      order: -1;
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      margin-top: -0.5rem;
    }

    /* Title to intro: 14px (the row gap is 12px). */
    .ph-sheet .ph-copy > :global(.rm) {
      margin-top: 0.125rem;
    }
  }

  @media (min-width: 1024px) {
    .ph-grid {
      padding-block: var(--space-12) var(--space-24);
    }

    .ph-with-image {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-16);
      align-items: center;
    }

    .ph-photo.arch {
      width: 100%;
      max-height: none;
    }
  }
</style>
