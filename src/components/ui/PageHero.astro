---
/**
 * Opening section of an inner page: breadcrumbs, the page's only H1, a lede, calls to action
 * (default slot) and an optional photo. On phones the copy and actions come first and the photo
 * follows. The photo is the likely LCP element, so it loads eagerly with high priority and is
 * never animated.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section, { type Tone } from './Section.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from './types';

interface Props {
  title: string;
  /** Second part of the heading, shown in the accent colour. */
  accent?: string;
  eyebrow?: string;
  lede?: string;
  crumbs?: Crumb[];
  image?: { src: ImageMetadata; alt: string };
  mood?: 'holiday' | 'corporate';
  tone?: Tone;
  /** `display` for the big holiday headline, `page` for long or corporate titles. */
  size?: 'display' | 'page';
}

const {
  title,
  accent,
  eyebrow,
  lede,
  crumbs = [],
  image,
  mood = 'holiday',
  tone,
  size = 'page',
} = Astro.props;
---

<Section
  tone={tone ?? (mood === 'corporate' ? 'white' : 'paper')}
  mood={mood}
  spacing="none"
  aria-labelledby="page-title"
  class="page-hero"
>
  <div class:list={['ph-grid', image && 'ph-with-image']}>
    <div class="ph-copy">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="t-eyebrow">{eyebrow}</p>}
      <h1 id="page-title" class:list={[size === 'display' ? 't-display' : 'ph-title']}>
        {title}
        {accent && ' '}
        {accent && <span class="t-accent">{accent}</span>}
      </h1>
      {lede && <p class="t-lede">{lede}</p>}
      <slot />
    </div>
    {image && (
      <figure class:list={['ph-photo', mood === 'corporate' ? 'ph-photo-square' : 'arch']}>
        <Picture
          src={image.src}
          alt={image.alt}
          formats={['avif', 'webp']}
          widths={[400, 640, 960, 1280]}
          sizes="(min-width: 1366px) 520px, (min-width: 1024px) 38vw, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}
  </div>
</Section>

<style>
  .ph-grid {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-6) var(--space-16);
  }

  .ph-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: center;
    min-width: 0;
  }

  .ph-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .ph-photo {
    aspect-ratio: 4 / 3;
  }

  .ph-photo.arch {
    aspect-ratio: 4 / 5;
    max-height: 34rem;
    width: min(100%, 27rem);
    justify-self: center;
  }

  .ph-photo-square {
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .ph-photo :global(picture),
  .ph-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .ph-grid {
      padding-block: var(--space-12) var(--space-24);
    }

    .ph-with-image {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-16);
      align-items: center;
    }

    .ph-photo.arch {
      width: 100%;
      max-height: none;
    }
  }
</style>
