---
/**
 * The enquiry band that ends every page (roadmap section 9: every page ends with an enquiry
 * option). WhatsApp with a page-specific message, a call link and a link to Plan my trip or
 * Contact; email and the office address beside them. Every fact comes from site.ts.
 * `data-enquiry` marks it for the page tests.
 */
import Section from './Section.astro';
import Button from './Button.astro';
import Link from './Link.astro';
import Reveal from '../motion/Reveal.astro';
import { shown, site, whatsappHref } from '../../config/site';
import { callHref, emailFor, enquiryMessage, mobile } from '../../lib/enquiry';
import { routes } from '../../lib/routes';

interface Props {
  /** What the visitor is asking about, used in the WhatsApp message and email subject. */
  topic?: string;
  /** The full pre-filled WhatsApp message, when it should not be built from the topic. */
  message?: string;
  title?: string;
  /** Second, accented part of the heading. */
  accent?: string;
  text?: string;
  /** Red for holiday pages, ink for corporate and company pages. */
  mood?: 'holiday' | 'corporate';
  /** The third route: the guided trip request or the contact page. */
  next?: 'plan' | 'contact';
}

const {
  topic,
  message,
  title = 'Where to',
  accent = 'next?',
  text = 'Tell us who is travelling, roughly when, and what you have in mind. We will reply with ideas and a plan to talk through.',
  mood = 'holiday',
  next = 'plan',
} = Astro.props;

const office = shown(site.offices.operating);
const mailHref = emailFor(topic ? `Enquiry: ${topic}` : 'Travel enquiry');
const email = shown(site.email);
const nextLink =
  next === 'plan'
    ? { href: routes.planMyTrip, label: 'Plan my trip step by step' }
    : { href: routes.contact, label: 'All contact details' };
---

<Section
  tone={mood === 'holiday' ? 'red' : 'ink'}
  mood={mood}
  rounded={mood === 'holiday'}
  aria-labelledby="enquiry-title"
  class="enquiry"
  data-enquiry
>
  <Reveal class="enquiry-grid">
    <div class="enquiry-copy">
      <h2 id="enquiry-title" class="t-h2">
        {title} <span class="t-accent">{accent}</span>
      </h2>
      <p class="enquiry-lede">{text}</p>
      <div class="enquiry-actions">
        {mobile && (
          <Button
            href={whatsappHref(message ?? enquiryMessage(topic))}
            iconStart="whatsapp"
            size="lg"
            external
            class="enquiry-wa"
          >
            Chat on WhatsApp
          </Button>
        )}
        {callHref && mobile && (
          <Button
            href={callHref}
            variant="secondary"
            iconStart="phone"
            size="lg"
            class="enquiry-call"
          >
            Call {mobile.display}
          </Button>
        )}
      </div>
      <Link href={nextLink.href} variant="standalone" class="enquiry-next">
        {nextLink.label}
      </Link>
    </div>
    {(mailHref || office) && (
      <dl class="enquiry-card">
        {email && mailHref && (
          <div>
            <dt>Email</dt>
            <dd>
              <a href={mailHref}>{email}</a>
            </dd>
          </div>
        )}
        {office && (
          <div>
            <dt>Visit us</dt>
            <dd>
              <address>
                {office.lines.map((line) => (
                  <span>{line}</span>
                ))}
              </address>
            </dd>
          </div>
        )}
      </dl>
    )}
  </Reveal>
</Section>

<style>
  .enquiry-grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 1024px) {
    .enquiry-grid {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }

  .enquiry-copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .enquiry-lede {
    max-width: 32rem;
    font-size: var(--text-lg);
  }

  .enquiry-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .enquiry :global(.enquiry-next) {
    color: var(--text);
    font-weight: var(--weight-bold);
  }

  .enquiry-card {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface-sunken);
  }

  .mood-corporate .enquiry-card {
    border-radius: var(--radius-sm);
  }

  .enquiry-card dt {
    font-size: var(--text-xs);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* At least 24px tall (WCAG 2.5.8). */
  .enquiry-card a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    color: var(--text);
    font-weight: var(--weight-bold);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .enquiry-card address span {
    display: block;
  }

  /*
   * Phones: the red band is the deeper red (white text 7:1), both actions are full-width 56px
   * pills, the next step is an underlined text link, and the email and address card steps aside
   * because the footer carries both. Corporate (ink) bands keep their tone with the same layout.
   */
  @media (max-width: 767.98px) {
    .enquiry {
      --gutter: 1.25rem;
      --space-section: 3rem;
    }

    .enquiry.mood-holiday {
      --bg: var(--red-700);
    }

    .enquiry-grid {
      gap: 0;
    }

    .enquiry-card {
      display: none;
    }

    .enquiry-copy {
      gap: 1rem;
      justify-items: stretch;
    }

    .enquiry-copy h2 {
      font-size: 2.5rem;
      line-height: 0.98;
      letter-spacing: -0.045em;
    }

    /* The accent word is ink on the desktop red; on the deeper red it would be too dim. */
    .enquiry-copy h2 :global(.t-accent) {
      color: var(--white);
    }

    .enquiry-lede {
      font-size: 1.0625rem;
      line-height: 1.55;
    }

    .enquiry-actions {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }

    .enquiry-actions :global(.btn) {
      width: 100%;
      min-height: 3.5rem;
      padding-block: 0;
      font-size: 1.0625rem;
    }

    .enquiry.mood-holiday .enquiry-actions :global(.enquiry-wa) {
      color: var(--red-700);
    }

    .enquiry :global(.enquiry-next) {
      align-self: flex-start;
      min-height: 3rem;
      font-size: 1rem;
      text-decoration-color: currentcolor;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .enquiry :global(.enquiry-next .link-arrow) {
      color: currentcolor;
    }
  }
</style>
