---
/**
 * The photo of an inner-page hero as a slow crossfade between a few photos, in the arch shape with
 * the route line. Only the first photo is in the HTML (eager, high priority: it is the LCP image).
 * The others are described in `data-slides` and inserted by the script after the page has loaded.
 *
 * Opacity only, about 5 s per photo. No pause button (user decision, 2026-10-19); the fade pauses
 * while the tab is hidden and while keyboard focus is inside the hero. Under reduced motion, and
 * without JavaScript, the first photo simply stays.
 *
 * The `home` variant is the Home hero: the same crossfade in that page's own frame (arch beside the
 * headline from 768px, full-bleed photo on phones) with a destination chip per photo. The chip
 * fades with its photo (opacity only). It is visual only: each photo's alt names the place for
 * assistive technology, and only the visible photo and chip are exposed to it.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RouteLine from '../motion/RouteLine.astro';

interface Props {
  /** At least two photos; the first is shown at once. `caption` is the destination chip (home). */
  photos: { src: ImageMetadata; alt: string; caption?: string }[];
  /** `home` is the Home hero; the default is the inner-page hero. */
  variant?: 'page' | 'home';
  /** The `sizes` of every photo; the default suits the inner-page frame. */
  sizes?: string;
  /** Phones: a short full-bleed photo under a cream sheet (the page header puts the sheet on top). */
  sheet?: boolean;
}

const {
  photos,
  variant = 'page',
  sizes = '(min-width: 1366px) 520px, (min-width: 1024px) 38vw, min(82vw, 26rem)',
  sheet = false,
} = Astro.props;
const home = variant === 'home';
const [first, ...others] = photos;
if (!first) throw new Error('HeroCrossfade needs photos');
if (photos.some((photo) => Boolean(photo.caption) !== Boolean(first.caption))) {
  throw new Error('HeroCrossfade: give every photo a caption, or none');
}

const widths = [400, 640, 800, 960, 1280];

const slides = await Promise.all(
  others.map(async (photo) => {
    const sources = await Promise.all(
      (['avif', 'webp'] as const).map(async (format) => {
        const image = await getImage({ src: photo.src, format, widths, sizes });
        return { type: `image/${format}`, srcset: image.srcSet.attribute };
      }),
    );
    const fallback = await getImage({ src: photo.src, format: 'webp', width: 960 });
    return { alt: photo.alt, caption: photo.caption, sources, src: fallback.src };
  }),
);

/** Same route as the home hero, climbing the arch to a marker at the top right. */
const route =
  'M0 470 C80 560 200 560 250 500 C300 440 230 390 200 430 C170 470 260 540 360 500 C440 470 470 380 480 300 C488 230 470 160 440 110';
---

<div
  class:list={['hf', home && 'hf-home hero-art', sheet && 'hf-sheet']}
  data-hero-fade
  data-slides={JSON.stringify(slides)}
  data-sizes={sizes}
>
  <figure class:list={['hf-frame arch', home && 'hero-arch']}>
    <div class="hf-slide is-active" data-slide>
      <Picture
        src={first.src}
        alt={first.alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </figure>
  {first.caption && (
    <div class="hf-chips hero-pop" style="--enter-delay: var(--delay-late)" data-chips>
      <p class="hf-chip hero-chip is-active" data-chip>
        {first.caption}
      </p>
    </div>
  )}
  <RouteLine
    class={home ? 'hf-route hero-route' : 'hf-route'}
    d={route}
    viewBox="0 0 496 580"
    halo
    markers={[{ cx: 440, cy: 110, r: 11, shape: 'pin' }]}
  />
</div>

<style>
  .hf {
    position: relative;
    width: min(82%, 26rem);
    margin-inline: auto;
    aspect-ratio: 400 / 500;
  }

  .hf-frame {
    height: 100%;
    margin: 0;
    position: relative;
    /* Keeps the slides' stacking inside the frame, so the route line draws over the photo. */
    isolation: isolate;
    background: var(--sand);
  }

  .hf :global(.hf-slide) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-photo-fade) var(--ease-in-out);
  }

  .hf :global(.hf-slide.is-active) {
    opacity: 1;
    z-index: 2;
  }

  /* The photo being replaced stays fully visible underneath until the new one has faded in. */
  .hf :global(.hf-slide.is-prev) {
    opacity: 1;
    z-index: 1;
    transition: none;
  }

  .hf :global(.hf-slide picture),
  .hf :global(.hf-slide img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hf :global(.hf-route) {
    position: absolute;
    top: -8%;
    left: -12%;
    width: 124%;
    height: 116%;
    pointer-events: none;
  }

  /* Destination chips (home): stacked in one grid cell, so the chip for the visible photo is the
     only one showing and the box never changes size. */
  .hf-chips {
    position: absolute;
    left: -0.75rem;
    top: 44%;
    z-index: 1;
    display: grid;
    justify-items: start;
    pointer-events: none;
  }

  .hf :global(.hf-chip) {
    grid-area: 1 / 1;
    margin: 0;
    rotate: -4deg;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    white-space: nowrap;
    opacity: 0;
    transition: opacity var(--duration-photo-fade) var(--ease-in-out);
  }

  .hf :global(.hf-chip.is-active) {
    opacity: 1;
  }

  /* Home: the frame beside the headline, and a full-bleed photo on phones. */
  .hf-home {
    width: 82%;
    max-width: 26rem;
  }

  @media (max-width: 767.98px) {
    .hf-home {
      order: -1;
      width: 100%;
      max-width: none;
      height: 23.75rem;
      margin: 0;
      aspect-ratio: auto;
    }

    .hf-home .hf-frame {
      border-radius: 0;
    }

    .hf-home :global(.hf-slide img) {
      object-position: 55% 50%;
    }

    .hf-home :global(.hf-route) {
      display: none;
    }

    .hf-chips {
      left: 1.25rem;
      top: auto;
      bottom: 3rem;
    }

    .hf :global(.hf-chip) {
      rotate: 0deg;
    }
  }

  /* Short phones (e.g. 375x667): a shorter photo keeps "Plan my trip" above the bottom bar. */
  @media (max-width: 767.98px) and (max-height: 700px) {
    .hf-home {
      height: 13.5rem;
    }
  }

  /* Inner pages with a sheet: a 260px full-bleed photo on phones, the sheet overlaps it. */
  @media (max-width: 767.98px) {
    .hf-sheet {
      order: -1;
      width: 100%;
      height: 16.25rem;
      margin: 0;
      aspect-ratio: auto;
    }

    .hf-sheet .hf-frame {
      border-radius: 0;
    }

    .hf-sheet :global(.hf-route) {
      display: none;
    }
  }

  @media (max-width: 767.98px) and (max-height: 700px) {
    .hf-sheet {
      height: 12rem;
    }
  }

  @media (min-width: 1024px) {
    .hf-home {
      width: 78%;
      max-width: none;
    }
  }
</style>

<script>
  interface Slide {
    alt: string;
    caption?: string;
    src: string;
    sources: { type: string; srcset: string }[];
  }

  interface Controller {
    destroy: () => void;
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let controllers: Controller[] = [];

  /** A time token such as `1200ms` as a number of milliseconds. */
  function token(name: string, fallback: number): number {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const number = parseFloat(value);
    if (Number.isNaN(number)) return fallback;
    return value.endsWith('ms') ? number : value.endsWith('s') ? number * 1000 : fallback;
  }

  function buildSlide(data: Slide, sizes: string): HTMLElement {
    const slide = document.createElement('div');
    slide.className = 'hf-slide';
    slide.dataset['slide'] = '';
    slide.setAttribute('aria-hidden', 'true');
    const picture = document.createElement('picture');
    data.sources.forEach((source) => {
      const el = document.createElement('source');
      el.type = source.type;
      el.srcset = source.srcset;
      el.sizes = sizes;
      picture.append(el);
    });
    const img = document.createElement('img');
    img.src = data.src;
    img.alt = data.alt;
    img.decoding = 'async';
    // Needed seconds later, so it never competes with the first photo for bandwidth.
    img.fetchPriority = 'low';
    picture.append(img);
    slide.append(picture);
    return slide;
  }

  /** The destination chip of a photo: visual only, shown with its photo and hidden from assistive tech. */
  function buildChip(text: string): HTMLElement {
    const chip = document.createElement('p');
    chip.className = 'hf-chip hero-chip';
    chip.dataset['chip'] = '';
    chip.setAttribute('aria-hidden', 'true');
    chip.textContent = text;
    return chip;
  }

  function start(root: HTMLElement): Controller | null {
    const frame = root.querySelector<HTMLElement>('.hf-frame');
    const chipBox = root.querySelector<HTMLElement>('[data-chips]');
    const hero = root.closest<HTMLElement>('.page-hero, .hero') ?? root;
    if (!frame || reduce.matches) return null;

    let data: Slide[] = [];
    try {
      data = JSON.parse(root.dataset['slides'] ?? '[]') as Slide[];
    } catch {
      data = [];
    }
    if (data.length === 0) return null;

    let timer = 0;
    let loader = 0;
    let settle = 0;
    let destroyed = false;
    let ready = false;
    let focusInside = false;
    let current = 0;
    const slides: HTMLElement[] = Array.from(frame.querySelectorAll<HTMLElement>('[data-slide]'));
    const chips: HTMLElement[] = Array.from(root.querySelectorAll<HTMLElement>('[data-chip]'));

    const paused = () => document.hidden || focusInside;

    const show = (next: number) => {
      const from = slides[current];
      const to = slides[next];
      if (!from || !to || from === to) return;
      window.clearTimeout(settle);
      slides.forEach((slide) => slide.classList.remove('is-prev'));
      from.classList.remove('is-active');
      from.classList.add('is-prev');
      from.setAttribute('aria-hidden', 'true');
      to.classList.add('is-active');
      to.removeAttribute('aria-hidden');
      const chipFrom = chips[current];
      const chipTo = chips[next];
      chipFrom?.classList.remove('is-active');
      chipFrom?.setAttribute('aria-hidden', 'true');
      chipTo?.classList.add('is-active');
      chipTo?.removeAttribute('aria-hidden');
      current = next;
      root.dataset['fadeIndex'] = String(next);
      settle = window.setTimeout(
        () => from.classList.remove('is-prev'),
        token('--duration-photo-fade', 1200) + 50,
      );
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (destroyed || !ready || paused()) return;
      timer = window.setTimeout(
        () => {
          if (destroyed || !root.isConnected) return;
          const next = (current + 1) % slides.length;
          const img = slides[next]?.querySelector('img');
          // Wait for a photo that has not arrived (or failed) rather than fading to a blank frame.
          if (img && (!img.complete || img.naturalWidth === 0)) {
            schedule();
            return;
          }
          show(next);
          schedule();
        },
        token('--duration-photo-hold', 3800),
      );
    };

    const sync = () => {
      root.dataset['fadeState'] = ready ? (paused() ? 'paused' : 'running') : 'idle';
      schedule();
    };

    const onFocusIn = (event: FocusEvent) => {
      // The page heading is focused by script after a client-side navigation; that is not a visitor
      // using the hero.
      if (event.target instanceof HTMLElement && event.target.getAttribute('tabindex') === '-1') {
        return;
      }
      focusInside = true;
      sync();
    };
    const onFocusOut = (event: FocusEvent) => {
      if (event.relatedTarget instanceof Node && hero.contains(event.relatedTarget)) return;
      focusInside = false;
      sync();
    };
    const onVisibility = () => sync();
    const onReduce = () => {
      if (reduce.matches) destroy();
    };

    function destroy() {
      destroyed = true;
      window.clearTimeout(timer);
      window.clearTimeout(loader);
      window.clearTimeout(settle);
      hero.removeEventListener('focusin', onFocusIn);
      hero.removeEventListener('focusout', onFocusOut);
      document.removeEventListener('visibilitychange', onVisibility);
      reduce.removeEventListener('change', onReduce);
      window.removeEventListener('load', afterLoad);
    }

    // The other photos come in well after the page has loaded (the first fade is ~5 s away), so
    // they never slow the first photo, which is the LCP image.
    const load = () => {
      if (destroyed) return;
      const sizes = root.dataset['sizes'] ?? '';
      data.forEach((item) => {
        const slide = buildSlide(item, sizes);
        frame.append(slide);
        slides.push(slide);
        if (chipBox && item.caption) {
          const chip = buildChip(item.caption);
          chipBox.append(chip);
          chips.push(chip);
        }
      });
      ready = true;
      sync();
    };
    function afterLoad() {
      loader = window.setTimeout(load, 1500);
    }

    hero.addEventListener('focusin', onFocusIn);
    hero.addEventListener('focusout', onFocusOut);
    document.addEventListener('visibilitychange', onVisibility);
    reduce.addEventListener('change', onReduce);

    if (document.readyState === 'complete') afterLoad();
    else window.addEventListener('load', afterLoad, { once: true });

    return { destroy };
  }

  function stop() {
    controllers.forEach((controller) => controller.destroy());
    controllers = [];
  }

  function init() {
    stop();
    document.querySelectorAll<HTMLElement>('[data-hero-fade]').forEach((root) => {
      const controller = start(root);
      if (controller) controllers.push(controller);
    });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
