---
/**
 * Service card: a rounded colour block with a heading, a line of copy and the services as pills.
 * With `href` the whole card is one link (the heading link stretches over the card).
 * With `demo` the card carries the visible "Sample content" label (roadmap section 5).
 */
import Icon from './Icon.astro';
import SampleLabel from './SampleLabel.astro';

interface Props {
  title: string;
  text: string;
  items?: readonly string[];
  href?: string | undefined;
  tone?: 'red' | 'ink' | 'white';
  demo?: boolean;
  headingLevel?: 2 | 3 | 4;
  state?: 'hover' | 'focus';
  class?: string;
}

const {
  title,
  text,
  items = [],
  href,
  tone = 'white',
  demo = false,
  headingLevel = 3,
  state,
  class: className,
  ...rest
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<article
  class:list={[
    'svc-card',
    `tone-${tone}`,
    href && 'svc-card-link',
    state && `is-${state}`,
    className,
  ]}
  {...rest}
>
  <Heading class="svc-title">
    {href ? (
      <a href={href}>
        {title}
        <Icon name="arrow-right" size={28} class="svc-arrow" />
      </a>
    ) : (
      title
    )}
  </Heading>
  <p class="svc-text">{text}</p>
  {items.length > 0 && (
    <ul class="svc-items">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}
  {demo && <SampleLabel class="svc-sample" />}
</article>

<style>
  .svc-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
    transition:
      transform var(--duration-base) var(--ease-bounce),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .svc-card.tone-white {
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  @media (min-width: 768px) {
    .svc-card {
      padding: var(--space-8);
    }
  }

  .svc-title {
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .svc-title a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
  }

  .svc-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .svc-title a:focus-visible {
    outline: none;
  }

  .svc-card:has(a:focus-visible),
  .svc-card.is-focus {
    /* Two-tone ring (white gap, ink ring) so it shows on any surface around the card. */
    outline: 3px solid var(--ink);
    outline-offset: 4px;
    box-shadow: 0 0 0 7px var(--white);
    /* The ring appears at once; only the hover lift is animated. */
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .svc-card :global(.svc-arrow) {
    color: var(--accent-text);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .svc-card-link:where(:hover, .is-hover) {
    transform: translateY(var(--lift));
    box-shadow: var(--shadow-lg);
  }

  .svc-card-link:where(:hover, .is-hover) :global(.svc-arrow) {
    transform: translateX(calc(var(--lift) * -2));
  }

  .svc-text {
    max-width: var(--measure);
  }

  .svc-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .svc-items li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .svc-card :global(.svc-sample) {
    justify-self: start;
    margin-top: var(--space-2);
  }

  .tone-red .svc-items li {
    border-color: rgb(255 255 255 / 0.6);
  }
</style>
