---
/**
 * Service card: a rounded colour block with a heading, a line of copy and the services as pills.
 * With `href` the whole card is one link (the heading link stretches over the card).
 * With `fold` (Home) the card becomes a numbered accordion row at every width: the description,
 * items and link sit in one panel, and a script turns the title into the toggle (see below).
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  items?: readonly string[];
  href?: string | undefined;
  tone?: 'red' | 'ink' | 'white';
  /** Accordion row (Home). Needs a `data-fold-group` ancestor to close its siblings. */
  fold?: boolean;
  /** Text of the link to the group's page inside an open row, e.g. "See holidays". */
  linkLabel?: string | undefined;
  headingLevel?: 2 | 3 | 4;
  state?: 'hover' | 'focus';
  class?: string;
}

const {
  title,
  text,
  items = [],
  href,
  tone = 'white',
  fold = false,
  linkLabel,
  headingLevel = 3,
  state,
  class: className,
  ...rest
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const Body = fold ? 'div' : Fragment;
const bodyProps = fold
  ? {
      class: 'svc-body',
      'data-fold-body': '',
      id: `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-panel`,
    }
  : {};
---

<article
  class:list={[
    'svc-card',
    `tone-${tone}`,
    href && 'svc-card-link',
    fold && 'svc-fold',
    state && `is-${state}`,
    className,
  ]}
  data-fold={fold ? '' : undefined}
  data-go-label={fold && linkLabel ? linkLabel : undefined}
  {...rest}
>
  <Heading class="svc-title">
    {href ? (
      <a href={href}>
        {title}
        <Icon name="arrow-right" size={28} class="svc-arrow" />
      </a>
    ) : (
      title
    )}
  </Heading>
  <Body {...bodyProps}>
    <p class="svc-text">{text}</p>
    {items.length > 0 && (
      <ul class="svc-items">
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
  </Body>
</article>

<style>
  .svc-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
    /* Only transform animates; the shadow changes at once. */
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .svc-card.tone-white {
    box-shadow: inset 0 0 0 1px var(--sand-200);
  }

  @media (min-width: 768px) {
    .svc-card {
      padding: var(--space-8);
    }
  }

  .svc-title {
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .svc-title a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
  }

  .svc-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .svc-title a:focus-visible {
    outline: none;
  }

  .svc-card:has(a:focus-visible),
  .svc-card.is-focus {
    /* Two-tone ring (white gap, ink ring) so it shows on any surface around the card. */
    outline: 3px solid var(--ink);
    outline-offset: 4px;
    box-shadow: 0 0 0 7px var(--white);
    /* The ring appears at once; only the hover lift is animated. */
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .svc-card :global(.svc-arrow) {
    color: var(--accent-text);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .svc-card-link:where(:hover, .is-hover) {
    transform: translateY(var(--lift));
    box-shadow: var(--shadow-lg);
  }

  .svc-card-link:where(:active, .is-active) {
    transform: scale(var(--press-scale-card));
    box-shadow: var(--shadow-md);
    transition-duration: var(--duration-instant);
  }

  .svc-card-link:where(:hover, .is-hover) :global(.svc-arrow) {
    transform: translateX(calc(var(--lift) * -2));
  }

  .svc-text {
    max-width: var(--measure);
  }

  .svc-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .svc-items li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .tone-red .svc-items li {
    border-color: rgb(255 255 255 / 0.6);
  }

  /* ---------- Accordion row (Home only: the card has `fold`) ----------
     Phone sizes first; from 768px the numbered desktop row further down. */
  @media all {
    .svc-card.svc-fold {
      /* Reset the tone: rows sit straight on the section colour. */
      --bg: transparent;
      --text: var(--ink);
      --text-muted: var(--stone-600);
      --accent-text: var(--red-700);
      gap: 0;
      padding: 0;
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      box-shadow: none;
      border-bottom: 1px solid var(--stone-300);
    }

    .svc-fold.svc-card-link:where(:hover, .is-hover, :active, .is-active) {
      transform: none;
      box-shadow: none;
    }

    .svc-fold:has(a:focus-visible) {
      outline: none;
      box-shadow: none;
    }

    .svc-fold .svc-title {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    /* Before the toggle exists (no JavaScript) the title is a plain link and everything is open. */
    .svc-fold .svc-title a {
      min-height: 4rem;
    }

    .svc-fold .svc-title a::after {
      content: none;
    }

    .svc-fold .svc-title a:focus-visible {
      outline: 3px solid var(--ink);
      outline-offset: -3px;
    }

    .svc-fold .svc-body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
      padding-block: 0.25rem 1.25rem;
    }

    .svc-fold .svc-text {
      font-size: 1rem;
      line-height: 1.55;
      color: var(--stone-600);
    }

    .svc-fold .svc-items {
      margin-top: 0;
      gap: 0.5rem;
    }

    .svc-fold .svc-items li {
      padding: 0.625rem 1rem;
      border-width: 1.5px;
      border-color: var(--stone-300);
      font-size: 0.9375rem;
      font-weight: 600;
    }

    /* The link to the group's page, moved here by the script. */
    .svc-fold :global(.svc-go) {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      min-height: 2.75rem;
      color: var(--ink);
      font-weight: 700;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .svc-fold :global(.svc-go:focus-visible) {
      outline: 3px solid var(--ink);
      outline-offset: 3px;
    }

    .svc-fold :global(.svc-go svg) {
      width: 1.25rem;
      height: 1.25rem;
    }

    .svc-fold :global(.svc-fold-btn) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      min-height: 4rem;
      padding: 0.5rem 0;
      border: 0;
      border-radius: var(--radius-sm);
      background: transparent;
      color: inherit;
      font: inherit;
      letter-spacing: inherit;
      text-align: left;
      cursor: pointer;
    }

    .svc-fold :global(.svc-fold-btn:focus-visible) {
      outline: 3px solid var(--ink);
      outline-offset: -3px;
    }

    /* The plus is two bars; turned 45 degrees it becomes a cross. */
    .svc-fold :global(.svc-plus) {
      position: relative;
      flex: none;
      width: 1.375rem;
      height: 1.375rem;
      transition: transform var(--duration-base) var(--ease-out);
    }

    .svc-fold :global(.svc-plus::before),
    .svc-fold :global(.svc-plus::after) {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      height: 2.2px;
      margin-top: -1.1px;
      border-radius: 2px;
      background: currentColor;
    }

    .svc-fold :global(.svc-plus::after) {
      rotate: 90deg;
    }

    .svc-fold :global(.svc-fold-btn[aria-expanded='true'] .svc-plus) {
      transform: rotate(45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-fold :global(.svc-plus) {
      transition: none;
    }
  }
  /* The row number shows only from 768px. */
  .svc-fold :global(.svc-num) {
    display: none;
  }

  @media (min-width: 768px) {
    .svc-card.svc-fold {
      border-bottom-color: var(--stone-600);
    }

    .svc-fold .svc-title {
      font-size: clamp(2rem, 1rem + 2.4vw, 3rem);
      line-height: 1;
      letter-spacing: -0.045em;
    }

    .svc-fold :global(.svc-fold-btn) {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 0;
      min-height: 5.5rem;
      padding-block: 1.25rem;
    }

    .svc-fold :global(.svc-num) {
      display: block;
      font-family: var(--font-text);
      font-size: var(--text-sm);
      font-weight: 800;
      letter-spacing: 0;
      color: var(--red-700);
    }

    /* The round toggle: an outlined plus, filled ink with a white cross when open or hovered. */
    .svc-fold :global(.svc-plus) {
      width: 2.75rem;
      height: 2.75rem;
      border: 1.5px solid var(--ink);
      border-radius: 50%;
      transition:
        transform var(--duration-base) var(--ease-out),
        background-color var(--duration-fast) var(--ease-out);
    }

    .svc-fold :global(.svc-plus::before),
    .svc-fold :global(.svc-plus::after) {
      inset: 50% 0.8rem auto;
      height: 1.5px;
      margin-top: -0.75px;
    }

    .svc-fold :global(.svc-fold-btn[aria-expanded='true'] .svc-plus),
    .svc-fold :global(.svc-fold-btn:hover .svc-plus) {
      background: var(--ink);
      color: var(--white);
    }

    /* Open panel: the description beside the chips and the link, indented under the title. */
    .svc-fold .svc-body:not([hidden]) {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-auto-rows: min-content;
      column-gap: var(--space-10);
      row-gap: 0.875rem;
      align-items: start;
      padding: 0 0 var(--space-10) 3.5rem;
    }

    .svc-fold .svc-text {
      grid-column: 1;
      grid-row: 1 / span 3;
      max-width: 26rem;
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--stone-800);
    }

    .svc-fold .svc-items,
    .svc-fold :global(.svc-go) {
      grid-column: 2;
      justify-self: start;
    }

    .svc-fold .svc-items li {
      padding: 0.5rem 0.875rem;
      border-color: var(--ink);
      font-size: var(--text-sm);
    }

    .svc-fold :global(.svc-go) {
      color: var(--red-700);
      font-size: var(--text-sm);
      text-decoration: none;
    }

    .svc-fold :global(.svc-go:hover) {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }

    .svc-fold :global(.svc-go svg) {
      width: 1rem;
      height: 1rem;
      transition: transform var(--duration-base) var(--ease-out);
    }

    .svc-fold :global(.svc-go:hover svg) {
      transform: translateX(3px);
    }
  }
</style>

<script>
  /**
   * Accordion for `fold` cards. Each card's title link becomes a button (aria-expanded,
   * aria-controls) that opens its panel and closes its siblings; the link to the group's page moves
   * into the panel, worded by `data-go-label`. On phones every row starts closed; from 768px the
   * first row starts open. Without JavaScript the titles stay links and every panel is open.
   */
  const phone = window.matchMedia('(max-width: 767.98px)');

  function panelOf(card: HTMLElement): HTMLElement | null {
    return card.querySelector<HTMLElement>('[data-fold-body]');
  }

  function toggle(card: HTMLElement, open: boolean): void {
    const button = card.querySelector<HTMLButtonElement>('.svc-fold-btn');
    const panel = panelOf(card);
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  }

  function enhance(card: HTMLElement, index: number): void {
    if (card.dataset['foldActive']) return;
    const heading = card.querySelector<HTMLElement>('.svc-title');
    const link = heading?.querySelector<HTMLAnchorElement>('a');
    const panel = panelOf(card);
    if (!heading || !link || !panel) return;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'svc-fold-btn';
    button.id = panel.id.replace(/-panel$/, '-button');
    button.setAttribute('aria-controls', panel.id);
    const num = document.createElement('span');
    num.className = 'svc-num';
    num.setAttribute('aria-hidden', 'true');
    num.textContent = String(index + 1).padStart(2, '0');
    const label = document.createElement('span');
    label.textContent = (link.textContent ?? '').trim();
    const plus = document.createElement('span');
    plus.className = 'svc-plus';
    plus.setAttribute('aria-hidden', 'true');
    button.append(num, label, plus);

    const goLabel = card.dataset['goLabel'];
    if (goLabel) {
      const text = Array.from(link.childNodes).find(
        (node) => node.nodeType === Node.TEXT_NODE && (node.textContent ?? '').trim() !== '',
      );
      if (text) text.textContent = goLabel + ' ';
    }

    panel.setAttribute('role', 'region');
    panel.setAttribute('aria-labelledby', button.id);
    link.classList.add('svc-go');
    panel.append(link);
    heading.replaceChildren(button);
    card.dataset['foldActive'] = 'true';
    toggle(card, !phone.matches && index === 0);

    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      if (open) {
        const group = card.closest('[data-fold-group]') ?? document;
        group.querySelectorAll<HTMLElement>('[data-fold-active]').forEach((other) => {
          if (other !== card) toggle(other, false);
        });
      }
      toggle(card, open);
    });
  }

  function sync(): void {
    document.querySelectorAll<HTMLElement>('[data-fold-group]').forEach((group) => {
      group.querySelectorAll<HTMLElement>('[data-fold]').forEach((card, index) => {
        enhance(card, index);
      });
    });
  }

  document.addEventListener('astro:page-load', sync);
</script>
