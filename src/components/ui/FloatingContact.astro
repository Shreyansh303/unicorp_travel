---
/**
 * Floating WhatsApp, call, email and chat buttons (F-02; email added by the client, 2026-11-04).
 * Below 768px they form a launcher: one wide primary pill (WhatsApp, or Enquire on trip pages)
 * and a round "More contact options" button that opens a stack of labelled pills (Chat with us,
 * Email, Call, and WhatsApp when Enquire is the primary) above a light scrim. Without JavaScript
 * the more button is hidden and the stack is shown in the bar instead (see BaseLayout), so Call
 * stays reachable. From 768px the buttons form a centred bar; below 1440px the page reserves the
 * bar's height at its end, so the bar never covers content. From 1440px the side margin beside
 * the 75rem content column is at least 120px, so round buttons in the bottom-right corner keep a
 * clear gap from content. Numbers and links come from site.ts helpers; nothing renders without
 * a number. The chat button is a plain link to the Zapier chat page and renders only when
 * site.chatbot.url is set; nothing from Zapier loads on our pages.
 */
import Icon from './Icon.astro';
import { mailtoHref, shown, site, telHref, whatsappHref } from '../../config/site';

interface Props {
  /** Page-specific WhatsApp message. */
  message?: string;
  /** Styleguide only: render in place instead of fixed to the screen. */
  inline?: boolean;
  /** Phones: the primary button reads "Enquire" and opens the page's folded form (trip pages). */
  enquire?: boolean;
  /** Phones: no bottom bar (the contact page is the contact surface). From 768 px nothing changes. */
  phoneHidden?: boolean;
}

const {
  message = `Hello ${site.displayName}, I would like help planning a trip.`,
  inline = false,
  enquire = false,
  phoneHidden = false,
} = Astro.props;
const mobile = shown(site.phones.mobile);
const email = shown(site.floatingEmail);
const chatUrl = site.chatbot.url;
const menuId = inline ? 'floating-more-menu-inline' : 'floating-more-menu';
const waHref = whatsappHref(message);
---

{mobile && (
  <>
    <div
      class:list={[
        'floating',
        inline ? 'floating-inline' : 'floating-fixed',
        phoneHidden && 'floating-phone-hidden',
      ]}
    >
      {enquire ? (
        <button
          type="button"
          class="floating-btn floating-wa floating-enquire floating-primary"
          aria-controls="enquiry-fold"
          data-open-enquiry
          data-needs-js
        >
          <span class="floating-text">Enquire</span>
        </button>
      ) : (
        <a
          class="floating-btn floating-wa floating-wa-link floating-primary"
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={22} />
          <span class="floating-text">WhatsApp</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
      <button
        type="button"
        class="floating-more"
        aria-label="More contact options"
        aria-expanded="false"
        aria-controls={menuId}
        data-more
        data-needs-js
      >
        <span class="more-dots">
          <Icon name="ellipsis" size={22} />
        </span>
        <span class="more-close">
          <Icon name="close" size={22} />
        </span>
      </button>
      <div class="floating-menu" id={menuId} data-more-menu>
        {chatUrl && (
          <a
            class="floating-btn floating-chat"
            href={chatUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="message-square" size={22} />
            <span class="floating-text">Chat with us</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
        {enquire && (
          <a
            class="floating-btn floating-wa floating-wa-link"
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" size={22} />
            <span class="floating-text">WhatsApp</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
        <a class="floating-btn floating-call" href={telHref(mobile)}>
          <Icon name="phone" size={22} />
          <span class="floating-text">
            Call<span class="floating-number"> {mobile.display}</span>
          </span>
        </a>
        {email && (
          <a
            class="floating-btn floating-mail"
            href={mailtoHref(email, { subject: `Enquiry from the ${site.displayName} website` })}
          >
            <Icon name="mail" size={22} />
            <span class="floating-text">Email</span>
          </a>
        )}
      </div>
    </div>
    {!inline && !phoneHidden && <div class="floating-scrim" data-more-scrim aria-hidden="true" />}
  </>
)}

<style>
  .floating {
    --floating-bar-height: 4.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    padding: var(--space-3) var(--gutter);
    background: var(--white);
    box-shadow:
      0 -1px 0 var(--sand-200),
      0 -8px 24px -12px rgb(20 17 16 / 0.25);
  }

  .floating-fixed {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-floating);
    padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
  }

  /* Reserve the bar's height at the end of the page so nothing sits under it. */
  :global(body:has(.floating-fixed)) {
    --floating-bar-height: 4.5rem;
    padding-bottom: calc(var(--floating-bar-height) + env(safe-area-inset-bottom, 0px));
  }

  /*
   * Keep keyboard focus clear of the bar (WCAG 2.4.11): when focus moves to an element, the
   * browser scrolls it into the area above the bar, not under it.
   */
  :global(html:has(.floating-fixed)) {
    scroll-padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px) + 1rem);
  }

  .floating-inline {
    border-radius: var(--radius-lg);
  }

  /* From 768px the pills sit in the bar itself; the phone-only parts are off. */
  .floating-menu {
    display: contents;
  }

  .floating-more,
  .floating-scrim {
    display: none;
  }

  .floating-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: var(--weight-black);
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .floating-wa {
    background: var(--red-600);
    color: var(--white);
  }

  .floating-wa:hover {
    background: var(--red-700);
  }

  /* Trip pages: the Enquire button is for phones; from 768 px the WhatsApp button stays. */
  .floating-btn.floating-enquire {
    display: none;
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }

  .floating-call {
    background: var(--ink);
    color: var(--white);
  }

  .floating-call:hover {
    background: var(--stone-800);
  }

  .floating-mail,
  .floating-chat {
    background: var(--white);
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .floating-mail:hover,
  .floating-chat:hover {
    background: var(--sand-100);
  }

  .floating-btn:focus-visible,
  .floating-more:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
    box-shadow: 0 0 0 6px var(--white);
  }

  /* Inline demo: on the narrowest phones the number is read out but not shown. */
  @media (max-width: 419px) {
    .floating-inline .floating-number {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /*
   * Phones: a slim paper bar holding the primary pill and the round More button. It steps aside
   * while the contact band is on screen (the script sets data-away) or the phone Menu is open
   * (html[data-menu-open]); hidden means invisible, not focusable and not tappable. The pill
   * stack and the scrim fade and slide in; only transform and opacity move.
   */
  @media (max-width: 767.98px) {
    .floating-fixed {
      --floating-bar-height: 4.3125rem; /* 10 + 48 + 10 + 1px hairline */
      display: flex;
      gap: 10px;
      padding: 10px 20px calc(10px + env(safe-area-inset-bottom, 0px));
      background: var(--paper);
      border-top: 1px solid var(--sand-200);
      box-shadow: none;
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear 0s;
    }

    :global(body:has(.floating-fixed)) {
      --floating-bar-height: 4.3125rem;
      padding-bottom: calc(4.3125rem + env(safe-area-inset-bottom, 0px));
    }

    :global(html:has(.floating-fixed)) {
      scroll-padding-bottom: calc(4.3125rem + env(safe-area-inset-bottom, 0px) + 1rem);
    }

    /* The contact page has no bar: nothing is reserved for it either. */
    .floating-fixed.floating-phone-hidden {
      display: none;
    }

    :global(body:has(.floating-fixed.floating-phone-hidden)) {
      padding-bottom: 0;
      --floating-bar-height: 0px;
    }

    :global(html:has(.floating-fixed.floating-phone-hidden)) {
      scroll-padding-bottom: 0;
    }

    .floating-fixed[data-away],
    :global(html[data-menu-open]) .floating-fixed {
      opacity: 0;
      transform: translateY(12px);
      visibility: hidden;
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }

    .floating-fixed .floating-btn {
      height: 3rem;
      min-width: 0;
      padding: 0;
      font-size: 1rem;
      font-weight: var(--weight-bold);
    }

    .floating-fixed .floating-primary {
      flex: 1 1 0;
    }

    .floating-fixed .floating-btn.floating-enquire {
      display: inline-flex;
    }

    .floating-fixed .floating-btn :global(.icon) {
      width: 20px;
      height: 20px;
    }

    /* The round More button: ink, dots, and a close mark while the stack is open. */
    .floating-fixed .floating-more {
      display: inline-grid;
      place-items: center;
      flex: 0 0 3rem;
      width: 3rem;
      height: 3rem;
      padding: 0;
      border: 0;
      border-radius: var(--radius-pill);
      background: var(--ink);
      color: var(--white);
      cursor: pointer;
    }

    .floating-more span {
      display: inline-flex;
    }

    .floating-more .more-close,
    .floating-more[aria-expanded='true'] .more-dots {
      display: none;
    }

    .floating-more[aria-expanded='true'] .more-close {
      display: inline-flex;
    }

    /* The stack of labelled pills, right-aligned above the More button. */
    .floating-fixed .floating-menu {
      position: absolute;
      right: 20px;
      bottom: calc(100% + 10px);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px);
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }

    .floating-fixed[data-more-open] .floating-menu {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear 0s;
    }

    .floating-fixed .floating-menu .floating-btn {
      padding: 0 20px;
      box-shadow: var(--shadow-lg);
    }

    .floating-fixed .floating-menu .floating-mail,
    .floating-fixed .floating-menu .floating-chat {
      box-shadow:
        inset 0 0 0 1.5px var(--ink),
        var(--shadow-lg);
    }

    .floating-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: calc(var(--z-floating) - 1);
      background: rgb(20 17 16 / 0.32);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }

    .floating-fixed[data-more-open] ~ .floating-scrim {
      opacity: 1;
      visibility: visible;
      transition:
        opacity var(--duration-base) var(--ease-out),
        visibility 0s linear 0s;
    }
  }

  @media (max-width: 767.98px) and (prefers-reduced-motion: reduce) {
    .floating-fixed,
    .floating-fixed[data-away],
    :global(html[data-menu-open]) .floating-fixed,
    .floating-fixed .floating-menu,
    .floating-fixed[data-more-open] .floating-menu,
    .floating-scrim,
    .floating-fixed[data-more-open] ~ .floating-scrim {
      transition: none;
    }

    .floating-fixed .floating-menu {
      transform: none;
    }
  }

  @media (min-width: 768px) {
    .floating {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 15rem);
      justify-content: center;
    }

    .floating:has(.floating-mail),
    .floating:has(.floating-chat) {
      grid-auto-columns: minmax(0, 13rem);
    }

    .floating .floating-wa-link {
      order: 1;
    }

    .floating .floating-call {
      order: 2;
    }

    .floating .floating-mail {
      order: 3;
    }

    .floating .floating-chat {
      order: 4;
    }
  }

  @media (min-width: 1440px) {
    :global(html:has(.floating-fixed)) {
      scroll-padding-bottom: 0;
    }

    :global(body:has(.floating-fixed)) {
      padding-bottom: 0;
      --floating-bar-height: 0px;
    }

    .floating-fixed,
    .floating-fixed:has(.floating-mail),
    .floating-fixed:has(.floating-chat) {
      inset: auto var(--space-6) var(--space-6) auto;
      grid-auto-flow: row;
      grid-auto-columns: auto;
      padding: 0;
      background: transparent;
      box-shadow: none;
    }

    .floating-fixed .floating-btn {
      width: 3.5rem;
      height: 3.5rem;
      padding: 0;
      /* A white ring keeps the round buttons visible over ink and red sections. */
      box-shadow:
        0 0 0 2px var(--white),
        var(--shadow-lg);
    }

    /* The white email and chat buttons get an ink ring inside the white one, so they show on paper too. */
    .floating-fixed .floating-mail,
    .floating-fixed .floating-chat {
      box-shadow:
        inset 0 0 0 1.5px var(--ink),
        0 0 0 2px var(--white),
        var(--shadow-lg);
    }

    .floating-fixed .floating-btn:focus-visible {
      box-shadow:
        0 0 0 6px var(--white),
        var(--shadow-lg);
    }

    .floating-fixed .floating-btn:hover {
      transform: translateY(var(--lift)) scale(var(--hover-scale));
    }

    .floating-fixed .floating-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

<script>
  /*
   * Backup for scroll-padding: text fields scroll only their caret into view, so a tall field
   * can end up partly under the bar. After focus moves, lift the element clear of the bar.
   * Not when focus comes from a click or tap: scrolling between press and release would move
   * the button away from the pointer and the click would be lost.
   */
  let pointerFocus = false;
  document.addEventListener(
    'pointerdown',
    () => {
      pointerFocus = true;
      window.setTimeout(() => {
        pointerFocus = false;
      }, 0);
    },
    { capture: true },
  );

  document.addEventListener('focusin', (event) => {
    if (pointerFocus) return;
    const bar = document.querySelector<HTMLElement>('.floating-fixed');
    const target = event.target as HTMLElement | null;
    // A bar that has stepped aside (phones) covers nothing.
    if (bar && getComputedStyle(bar).visibility === 'hidden') return;
    if (bar && getComputedStyle(bar).display === 'none') return;
    if (!bar || !target || bar.contains(target) || getComputedStyle(bar).position !== 'fixed') {
      return;
    }
    // An open dialog sits above the bar and locks the page; don't scroll the page behind it.
    if (target.closest('dialog[open], [aria-modal="true"]')) return;
    const barTop = bar.getBoundingClientRect().top;
    if (barTop >= window.innerHeight - 1 || bar.getBoundingClientRect().left > 0) return;
    const rect = target.getBoundingClientRect();
    const overlap = rect.bottom - barTop;
    if (overlap > 0 && rect.height < barTop) {
      window.scrollBy({ top: overlap + 16, behavior: 'instant' });
    }
  });
</script>

<script>
  /*
   * Trip pages: any [data-open-enquiry] button opens the folded enquiry form (the same fold
   * button the form uses), brings the form's section to the top and puts focus in its first field.
   */
  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement | null)?.closest('[data-open-enquiry]');
    if (!trigger) return;
    const fold = document.getElementById('enquiry-fold')?.closest<HTMLElement>('[data-fold]');
    const foldButton = fold?.querySelector<HTMLButtonElement>('[data-fold-button]');
    if (foldButton && !foldButton.hidden) foldButton.click();
    else {
      document
        .querySelector<HTMLElement>('#enquiry input:not([type="hidden"]), #enquiry select')
        ?.focus();
    }
    document.getElementById('enquire')?.scrollIntoView({ block: 'start', behavior: 'instant' });
  });
</script>

<script>
  /*
   * Phones: step aside while a contact band ([data-enquiry]) is on screen, since it offers the
   * same two actions. CSS acts on this attribute only below 768px. Pages without a band keep the
   * bar. Runs again after every client-side navigation, because the page swap replaces the bar.
   */
  let observer: IntersectionObserver | undefined;

  function watchContactBand() {
    observer?.disconnect();
    const bar = document.querySelector<HTMLElement>('.floating-fixed');
    const bands = document.querySelectorAll<HTMLElement>('[data-enquiry]');
    if (!bar || bands.length === 0) return;
    const onScreen = new Set<Element>();
    observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) onScreen.add(entry.target);
        else onScreen.delete(entry.target);
      }
      bar.toggleAttribute('data-away', onScreen.size > 0);
    });
    bands.forEach((band) => observer?.observe(band));
  }

  document.addEventListener('astro:page-load', watchContactBand);
</script>

<script>
  /*
   * Phones: the More button opens a stack of contact pills. Escape, a tap on the scrim, or
   * choosing an option closes it; focus moves into the stack on open and back to the button on
   * close. The stack also closes when focus leaves the bar, when the bar steps aside, when the
   * phone Menu opens and when the window grows to 768px.
   */
  const phones = window.matchMedia('(max-width: 767.98px)');
  let watcher: MutationObserver | undefined;

  const bar = () => document.querySelector<HTMLElement>('.floating-fixed');
  const moreButton = () => bar()?.querySelector<HTMLButtonElement>('[data-more]') ?? null;
  const isOpen = () => bar()?.hasAttribute('data-more-open') ?? false;

  function setOpen(open: boolean, restoreFocus = false): void {
    const el = bar();
    const button = moreButton();
    if (!el || !button) return;
    el.toggleAttribute('data-more-open', open);
    button.setAttribute('aria-expanded', String(open));
    if (open) {
      el.querySelector<HTMLElement>('[data-more-menu] a, [data-more-menu] button')?.focus();
    } else if (restoreFocus) {
      button.focus();
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;
    if (target.closest('[data-more]')) {
      setOpen(!isOpen());
      return;
    }
    if (!isOpen()) return;
    if (target.closest('[data-more-scrim]')) {
      setOpen(false, true);
      return;
    }
    if (target.closest('[data-more-menu] a, [data-more-menu] button')) setOpen(false, true);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      event.preventDefault();
      setOpen(false, true);
    }
  });

  document.addEventListener('focusin', (event) => {
    const el = bar();
    if (isOpen() && el && !el.contains(event.target as Node | null)) setOpen(false);
  });

  phones.addEventListener('change', () => {
    if (isOpen()) setOpen(false);
  });

  function watchBar() {
    watcher?.disconnect();
    const el = bar();
    if (!el) return;
    watcher = new MutationObserver(() => {
      if (
        isOpen() &&
        (el.hasAttribute('data-away') || document.documentElement.hasAttribute('data-menu-open'))
      ) {
        setOpen(false);
      }
    });
    watcher.observe(el, { attributes: true, attributeFilter: ['data-away'] });
    watcher.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-menu-open'],
    });
  }

  document.addEventListener('astro:page-load', watchBar);
</script>
