---
/**
 * Button, or a link styled as one when `href` is set.
 * Variants: primary (red fill), secondary (outlined), ghost (text only).
 * Colours come from the surrounding tone, so the same button works on paper, ink and red.
 * `state` forces a visual state for the styleguide only.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';
import './button.css';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  iconStart?: IconName;
  iconEnd?: IconName;
  /** Opens in a new tab (adds rel and a hidden note for screen readers). */
  external?: boolean;
  state?: 'hover' | 'focus' | 'active';
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  loading = false,
  iconStart,
  iconEnd,
  external = false,
  state,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'btn',
  `btn-${variant}`,
  `btn-${size}`,
  state && `is-${state}`,
  loading && 'is-loading',
  className,
];
const iconSize = size === 'sm' ? 18 : 20;
---

{href && !disabled ? (
  <a
    class:list={classes}
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    {...(rest as HTMLAttributes<'a'>)}
  >
    {iconStart && <Icon name={iconStart} size={iconSize} />}
    <span>
      <slot />
    </span>
    {external && <span class="sr-only"> (opens in a new tab)</span>}
    {iconEnd && <Icon name={iconEnd} size={iconSize} class="btn-icon-end" />}
  </a>
) : (
  <button
    class:list={classes}
    type={type}
    disabled={disabled}
    aria-disabled={loading ? 'true' : undefined}
    aria-busy={loading ? 'true' : undefined}
    {...rest}
  >
    {loading ? (
      <Icon name="loader" size={iconSize} class="btn-spinner" />
    ) : (
      iconStart && <Icon name={iconStart} size={iconSize} />
    )}
    <span>
      <slot />
    </span>
    {loading && <span class="sr-only">, please wait</span>}
    {iconEnd && !loading && <Icon name={iconEnd} size={iconSize} class="btn-icon-end" />}
  </button>
)}
