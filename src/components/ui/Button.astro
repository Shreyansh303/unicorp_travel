---
/**
 * Button, or a link styled as one when `href` is set.
 * Variants: primary (red fill), secondary (outlined), ghost (text only).
 * Colours come from the surrounding tone, so the same button works on paper, ink and red.
 * `state` forces a visual state for the styleguide only.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  iconStart?: IconName;
  iconEnd?: IconName;
  /** Opens in a new tab (adds rel and a hidden note for screen readers). */
  external?: boolean;
  state?: 'hover' | 'focus' | 'active';
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  loading = false,
  iconStart,
  iconEnd,
  external = false,
  state,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'btn',
  `btn-${variant}`,
  `btn-${size}`,
  state && `is-${state}`,
  loading && 'is-loading',
  className,
];
const iconSize = size === 'sm' ? 18 : 20;
---

{href && !disabled ? (
  <a
    class:list={classes}
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    {...(rest as HTMLAttributes<'a'>)}
  >
    {iconStart && <Icon name={iconStart} size={iconSize} />}
    <span>
      <slot />
    </span>
    {external && <span class="sr-only"> (opens in a new tab)</span>}
    {iconEnd && <Icon name={iconEnd} size={iconSize} class="btn-icon-end" />}
  </a>
) : (
  <button
    class:list={classes}
    type={type}
    disabled={disabled}
    aria-disabled={loading ? 'true' : undefined}
    aria-busy={loading ? 'true' : undefined}
    {...rest}
  >
    {loading ? (
      <Icon name="loader" size={iconSize} class="btn-spinner" />
    ) : (
      iconStart && <Icon name={iconStart} size={iconSize} />
    )}
    <span>
      <slot />
    </span>
    {loading && <span class="sr-only">, please wait</span>}
    {iconEnd && !loading && <Icon name={iconEnd} size={iconSize} class="btn-icon-end" />}
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    font-family: var(--font-text);
    font-size: var(--text-base);
    font-weight: var(--weight-black);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--duration-base) var(--ease-bounce),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .btn-sm {
    min-height: var(--tap);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .btn-lg {
    min-height: 3.75rem;
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
  }

  /* Primary: the brand red fill. */
  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn-primary:where(:hover, .is-hover):not(:disabled) {
    background: var(--accent-hover);
    transform: translateY(var(--lift)) rotate(var(--tilt));
  }

  /* Secondary: outlined in the text colour; fills on hover. */
  .btn-secondary {
    background: transparent;
    color: var(--text);
    box-shadow: inset 0 0 0 2px var(--text);
  }

  .btn-secondary:where(:hover, .is-hover):not(:disabled) {
    background: var(--text);
    color: var(--bg);
    transform: translateY(var(--lift));
  }

  /* Ghost: text only, underline appears on hover. */
  .btn-ghost {
    background: transparent;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .btn-ghost:where(:hover, .is-hover):not(:disabled) {
    background: var(--surface-sunken);
    text-decoration-color: var(--accent);
  }

  .btn:where(:active, .is-active):not(:disabled) {
    transform: translateY(0) scale(var(--press-scale));
  }

  .btn.is-focus {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .btn:disabled {
    background: var(--sand-200);
    color: var(--stone-600);
    box-shadow: none;
    cursor: not-allowed;
  }

  .btn.is-loading {
    cursor: progress;
  }

  .btn :global(.btn-icon-end) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .btn:where(:hover, .is-hover) :global(.btn-icon-end) {
    transform: translateX(calc(var(--lift) * -1));
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn :global(.btn-spinner) {
      animation: btn-spin 0.9s linear infinite;
    }
  }

  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
