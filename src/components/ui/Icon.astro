---
/**
 * Inline line icons (24px grid, 2px stroke, after the ISC-licensed Lucide set).
 * Decorative by default (aria-hidden). Pass `label` when the icon carries meaning on its own.
 */
import { iconPaths, type IconName } from './icons';

export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={iconPaths[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
