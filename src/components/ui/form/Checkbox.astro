---
/** Single checkbox with its label beside it, plus optional hint and error. */
import type { HTMLAttributes } from 'astro/types';
import FieldMessage from './FieldMessage.astro';
import { fieldAria } from './field';
import './field.css';

interface Props extends Omit<HTMLAttributes<'input'>, 'id' | 'name' | 'type'> {
  id: string;
  name: string;
  label: string;
  hint?: string;
  error?: string;
  state?: 'hover' | 'focus';
}

const { id, name, label, hint, error, state, class: className, ...rest } = Astro.props;
const aria = fieldAria(id, hint, error);
---

<div class:list={['check', className]}>
  <div class="check-row">
    <input
      class:list={['check-input', state && `is-${state}`]}
      type="checkbox"
      id={id}
      name={name}
      aria-describedby={aria.describedBy}
      aria-invalid={aria.invalid}
      {...rest}
    />
    <label class="check-label" for={id}>
      {label}
    </label>
  </div>
  <div class="check-msgs">
    <FieldMessage id={aria.hintId} kind="hint" text={hint} />
    <FieldMessage id={aria.errorId} kind="error" text={error} />
  </div>
</div>
