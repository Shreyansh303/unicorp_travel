---
/** Single checkbox with its label beside it, plus optional hint and error. */
import type { HTMLAttributes } from 'astro/types';
import FieldMessage from './FieldMessage.astro';
import { fieldAria } from './field';

interface Props extends Omit<HTMLAttributes<'input'>, 'id' | 'name' | 'type'> {
  id: string;
  name: string;
  label: string;
  hint?: string;
  error?: string;
  state?: 'hover' | 'focus';
}

const { id, name, label, hint, error, state, class: className, ...rest } = Astro.props;
const aria = fieldAria(id, hint, error);
---

<div class:list={['check', className]}>
  <div class="check-row">
    <input
      class:list={['check-input', state && `is-${state}`]}
      type="checkbox"
      id={id}
      name={name}
      aria-describedby={aria.describedBy}
      aria-invalid={aria.invalid}
      {...rest}
    />
    <label class="check-label" for={id}>
      {label}
    </label>
  </div>
  <div class="check-msgs">
    <FieldMessage id={aria.hintId} kind="hint" text={hint} />
    <FieldMessage id={aria.errorId} kind="error" text={error} />
  </div>
</div>

<style>
  .check {
    display: grid;
    gap: var(--space-1);
  }

  .check-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: var(--tap);
    padding-top: var(--space-2);
  }

  .check-input {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--red-700);
    cursor: pointer;
  }

  .check-input:focus-visible,
  .check-input.is-focus {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .check-input.is-hover {
    outline: 2px solid var(--stone-400);
    outline-offset: 2px;
  }

  .check-input[aria-invalid='true'] {
    outline: 2px solid var(--error-700);
    outline-offset: 2px;
  }

  .check-input[aria-invalid='true']:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .check-input:disabled,
  .check-input:disabled + .check-label {
    cursor: not-allowed;
    color: var(--stone-600);
  }

  .check-label {
    cursor: pointer;
  }

  .check-msgs {
    display: grid;
    gap: var(--space-1);
    padding-left: calc(1.5rem + var(--space-3));
  }

  .check-msgs:empty {
    display: none;
  }
</style>
