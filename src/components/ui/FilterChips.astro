---
/**
 * Filter chips: a labelled group of toggle buttons with aria-pressed. A pressed chip shows a
 * tick as well as a fill, so the state never relies on colour alone. Each toggle dispatches a
 * bubbling `chips:change` event with the group's pressed values.
 */
import Icon from './Icon.astro';
import './chips.css';

interface Chip {
  value: string;
  label: string;
  pressed?: boolean;
  disabled?: boolean;
  /** Styleguide only. */
  state?: 'hover' | 'focus';
}

interface Props {
  label: string;
  name: string;
  chips: Chip[];
  /** Show the group label visibly (otherwise it only names the group). */
  showLabel?: boolean;
  class?: string;
}

const { label, name, chips, showLabel = true, class: className } = Astro.props;
const labelId = `chips-${name}-label`;
---

<div class:list={['chips', className]}>
  <p id={labelId} class:list={['chips-label', !showLabel && 'sr-only']}>
    {label}
  </p>
  <div class="chips-list" role="group" aria-labelledby={labelId} data-chips={name}>
    {chips.map((chip) => (
      <button
        type="button"
        class:list={['chip', chip.state && `is-${chip.state}`]}
        aria-pressed={chip.pressed ? 'true' : 'false'}
        value={chip.value}
        disabled={chip.disabled}
        data-chip
      >
        <Icon name="check" size={16} class="chip-tick" />
        {chip.label}
      </button>
    ))}
  </div>
</div>

<script>
  function bind(group: HTMLElement): void {
    if (group.dataset['bound']) return;
    group.dataset['bound'] = 'true';
    group.addEventListener('click', (event) => {
      const chip = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-chip]');
      if (!chip || chip.disabled) return;
      chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
      const values = Array.from(
        group.querySelectorAll<HTMLButtonElement>('[data-chip][aria-pressed="true"]'),
      ).map((item) => item.value);
      group.dispatchEvent(
        new CustomEvent('chips:change', {
          bubbles: true,
          detail: { name: group.dataset['chips'], values },
        }),
      );
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-chips]').forEach(bind);
  });
</script>
