---
/**
 * Parallax image: the slotted image drifts a little against the scroll inside a clipped frame.
 * Only transform moves. CSS scroll timelines where supported; otherwise GSAP ScrollTrigger,
 * loaded lazily after first paint. Under reduced motion nothing moves (and nothing loads).
 * Never use it on the LCP image.
 */
interface Props {
  /** Frame shape. */
  shape?: 'rounded' | 'arch' | 'none';
  class?: string;
}

const { shape = 'rounded', class: className, ...rest } = Astro.props;
---

<div class:list={['parallax', `parallax-${shape}`, className]} data-parallax {...rest}>
  <div class="parallax-inner">
    <slot />
  </div>
</div>

<style is:global>
  .parallax {
    position: relative;
    overflow: hidden;
  }

  .parallax-rounded {
    border-radius: var(--radius-lg);
  }

  .parallax-arch {
    border-radius: var(--radius-arch);
  }

  .parallax-inner,
  .parallax-inner > :is(picture, img),
  .parallax-inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .parallax {
        view-timeline: --parallax block;
      }

      .parallax-inner {
        animation: parallax-drift linear both;
        animation-timeline: --parallax;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes parallax-drift {
    from {
      transform: translateY(calc(var(--parallax-shift) * -1)) scale(1.18);
    }
    to {
      transform: translateY(var(--parallax-shift)) scale(1.18);
    }
  }
</style>

<script>
  import { needsGsapFallback, withGsap } from './gsap-fallback';

  document.addEventListener('astro:page-load', () => {
    const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    if (frames.length === 0 || !needsGsapFallback()) return;
    withGsap((gsap) => {
      frames.forEach((frame) => {
        const inner = frame.querySelector('.parallax-inner');
        if (!inner) return;
        gsap.fromTo(
          inner,
          { yPercent: -8, scale: 1.18 },
          {
            yPercent: 8,
            scale: 1.18,
            ease: 'none',
            scrollTrigger: { trigger: frame, start: 'top bottom', end: 'bottom top', scrub: true },
          },
        );
      });
    });
  });
</script>
