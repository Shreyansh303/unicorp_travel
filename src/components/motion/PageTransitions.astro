---
/**
 * Page transitions through Astro view transitions. The default is a short cross-fade with a
 * small rise on the incoming page (see the view-transition rules in global.css); the header and
 * the floating contact bar keep their place. Under reduced motion the page swaps at once.
 *
 * After a client-side navigation focus moves to the new page's H1 (or <main>), as a fresh load
 * would start reading there, and Astro's route announcer reads out the new title. Links to an
 * anchor keep the browser's own scroll and focus.
 *
 * Scripts in components must initialise on `astro:page-load`, which fires on the first load
 * and after every client-side navigation.
 */
import { ClientRouter } from 'astro:transitions';
---

<ClientRouter />

<script>
  document.addEventListener('astro:after-swap', () => {
    if (window.location.hash) return;
    const target =
      document.querySelector<HTMLElement>('main h1') ?? document.querySelector<HTMLElement>('main');
    if (!target) return;
    if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
    target.focus({ preventScroll: true });
  });
</script>
