---
/**
 * F-04 package filters for /holidays: destination type, region, length, budget band and theme,
 * one dropdown each (a disclosure button and a list of toggle options with aria-pressed; any
 * number can be picked, user request 2026-11-06). On phones a Filters button opens the same
 * groups in a bottom sheet (user-approved mockup A, 2026-11-06). The list itself is rendered on the server, so without
 * JavaScript every package stays listed and this panel is hidden. With JavaScript the filters
 * narrow the list in the browser, sync to the query string (shareable; reload, back and forward
 * restore them) and announce the result count in a polite live region.
 *
 * Options come from src/lib/packages.ts, limited to values at least one package has, so no
 * chip leads to an empty list on its own.
 */
import FilterChips from '../ui/FilterChips.astro';
import {
  budgetBandFor,
  budgetBands,
  durationBandFor,
  durationBands,
  packageTypeLabels,
  packageTypes,
  regionIds,
  regionLabels,
  themeIds,
  themeLabels,
} from '../../lib/packages';
import type { PackageEntry } from '../../lib/content';

interface Props {
  packages: PackageEntry[];
}

const { packages } = Astro.props;
const total = packages.length;
const used = {
  type: new Set(packages.map((pkg) => pkg.data.type)),
  region: new Set(packages.map((pkg) => pkg.data.region)),
  duration: new Set(packages.map((pkg) => durationBandFor(pkg.data.duration.days).id)),
  budget: new Set(packages.map((pkg) => budgetBandFor(pkg.data.fromPrice).id)),
  theme: new Set(packages.flatMap((pkg) => pkg.data.themes)),
};

const groups = [
  {
    name: 'type',
    short: 'Destination',
    label: 'Destination',
    chips: packageTypes
      .filter((id) => used.type.has(id))
      .map((id) => ({ value: id, label: packageTypeLabels[id] })),
  },
  {
    name: 'region',
    short: 'Region',
    label: 'Region',
    chips: regionIds
      .filter((id) => used.region.has(id))
      .map((id) => ({ value: id, label: regionLabels[id] })),
  },
  {
    name: 'duration',
    short: 'Length',
    label: 'Length',
    chips: durationBands
      .filter((band) => used.duration.has(band.id))
      .map((band) => ({ value: band.id, label: band.label })),
  },
  {
    name: 'budget',
    short: 'Price',
    label: 'Price per person, from',
    chips: budgetBands
      .filter((band) => used.budget.has(band.id))
      .map((band) => ({ value: band.id, label: band.label })),
  },
  {
    name: 'theme',
    short: 'Theme',
    label: 'Theme',
    chips: themeIds
      .filter((id) => used.theme.has(id))
      .map((id) => ({ value: id, label: themeLabels[id] })),
  },
];
---

<div class="hf" data-holiday-filters data-needs-js data-total={total}>
  <h3 class="sr-only">Filter the holidays</h3>
  <p class="sr-only" id="hf-help">
    Pick as many as you like. Holidays must match one choice in every group you use.
  </p>
  <div class="hf-backdrop" data-sheet-backdrop hidden></div>
  <div class="hf-sheet" id="hf-sheet" data-sheet aria-labelledby="hf-sheet-title">
    <div class="hf-sheet-head">
      <p class="hf-sheet-title" id="hf-sheet-title">
        Filter holidays
      </p>
      <button type="button" class="hf-sheet-clear" data-filters-clear hidden>
        Clear all
      </button>
      <button type="button" class="hf-sheet-x" aria-label="Close filters" data-sheet-close>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="hf-row">
      {groups.map((group) => (
        <div class="hf-drop" data-drop={group.name}>
          <button
            type="button"
            class="hf-drop-btn"
            aria-expanded="false"
            aria-controls={`hf-drop-${group.name}`}
            aria-describedby="hf-help"
            data-drop-btn
          >
            <span>{group.short}</span>
            <span class="hf-drop-count" data-drop-count></span>
            <span class="hf-drop-value" data-drop-value>
              Any
            </span>
            <svg
              class="hf-drop-icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div class="hf-drop-panel" id={`hf-drop-${group.name}`} hidden data-drop-panel>
            <FilterChips
              label={group.label}
              name={group.name}
              chips={group.chips}
              showLabel={false}
            />
          </div>
        </div>
      ))}
    </div>
    <button type="button" class="hf-sheet-go" data-sheet-close data-sheet-go>
      Show {total} holidays
    </button>
  </div>
  <div class="hf-bar">
    <button
      type="button"
      class="hf-open"
      aria-expanded="false"
      aria-controls="hf-sheet"
      data-sheet-open
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path>
        <circle cx="16" cy="7" r="2"></circle>
        <circle cx="10" cy="17" r="2"></circle>
      </svg>
      <span>Filters</span>
      <span class="hf-open-count" data-active-count></span>
    </button>
    <p class="hf-count" role="status" data-filter-count>
      Showing {total} of {total} holidays
    </p>
    <button type="button" class="hf-clear" data-filters-clear hidden>
      Clear filters
    </button>
  </div>
</div>

<style>
  .hf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-10);
  }

  /* One dropdown button per group. */
  .hf-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hf-drop {
    position: relative;
  }

  .hf-drop-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--border-strong);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    white-space: nowrap;
    cursor: pointer;
  }

  .hf-drop-btn:hover {
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .hf-drop-btn:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  /* A group with choices made is filled, and its button says how many. */
  .hf-drop-btn.is-active {
    background: var(--ink);
    color: var(--white);
    box-shadow: none;
  }

  .hf-drop-count:empty {
    display: none;
  }

  .hf-drop-btn[aria-expanded='true'] .hf-drop-icon {
    rotate: 180deg;
  }

  .hf-drop-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 20;
    min-width: 15rem;
    max-height: min(30rem, 70vh);
    overflow-y: auto;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow:
      inset 0 0 0 1px var(--sand-200),
      var(--shadow-lg);
  }

  .hf-drop-panel[hidden] {
    display: none;
  }

  /* Inside a dropdown the options are a plain list: one row each, a tick on the chosen ones. */
  .hf-drop-panel :global(.chips-list) {
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 0;
  }

  .hf-drop-panel :global(.chip) {
    justify-content: flex-start;
    width: 100%;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    background: transparent;
    box-shadow: none;
    white-space: nowrap;
  }

  .hf-drop-panel :global(.chip:hover) {
    background: var(--sand-100);
    box-shadow: none;
  }

  .hf-drop-panel :global(.chip .chip-tick) {
    display: block;
    visibility: hidden;
  }

  .hf-drop-panel :global(.chip[aria-pressed='true']) {
    background: transparent;
    color: var(--ink);
  }

  .hf-drop-panel :global(.chip[aria-pressed='true'] .chip-tick) {
    visibility: visible;
    color: var(--accent-text);
  }

  .hf-drop-panel :global(.chip:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  /* Desktop: the sheet is only a wrapper around the dropdown row; its phone parts stay hidden. */
  .hf-sheet {
    display: contents;
  }

  .hf-sheet-head,
  .hf-sheet-go,
  .hf-open,
  .hf-backdrop,
  .hf-drop-value {
    display: none;
  }

  .hf-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .hf-count {
    font-weight: var(--weight-bold);
  }

  .hf-clear {
    min-height: var(--tap);
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink);
    font: inherit;
    font-weight: var(--weight-bold);
    cursor: pointer;
  }

  .hf-clear:hover {
    background: var(--ink);
    color: var(--white);
  }

  .hf-clear:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  /* Phones: one Filters button beside the count. It opens a sheet from the bottom with every
     group as a row; a row opens its options in place (one at a time). */
  @media (max-width: 767.98px) {
    .hf {
      gap: var(--space-3);
      margin-bottom: var(--space-6);
    }

    .hf-bar {
      width: 100%;
      flex-wrap: nowrap;
      gap: var(--space-3);
    }

    .hf-bar .hf-clear {
      display: none;
    }

    .hf-count {
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      color: var(--text-muted);
    }

    .hf-open {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: var(--space-2);
      min-height: var(--tap);
      padding: var(--space-2) var(--space-5) var(--space-2) var(--space-4);
      border: 0;
      border-radius: var(--radius-pill);
      background: var(--ink);
      color: var(--white);
      font: inherit;
      font-weight: var(--weight-bold);
      cursor: pointer;
    }

    .hf-open:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }

    .hf-open-count:empty {
      display: none;
    }

    .hf-backdrop:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: var(--z-overlay);
      display: block;
      background: rgb(20 17 16 / 0.5);
    }

    .hf-sheet {
      position: fixed;
      inset: auto 0 0;
      z-index: calc(var(--z-overlay) + 1);
      display: flex;
      flex-direction: column;
      max-height: 88svh;
      padding: var(--space-3) var(--gutter) calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      background: var(--white);
      transform: translateY(100%);
      visibility: hidden;
      transition:
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);
    }

    .hf-sheet.is-open {
      transform: none;
      visibility: visible;
      transition:
        transform var(--duration-base) var(--ease-out),
        visibility 0s linear 0s;
    }

    .hf-sheet-head {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--sand-200);
    }

    .hf-sheet-title {
      margin-right: auto;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: var(--weight-black);
    }

    .hf-sheet-clear {
      min-height: var(--tap);
      padding: 0 var(--space-2);
      border: 0;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: var(--text-sm);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .hf-sheet-x {
      display: grid;
      place-items: center;
      width: var(--tap);
      height: var(--tap);
      border: 0;
      border-radius: 50%;
      background: var(--sand-100);
      color: var(--ink);
      cursor: pointer;
    }

    .hf-sheet-clear:focus-visible,
    .hf-sheet-x:focus-visible,
    .hf-sheet-go:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }

    /* The groups: full-width rows that scroll inside the sheet. */
    .hf-row {
      display: block;
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .hf-drop {
      border-bottom: 1px solid var(--sand-200);
    }

    .hf-drop-btn,
    .hf-drop-btn.is-active {
      width: 100%;
      min-height: 3.5rem;
      padding: 0 var(--space-1);
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      box-shadow: none;
      font-size: 1rem;
    }

    .hf-drop-btn:hover {
      box-shadow: none;
    }

    .hf-drop-btn:focus-visible {
      outline-offset: -3px;
    }

    .hf-drop-btn .hf-drop-count {
      display: none;
    }

    .hf-drop-value {
      display: block;
      margin-left: auto;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: var(--weight-regular);
      color: var(--text-muted);
    }

    .hf-drop-btn.is-active .hf-drop-value {
      font-weight: var(--weight-bold);
      color: var(--accent-text);
    }

    /* Options open in place as chips. */
    .hf-drop-panel {
      position: static;
      min-width: 0;
      max-height: none;
      overflow: visible;
      padding: 0 0 var(--space-4);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .hf-drop-panel :global(.chips-list) {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .hf-drop-panel :global(.chip) {
      width: auto;
      padding-inline: var(--space-4);
      border-radius: var(--radius-pill);
      box-shadow: inset 0 0 0 1.5px var(--border-strong);
    }

    .hf-drop-panel :global(.chip:hover) {
      background: transparent;
      box-shadow: inset 0 0 0 2px var(--ink);
    }

    .hf-drop-panel :global(.chip[aria-pressed='true']) {
      background: var(--ink);
      color: var(--white);
      box-shadow: none;
    }

    .hf-drop-panel :global(.chip[aria-pressed='true'] .chip-tick) {
      color: var(--white);
    }

    .hf-drop-panel :global(.chip:not([aria-pressed='true']) .chip-tick) {
      display: none;
    }

    .hf-drop-panel :global(.chip:focus-visible) {
      outline-offset: 3px;
    }

    .hf-sheet-go {
      display: block;
      flex: none;
      width: 100%;
      min-height: 3.25rem;
      margin-top: var(--space-4);
      border: 0;
      border-radius: var(--radius-pill);
      background: var(--red-600);
      color: var(--white);
      font: inherit;
      font-weight: var(--weight-black);
      cursor: pointer;
    }
  }

  @media (max-width: 767.98px) and (prefers-reduced-motion: reduce) {
    .hf-sheet,
    .hf-sheet.is-open {
      transition: none;
    }
  }
</style>

<script>
  import './holiday-filters';
</script>
